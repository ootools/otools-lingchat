+//! Browser-forwarded RPC has no authenticated plugin WebView identity.
+
+pub(crate) fn validate_forwarded_command(command: &str) -> Result<(), &'static str> {
+    if command.is_empty() || command.len() > 256 || !command.bytes().all(|byte| {
+        byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-' | b':' | b'|' | b'.')
+    }) {
+        return Err("Invalid RPC command name");
+    }
+    if [
+        "otools_host_plugin_data_", "otools_host_ai_",
+        "otools_host_observation_", "otools_host_plugin_reminders_",
+    ].iter().any(|prefix| command.starts_with(prefix)) {
+        return Err("This capability requires an authenticated local plugin or consent window");
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::validate_forwarded_command;
+
+    #[test]
+    fn rejects_commands_that_require_a_local_plugin_or_consent_identity() {
+        for command in [
+            "otools_host_plugin_data_list", "otools_host_plugin_data_consent_decide",
+            "otools_host_ai_start", "otools_host_ai_read",
+            "otools_host_observation_approve", "otools_host_observation_capture",
+            "otools_host_plugin_reminders_configure",
+        ] {
+            assert!(validate_forwarded_command(command).is_err(), "{command}");
+        }
+    }
+
+    #[test]
+    fn preserves_ordinary_remote_and_plugin_commands() {
+        for command in ["otools_ai_generate_text", "get_otools_plugin_localstate", "plugin:dialog|open"] {
+            assert!(validate_forwarded_command(command).is_ok());
+        }
+    }
+
+    #[test]
+    fn rejects_script_fragments_before_webview_evaluation() {
+        for command in ["", "cmd\"; alert(1); //", "cmd\\x", "cmd\n", " cmd"] {
+            assert!(validate_forwarded_command(command).is_err());
+        }
+    }
+}
