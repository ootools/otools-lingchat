+export interface PluginDataIdentity { source: string; uuid: string }
+export interface PluginDataDeclaration { provides?: string[]; consumes?: string[] }
+export interface PluginDataResource<T = unknown, P = unknown> {
+  provider: PluginDataIdentity;
+  type: string;
+  id: string;
+  revision: number;
+  updatedAt: number;
+  deleted: boolean;
+  data: T;
+  /** Present only for provider reads. Change notifications always omit private data. */
+  privateData?: P;
+}
+export interface PluginDataProvider { provider: PluginDataIdentity; types: string[] }
+export type PluginDataScope = { kind: 'all' } | { kind: 'ids'; ids: string[] };
+/** Omitting provider selects the authenticated caller's own resources. */
+export interface PluginDataReadRequest { provider?: PluginDataIdentity; type: string }
+export interface PluginDataListRequest extends PluginDataReadRequest { cursor?: string; limit?: number }
+export interface PluginDataGetRequest extends PluginDataReadRequest { id: string }
+export interface PluginDataPutRequest<T = unknown, P = unknown> {
+  type: string; id: string; data: T; privateData?: P;
+  /** Required: 0 creates, otherwise compare-and-swap against the current revision. */
+  expectedRevision: number;
+  /** Explicit recreation additionally requires the exact current tombstone revision. */
+  recreate?: boolean;
+}
+export interface PluginDataRemoveRequest { type: string; id: string; expectedRevision: number }
+export interface PluginDataChangesRequest extends PluginDataReadRequest { after: string; limit?: number }
+export interface PluginDataListPage<T = unknown, P = unknown> {
+  /** Includes tombstones; filter deleted records when rendering live content. */
+  items: PluginDataResource<T, P>[];
+  next: string | null;
+  /** Poll after this snapshot; list continuation fails with resyncRequired if it changes. */
+  after: string;
+}
+export interface PluginDataChangesPage<T = unknown> {
+  /** Shared projections only. Owners must get() to refresh private fields. */
+  items: PluginDataResource<T, never>[];
+  after: string;
+  hasMore: boolean;
+}
+export interface PluginDataAccessRequest { provider: PluginDataIdentity; type: string; scope?: PluginDataScope; subscribe?: boolean }
+export interface PluginDataAccessStatus { id: string; status: 'pending' }
+export interface PluginDataRevokeRequest { provider: PluginDataIdentity; type: string }
+export type PluginDataErrorCode = 'permissionDenied' | 'forbidden' | 'conflict' | 'deleted' | 'resyncRequired' | 'invalidCursor' | 'invalidRequest' | 'storageFailed' | 'unavailable' | 'unsupported' | 'busy';
+export interface PluginDataFailure { code: PluginDataErrorCode; message: string }
+export interface PluginDataTransport { invoke(command: string, args?: Record<string, unknown>): Promise<unknown> }
+export interface PluginDataSubscribeOptions {
+  intervalMs?: number;
+  signal?: AbortSignal;
+  /** Errors stop polling. In particular, resyncRequired requires a fresh list snapshot. */
+  onError(error: Error & PluginDataFailure): void;
+}
+export interface PluginDataApi {
+  discover(): Promise<PluginDataProvider[]>;
+  list<T = unknown, P = unknown>(request: PluginDataListRequest): Promise<PluginDataListPage<T, P>>;
+  get<T = unknown, P = unknown>(request: PluginDataGetRequest): Promise<PluginDataResource<T, P> | null>;
+  put<T = unknown, P = unknown>(request: PluginDataPutRequest<T, P>): Promise<PluginDataResource<T, P>>;
+  remove(request: PluginDataRemoveRequest): Promise<PluginDataResource<null, never>>;
+  changes<T = unknown>(request: PluginDataChangesRequest): Promise<PluginDataChangesPage<T>>;
+  /** Always opens host consent; a pending request is never an access grant. */
+  requestAccess(request: PluginDataAccessRequest): Promise<PluginDataAccessStatus>;
+  /** Withdraw only the authenticated consumer's grant. Does not grant access. */
+  revokeAccess(request: PluginDataRevokeRequest): Promise<void>;
+  /** Owner-bound polling; no global events. Returns idempotent cleanup. */
+  subscribe<T = unknown>(request: PluginDataChangesRequest, onChanges: (page: PluginDataChangesPage<T>) => void | Promise<void>, options: PluginDataSubscribeOptions): () => void;
+}
diff --git a/src/reminder-factory.ts b/src/reminder-factory.ts
new file mode 100644
index 0000000..71e19f0
--- /dev/null
+++ b/src/reminder-factory.ts
@@ -0,0 +1,75 @@
+import type { ReminderApi, ReminderConfigureRequest, ReminderItem, ReminderProvider, ReminderStatus, ReminderTransport } from './reminder-types';
+export * from './reminder-types';
+
+export class ReminderError extends Error {
+  constructor(public readonly code: string, message: string) { super(message); this.name = 'ReminderError'; }
+}
+function normalize(error: unknown): ReminderError {
+  if (error instanceof ReminderError) return error;
+  let value = error;
+  if (typeof value === 'string') { try { value = JSON.parse(value); } catch { /* Plain IPC error. */ } }
+  const record = value && typeof value === 'object' ? value as {code?: string; message?: string} : undefined;
+  return new ReminderError(typeof record?.code === 'string' ? record.code : 'unsupported', typeof record?.message === 'string' ? record.message : String(error));
+}
+function invalid(): never { throw new ReminderError('invalidRequest', 'Provide a provider, data type, enabled flag and valid reminder settings'); }
+function invalidResponse(): never { throw new ReminderError('invalidResponse', 'Invalid reminder response'); }
+function bounded(value: unknown, maximum: number): value is string { return typeof value === 'string' && [...value].length <= maximum; }
+function timestamp(value: unknown): value is number { return Number.isSafeInteger(value) && (value as number) >= 0; }
+function provider(value: unknown): value is ReminderProvider {
+  const item = value as ReminderProvider | undefined;
+  return !!item && bounded(item.source,64) && !!item.source && bounded(item.uuid,128) && !!item.uuid;
+}
+function validSettings(value: ReminderConfigureRequest): boolean {
+  return !!value && provider(value.provider) && bounded(value.type,128) && !!value.type && typeof value.enabled === 'boolean'
+    && (value.cooldownMs === undefined || Number.isSafeInteger(value.cooldownMs) && value.cooldownMs >= 30_000 && value.cooldownMs <= 86_400_000)
+    && (value.quietHours === undefined || !!value.quietHours && Number.isInteger(value.quietHours.start) && Number.isInteger(value.quietHours.end)
+      && value.quietHours.start >= 0 && value.quietHours.start < 1440 && value.quietHours.end >= 0 && value.quietHours.end < 1440);
+}
+function checkStatus(value: unknown): ReminderStatus {
+  const item = value as ReminderStatus;
+  if (!validSettings(item) || typeof item.cooldownMs !== 'number' || typeof item.available !== 'boolean'
+    || item.lastCheckedAt !== undefined && !timestamp(item.lastCheckedAt)
+    || item.lastDeliveredAt !== undefined && !timestamp(item.lastDeliveredAt)) invalidResponse();
+  return item;
+}
+function checkItem(value: unknown): ReminderItem {
+  const item = value as ReminderItem;
+  if (!item || !/^[a-f0-9]{64}$/.test(item.id) || !provider(item.provider) || !bounded(item.type,128) || !item.type
+    || !bounded(item.resourceId,1024) || !item.resourceId || !timestamp(item.dueAt) || !timestamp(item.deliveredAt)
+    || !bounded(item.title,120) || !bounded(item.body,500)) invalidResponse();
+  return item;
+}
+
+/** Dependency-free host IPC factory. Scheduling belongs to the running host;
+ * this API never creates a webview timer, grants access, or interprets note text. */
+export function createReminderApi(transport: ReminderTransport): ReminderApi {
+  const call = async (method: string, args?: Record<string, unknown>): Promise<unknown> => {
+    try { return await transport.invoke(`otools_host_plugin_reminders_${method}`,args); }
+    catch (error) { throw normalize(error); }
+  };
+  return {
+    async configure(options) {
+      if (!validSettings(options)) invalid();
+      // Explicit projection prevents caller-supplied owner identities from being
+      // forwarded. The host captures its source-aware native plugin identity.
+      const request: ReminderConfigureRequest = {provider:{source:options.provider.source,uuid:options.provider.uuid},type:options.type,enabled:options.enabled};
+      if (options.quietHours !== undefined) request.quietHours = {start:options.quietHours.start,end:options.quietHours.end};
+      if (options.cooldownMs !== undefined) request.cooldownMs = options.cooldownMs;
+      return checkStatus(await call('configure',{request}));
+    },
+    async status() {
+      const result = await call('status');
+      if (!Array.isArray(result) || result.length > 16) invalidResponse();
+      return result.map(checkStatus);
+    },
+    async pending() {
+      const result = await call('pending');
+      if (!Array.isArray(result) || result.length > 20) invalidResponse();
+      return result.map(checkItem);
+    },
+    async acknowledge(ids) {
+      if (!Array.isArray(ids) || ids.length > 20 || ids.some(id => typeof id !== 'string' || !/^[a-f0-9]{64}$/.test(id))) invalid();
+      await call('acknowledge',{ids:[...ids]});
+    },
+  };
+}
diff --git a/src/reminder-types.ts b/src/reminder-types.ts
new file mode 100644
index 0000000..f8799a2
--- /dev/null
+++ b/src/reminder-types.ts
@@ -0,0 +1,40 @@
+export interface ReminderProvider { source: string; uuid: string }
+/** Local wall-clock minutes after midnight. Equal endpoints disable quiet time. */
+export interface ReminderQuietHours { start: number; end: number }
+export interface ReminderConfigureRequest {
+  provider: ReminderProvider;
+  type: 'notes.v1' | (string & {});
+  enabled: boolean;
+  quietHours?: ReminderQuietHours;
+  /** 30 seconds to 24 hours; host default is 5 minutes. */
+  cooldownMs?: number;
+}
+export interface ReminderStatus extends Omit<ReminderConfigureRequest, 'cooldownMs'> {
+  cooldownMs: number;
+  available: boolean;
+  lastCheckedAt?: number;
+  lastDeliveredAt?: number;
+}
+/** Private content returned only to the enrolled native-authenticated owner. */
+export interface ReminderItem {
+  id: string;
+  provider: ReminderProvider;
+  type: string;
+  resourceId: string;
+  dueAt: number;
+  title: string;
+  body: string;
+  deliveredAt: number;
+}
+export interface ReminderTransport {
+  invoke(command: string, args?: Record<string, unknown>): Promise<unknown>;
+}
+export interface ReminderApi {
+  /** Enroll a host-owned read watcher; this does not request or grant data access. */
+  configure(request: ReminderConfigureRequest): Promise<ReminderStatus>;
+  status(): Promise<ReminderStatus[]>;
+  /** Fresh, reauthorized reminders. Render as data, never as executable commands. */
+  pending(): Promise<ReminderItem[]>;
+  /** Acknowledge after showing the pet bubble to suppress the 30-second OS fallback. */
+  acknowledge(ids: string[]): Promise<void>;
+}
