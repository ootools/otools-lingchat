diff --git a/src-tauri/src/platform/plugin_reminders/persistence.rs b/src-tauri/src/platform/plugin_reminders/persistence.rs
new file mode 100644
index 00000000..0a5b2d40
--- /dev/null
+++ b/src-tauri/src/platform/plugin_reminders/persistence.rs
@@ -0,0 +1,80 @@
+use super::{policy, types::Stored};
+use std::{
+    fs,
+    io::{self, Read, Write},
+    path::Path,
+};
+
+const MAX_FILE_BYTES: u64 = 64 * 1024 * 1024;
+fn invalid() -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, "Invalid reminder state")
+}
+
+pub fn load(path: &Path) -> io::Result<Stored> {
+    let file = match fs::File::open(path) {
+        Ok(file) => file,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(Stored::default()),
+        Err(error) => return Err(error),
+    };
+    if file.metadata()?.len() > MAX_FILE_BYTES {
+        return Err(invalid());
+    }
+    let mut bytes = Vec::new();
+    file.take(MAX_FILE_BYTES + 1).read_to_end(&mut bytes)?;
+    if bytes.len() as u64 > MAX_FILE_BYTES {
+        return Err(invalid());
+    }
+    let stored: Stored = serde_json::from_slice(&bytes).map_err(|_| invalid())?;
+    if stored.version != 1 || stored.watches.len() > 128 {
+        return Err(invalid());
+    }
+    for watch in &stored.watches {
+        policy::validate(&watch.config).map_err(|_| invalid())?;
+        if watch.owner.source.is_empty()
+            || watch.owner.uuid.is_empty()
+            || watch.receipts.len() > 2048
+            || watch.receipts.iter().any(|receipt| {
+                receipt.id.len() != 64 || !receipt.id.bytes().all(|b| b.is_ascii_hexdigit())
+            })
+        {
+            return Err(invalid());
+        }
+    }
+    Ok(stored)
+}
+
+/// Only configuration and opaque delivery receipts reach disk. A same-directory
+/// temporary file is flushed before atomic replacement; incomplete writes cannot
+/// destroy the last committed state.
+pub fn save(path: &Path, stored: &Stored) -> io::Result<()> {
+    let parent = path.parent().ok_or_else(invalid)?;
+    fs::create_dir_all(parent)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        fs::set_permissions(parent, fs::Permissions::from_mode(0o700))?;
+    }
+    let mut temporary = tempfile::Builder::new()
+        .prefix(".reminders-")
+        .tempfile_in(parent)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        temporary
+            .as_file()
+            .set_permissions(fs::Permissions::from_mode(0o600))?;
+    }
+    serde_json::to_writer(&mut temporary, stored).map_err(|_| invalid())?;
+    temporary.flush()?;
+    temporary.as_file().sync_all()?;
+    temporary.persist(path).map_err(|error| error.error)?;
+    #[cfg(unix)]
+    {
+        // Some filesystems do not support directory fsync. The file replacement
+        // is already committed, so never report an uncommitted state after rename.
+        if let Ok(directory) = fs::File::open(parent) {
+            let _ = directory.sync_all();
+        }
+    }
+    Ok(())
+}
diff --git a/src-tauri/src/platform/plugin_reminders/policy.rs b/src-tauri/src/platform/plugin_reminders/policy.rs
new file mode 100644
index 00000000..1af0b136
--- /dev/null
+++ b/src-tauri/src/platform/plugin_reminders/policy.rs
@@ -0,0 +1,322 @@
+use super::types::*;
+use chrono::{DateTime, Local, NaiveDateTime, TimeZone};
+use ot_plugin_data::{Error, Identity, Resource};
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+use std::collections::HashSet;
+
+pub const DEFAULT_COOLDOWN_MS: u64 = 300_000;
+pub const MAX_BATCH: usize = 20;
+const MAX_RECEIPTS: usize = 2048;
+const FIRST_ENABLE_GRACE_MS: u64 = 300_000;
+const BUBBLE_GRACE_MS: u64 = 30_000;
+
+pub fn validate(config: &ConfigureRequest) -> Result<(), Error> {
+    if config.provider.source.is_empty()
+        || config.provider.source.len() > 64
+        || config.provider.uuid.is_empty()
+        || config.provider.uuid.len() > 128
+        || config.resource_type.is_empty()
+        || config.resource_type.len() > 128
+        || config
+            .quiet_hours
+            .as_ref()
+            .is_some_and(|q| q.start >= 1440 || q.end >= 1440)
+        || config
+            .cooldown_ms
+            .is_some_and(|ms| !(30_000..=86_400_000).contains(&ms))
+    {
+        return Err(Error::new(
+            "invalidRequest",
+            "Invalid reminder watch settings",
+        ));
+    }
+    Ok(())
+}
+pub fn initial_cutoff(now: u64) -> u64 {
+    now.saturating_sub(FIRST_ENABLE_GRACE_MS)
+}
+
+pub fn parse_due_value(value: &Value) -> Option<u64> {
+    let due = if let Some(number) = value.as_u64() {
+        number
+    } else {
+        let text = value.as_str()?;
+        if text.len() > 40 {
+            return None;
+        }
+        let parsed = DateTime::parse_from_rfc3339(text).ok()?;
+        u64::try_from(parsed.timestamp_millis()).ok()?
+    };
+    // Bound to valid chrono milliseconds; never infer seconds as milliseconds.
+    (due >= 946_684_800_000 && due <= 253_402_300_799_999).then_some(due)
+}
+
+/// Accept one explicit absolute timestamp. Multiple dates, invalid dates and
+/// daylight-saving folds/gaps fail closed. No natural language or commands run.
+pub fn explicit_time(text: &str) -> Option<u64> {
+    let bytes = text.as_bytes();
+    let mut matches = Vec::new();
+    for i in 0..bytes.len().saturating_sub(15).min(16_384) {
+        let date = &bytes[i..i + 10];
+        if date[4] != b'-'
+            || date[7] != b'-'
+            || !date
+                .iter()
+                .enumerate()
+                .all(|(n, c)| n == 4 || n == 7 || c.is_ascii_digit())
+            || i > 0 && bytes[i - 1].is_ascii_alphanumeric()
+        {
+            continue;
+        }
+        let parsed = if bytes.get(i + 10) == Some(&b'T') || bytes.get(i + 10) == Some(&b't') {
+            let end = (i..bytes.len())
+                .take_while(|&j| bytes[j].is_ascii_alphanumeric() || b"-+:.".contains(&bytes[j]))
+                .last()?
+                + 1;
+            text.get(i..end)
+                .and_then(|s| parse_due_value(&Value::String(s.into())))
+        } else if bytes.get(i + 10) == Some(&b' ') {
+            let len = if bytes.get(i + 16) == Some(&b':') {
+                19
+            } else {
+                16
+            };
+            let format = if len == 19 {
+                "%Y-%m-%d %H:%M:%S"
+            } else {
+                "%Y-%m-%d %H:%M"
+            };
+            text.get(i..i + len)
+                .and_then(|s| NaiveDateTime::parse_from_str(s, format).ok())
+                .filter(|_| {
+                    bytes
+                        .get(i + len)
+                        .is_none_or(|b| !b.is_ascii_alphanumeric() && !b"+:-.".contains(b))
+                })
+                .and_then(|date| Local.from_local_datetime(&date).single())
+                .and_then(|date| u64::try_from(date.timestamp_millis()).ok())
+        } else {
+            None
+        };
+        matches.push(parsed);
+    }
+    if matches.len() == 1 {
+        matches[0]
+    } else {
+        None
+    }
+}
+fn bounded(text: &str, max: usize) -> String {
+    text.chars()
+        .filter(|c| !c.is_control() || *c == '\n')
+        .take(max)
+        .collect()
+}
+fn string<'a>(data: &'a Value, key: &str) -> &'a str {
+    data.get(key).and_then(Value::as_str).unwrap_or("")
+}
+fn candidate(
+    owner: &Identity,
+    row: &Resource,
+    part: &str,
+    due_at: u64,
+    title: &str,
+    text: &str,
+) -> Candidate {
+    let key = serde_json::to_vec(&(
+        owner,
+        &row.provider,
+        &row.resource_type,
+        &row.id,
+        part,
+        due_at,
+    ))
+    .unwrap_or_default();
+    Candidate {
+        id: hex::encode(Sha256::digest(key)),
+        provider: row.provider.clone(),
+        resource_type: row.resource_type.clone(),
+        resource_id: row.id.clone(),
+        due_at,
+        title: bounded(if title.is_empty() { "Reminder" } else { title }, 120),
+        body: bounded(
+            &format!(
+                "[{} / {}] {}",
+                bounded(&row.provider.uuid, 80),
+                bounded(&row.resource_type, 80),
+                text
+            ),
+            500,
+        ),
+    }
+}
+pub fn candidates(owner: &Identity, row: &Resource) -> Vec<Candidate> {
+    if row.deleted || row.data.get("completed").and_then(Value::as_bool) == Some(true) {
+        return vec![];
+    }
+    let title = string(&row.data, "title");
+    let body = string(&row.data, "body");
+    let mut result = Vec::new();
+    if let Some(value) = row.data.get("dueAt") {
+        if let Some(due) = parse_due_value(value) {
+            result.push(candidate(
+                owner,
+                row,
+                "resource",
+                due,
+                title,
+                if body.is_empty() { title } else { body },
+            ));
+        }
+    } else if row.resource_type == "notes.v1" {
+        if let Some(due) = explicit_time(&format!(
+            "{}\n{}",
+            bounded(title, 1000),
+            bounded(body, 16_384)
+        )) {
+            result.push(candidate(
+                owner,
+                row,
+                "resource",
+                due,
+                title,
+                if body.is_empty() { title } else { body },
+            ));
+        }
+    }
+    if row.resource_type == "notes.v1" {
+        if let Some(todos) = row.data.get("todos").and_then(Value::as_array) {
+            let mut seen = HashSet::new();
+            for todo in todos.iter().take(256) {
+                let id = string(todo, "id");
+                if id.is_empty()
+                    || id.len() > 256
+                    || !seen.insert(id)
+                    || todo.get("done").and_then(Value::as_bool) != Some(false)
+                {
+                    continue;
+                }
+                let text = string(todo, "text");
+                if let Some(due) = explicit_time(text) {
+                    result.push(candidate(
+                        owner,
+                        row,
+                        &format!("todo:{id}"),
+                        due,
+                        title,
+                        text,
+                    ));
+                }
+            }
+        }
+    }
+    result
+}
+pub fn in_quiet_hours(config: &ConfigureRequest, minute: u16) -> bool {
+    config.quiet_hours.as_ref().is_some_and(|q| {
+        if q.start == q.end {
+            false
+        } else if q.start < q.end {
+            minute >= q.start && minute < q.end
+        } else {
+            minute >= q.start || minute < q.end
+        }
+    })
+}
+pub fn select_due(
+    watch: &Watch,
+    candidates: &[Candidate],
+    now: u64,
+    minute: u16,
+) -> Vec<Candidate> {
+    if !watch.config.enabled
+        || in_quiet_hours(&watch.config, minute)
+        || watch.last_delivered_at.is_some_and(|last| {
+            now.saturating_sub(last) < watch.config.cooldown_ms.unwrap_or(DEFAULT_COOLDOWN_MS)
+        })
+    {
+        return vec![];
+    }
+    let receipts: HashSet<_> = watch.receipts.iter().map(|r| &r.id).collect();
+    let mut due: Vec<_> = candidates
+        .iter()
+        .filter(|c| {
+            c.due_at >= watch.eligible_since && c.due_at <= now && !receipts.contains(&c.id)
+        })
+        .cloned()
+        .collect();
+    due.sort_by(|a, b| (a.due_at, &a.id).cmp(&(b.due_at, &b.id)));
+    due.dedup_by(|a, b| a.id == b.id);
+    due.truncate(MAX_BATCH);
+    due
+}
+pub fn record_delivery(watch: &mut Watch, due: &[Candidate], now: u64) {
+    if due.is_empty() {
+        return;
+    }
+    for c in due {
+        watch.receipts.push(Receipt {
+            id: c.id.clone(),
+            due_at: c.due_at,
+            delivered_at: now,
+            acknowledged: false,
+            notified: false,
+        });
+    }
+    watch.last_delivered_at = Some(now);
+    if watch.receipts.len() > MAX_RECEIPTS {
+        watch.receipts.sort_by_key(|r| r.due_at);
+        let excess = watch.receipts.len() - MAX_RECEIPTS;
+        // Never redeliver keys evicted from bounded storage after restart.
+        watch.eligible_since = watch
+            .eligible_since
+            .max(watch.receipts[excess - 1].due_at.saturating_add(1));
+        watch.receipts.drain(..excess);
+    }
+}
+pub fn pending_items(watch: &Watch, current: Result<&[Candidate], ()>) -> Vec<ReminderItem> {
+    if !watch.config.enabled {
+        return vec![];
+    }
+    let Ok(current) = current else {
+        return vec![];
+    };
+    current
+        .iter()
+        .filter_map(|c| {
+            let receipt = watch
+                .receipts
+                .iter()
+                .find(|r| r.id == c.id && !r.acknowledged)?;
+            Some(ReminderItem {
+                id: c.id.clone(),
+                provider: c.provider.clone(),
+                resource_type: c.resource_type.clone(),
+                resource_id: c.resource_id.clone(),
+                due_at: c.due_at,
+                title: c.title.clone(),
+                body: c.body.clone(),
+                delivered_at: receipt.delivered_at,
+            })
+        })
+        .take(MAX_BATCH)
+        .collect()
+}
+pub fn fallback_ids(watch: &Watch, current: &[Candidate], now: u64, minute: u16) -> Vec<String> {
+    if !watch.config.enabled || in_quiet_hours(&watch.config, minute) {
+        return vec![];
+    }
+    watch
+        .receipts
+        .iter()
+        .filter(|r| {
+            !r.acknowledged
+                && !r.notified
+                && now.saturating_sub(r.delivered_at) >= BUBBLE_GRACE_MS
+                && current.iter().any(|c| c.id == r.id)
+        })
+        .map(|r| r.id.clone())
+        .take(MAX_BATCH)
+        .collect()
+}
diff --git a/src-tauri/src/platform/plugin_reminders/service.rs b/src-tauri/src/platform/plugin_reminders/service.rs
new file mode 100644
index 00000000..b14fdcdf
--- /dev/null
+++ b/src-tauri/src/platform/plugin_reminders/service.rs
@@ -0,0 +1,484 @@
+use super::{persistence, policy, types::*};
+use chrono::{Local, Timelike};
+use ot_plugin_data::{Error, Identity, Result};
+use std::{
+    collections::HashMap,
+    path::PathBuf,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc, Condvar, Mutex,
+    },
+    thread::JoinHandle,
+    time::{Duration, SystemTime, UNIX_EPOCH},
+};
+use tauri::{AppHandle, Manager};
+
+const POLL_SECONDS: u64 = 15;
+const MAX_WATCHES: usize = 128;
+const MAX_OWNER_WATCHES: usize = 16;
+const MAX_READ_ROWS: usize = 2048;
+static INITIALIZE: Mutex<()> = Mutex::new(());
+
+#[derive(Clone, Default)]
+struct Health {
+    available: bool,
+    last_checked_at: Option<u64>,
+}
+struct Inner {
+    stored: Stored,
+    health: HashMap<String, Health>,
+}
+pub struct ReminderState {
+    path: PathBuf,
+    inner: Mutex<Inner>,
+    stopping: AtomicBool,
+    wake_lock: Mutex<()>,
+    wake: Condvar,
+    worker: Mutex<Option<JoinHandle<()>>>,
+}
+fn unavailable() -> Error {
+    Error::new("unavailable", "Reminder service is unavailable")
+}
+fn storage_failed() -> Error {
+    Error::new("storageFailed", "Cannot save reminder configuration")
+}
+fn now() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_millis() as u64)
+        .unwrap_or(0)
+}
+fn key(owner: &Identity, config: &ConfigureRequest) -> String {
+    serde_json::to_string(&(owner, &config.provider, &config.resource_type)).unwrap_or_default()
+}
+fn matches(watch: &Watch, owner: &Identity, config: &ConfigureRequest) -> bool {
+    watch.owner == *owner
+        && watch.config.provider == config.provider
+        && watch.config.resource_type == config.resource_type
+}
+fn state(app: &AppHandle) -> Result<Arc<ReminderState>> {
+    let state = app
+        .try_state::<Arc<ReminderState>>()
+        .ok_or_else(unavailable)?
+        .inner()
+        .clone();
+    if state.stopping.load(Ordering::Acquire) {
+        return Err(unavailable());
+    }
+    Ok(state)
+}
+fn status_for(inner: &Inner, watch: &Watch) -> ReminderStatus {
+    let health = inner
+        .health
+        .get(&key(&watch.owner, &watch.config))
+        .cloned()
+        .unwrap_or_default();
+    let mut config = watch.config.clone();
+    config.cooldown_ms = Some(config.cooldown_ms.unwrap_or(policy::DEFAULT_COOLDOWN_MS));
+    ReminderStatus {
+        config,
+        available: watch.config.enabled && health.available,
+        last_checked_at: health.last_checked_at,
+        last_delivered_at: watch.last_delivered_at,
+    }
+}
+fn commit(state: &ReminderState, inner: &mut Inner, stored: Stored) -> Result<()> {
+    if state.stopping.load(Ordering::Acquire) {
+        return Err(unavailable());
+    }
+    persistence::save(&state.path, &stored).map_err(|_| storage_failed())?;
+    inner.stored = stored;
+    Ok(())
+}
+
+/// Start one native worker owned by the running host, not by a pet webview.
+/// Closing all consumer windows does not stop it. Host shutdown joins it.
+pub fn initialize(app: &AppHandle) -> std::result::Result<(), String> {
+    let _initialize = INITIALIZE
+        .lock()
+        .map_err(|_| "Reminder initialization failed")?;
+    if app.try_state::<Arc<ReminderState>>().is_some() {
+        return Ok(());
+    }
+    let path = app
+        .path()
+        .app_data_dir()
+        .map_err(|_| "Reminder directory is unavailable")?
+        .join("plugin-reminders")
+        .join("watchers.json");
+    let stored = persistence::load(&path).map_err(|_| "Cannot restore reminder configuration")?;
+    let state = Arc::new(ReminderState {
+        path,
+        inner: Mutex::new(Inner {
+            stored,
+            health: HashMap::new(),
+        }),
+        stopping: AtomicBool::new(false),
+        wake_lock: Mutex::new(()),
+        wake: Condvar::new(),
+        worker: Mutex::new(None),
+    });
+    let worker_state = state.clone();
+    let worker_app = app.clone();
+    let worker = std::thread::Builder::new()
+        .name("otools-plugin-reminders".into())
+        .spawn(move || {
+            while !worker_state.stopping.load(Ordering::Acquire) {
+                tick(&worker_app, &worker_state);
+                let Ok(lock) = worker_state.wake_lock.lock() else {
+                    break;
+                };
+                if worker_state.stopping.load(Ordering::Acquire) {
+                    break;
+                }
+                let _ = worker_state
+                    .wake
+                    .wait_timeout(lock, Duration::from_secs(POLL_SECONDS));
+            }
+        })
+        .map_err(|_| "Cannot start reminder worker")?;
+    *state
+        .worker
+        .lock()
+        .map_err(|_| "Reminder worker is unavailable")? = Some(worker);
+    app.manage(state);
+    Ok(())
+}
+pub fn shutdown(app: &AppHandle) {
+    let Some(state) = app.try_state::<Arc<ReminderState>>() else {
+        return;
+    };
+    state.stopping.store(true, Ordering::Release);
+    // Serialize with the wait predicate to avoid a lost wake during exit.
+    if let Ok(_lock) = state.wake_lock.lock() {
+        state.wake.notify_all();
+    }
+    if let Ok(mut worker) = state.worker.lock() {
+        if let Some(worker) = worker.take() {
+            let _ = worker.join();
+        }
+    };
+}
+
+pub(crate) fn configure(
+    app: &AppHandle,
+    owner: Identity,
+    mut config: ConfigureRequest,
+) -> Result<ReminderStatus> {
+    policy::validate(&config)?;
+    config.cooldown_ms = Some(config.cooldown_ms.unwrap_or(policy::DEFAULT_COOLDOWN_MS));
+    let state = state(app)?;
+    let checked_at = now();
+    // Enrollment cannot mint read permission. Disabling remains possible after
+    // provider removal/revocation, because it neither reads nor exposes content.
+    if config.enabled {
+        crate::platform::plugin_data::service::authorized_list_for_principal(
+            app,
+            &owner,
+            &config.read_request(),
+            None,
+            1,
+        )?;
+    }
+    let mut inner = state.inner.lock().map_err(|_| unavailable())?;
+    let mut stored = inner.stored.clone();
+    let index = match stored
+        .watches
+        .iter()
+        .position(|watch| matches(watch, &owner, &config))
+    {
+        Some(index) => {
+            let watch = &mut stored.watches[index];
+            if config.enabled && !watch.config.enabled {
+                watch.eligible_since = policy::initial_cutoff(checked_at);
+            }
+            watch.config = config.clone();
+            index
+        }
+        None => {
+            if stored.watches.len() >= MAX_WATCHES
+                || stored.watches.iter().filter(|w| w.owner == owner).count() >= MAX_OWNER_WATCHES
+            {
+                return Err(Error::new("quotaExceeded", "Too many reminder watches"));
+            }
+            stored
+                .watches
+                .push(Watch::new(owner.clone(), config.clone(), checked_at)?);
+            stored.watches.len() - 1
+        }
+    };
+    commit(&state, &mut inner, stored)?;
+    inner.health.insert(
+        key(&owner, &config),
+        Health {
+            available: config.enabled,
+            last_checked_at: Some(checked_at),
+        },
+    );
+    let result = status_for(&inner, &inner.stored.watches[index]);
+    drop(inner);
+    state.wake.notify_one();
+    Ok(result)
+}
+
+pub(crate) fn status(app: &AppHandle, owner: &Identity) -> Result<Vec<ReminderStatus>> {
+    let state = state(app)?;
+    let watches: Vec<_> = state
+        .inner
+        .lock()
+        .map_err(|_| unavailable())?
+        .stored
+        .watches
+        .iter()
+        .filter(|w| w.owner == *owner)
+        .cloned()
+        .collect();
+    for watch in watches {
+        let available = watch.config.enabled
+            && crate::platform::plugin_data::service::authorized_list_for_principal(
+                app,
+                owner,
+                &watch.config.read_request(),
+                None,
+                1,
+            )
+            .is_ok();
+        let mut inner = state.inner.lock().map_err(|_| unavailable())?;
+        inner.health.insert(
+            key(owner, &watch.config),
+            Health {
+                available,
+                last_checked_at: Some(now()),
+            },
+        );
+    }
+    let inner = state.inner.lock().map_err(|_| unavailable())?;
+    Ok(inner
+        .stored
+        .watches
+        .iter()
+        .filter(|w| w.owner == *owner)
+        .map(|w| status_for(&inner, w))
+        .collect())
+}
+
+/// Reads are reauthorized on every page. Source data stays only in this call's
+/// memory; no private note text is cached on disk or emitted as a global event.
+fn current_candidates(app: &AppHandle, watch: &Watch) -> Result<Vec<Candidate>> {
+    let request = watch.config.read_request();
+    let mut cursor = None;
+    let mut result = Vec::new();
+    let mut rows = 0;
+    loop {
+        let page = crate::platform::plugin_data::service::authorized_list_for_principal(
+            app,
+            &watch.owner,
+            &request,
+            cursor.as_deref(),
+            100,
+        )?;
+        for row in page.items {
+            rows += 1;
+            if row.provider == request.provider && row.resource_type == request.resource_type {
+                result.extend(policy::candidates(&watch.owner, &row));
+            }
+        }
+        if result.len() > 8192 {
+            result.truncate(8192);
+        }
+        match page.next {
+            Some(next) if rows < MAX_READ_ROWS && cursor.as_ref() != Some(&next) => {
+                cursor = Some(next)
+            }
+            _ => break,
+        }
+    }
+    Ok(result)
+}
+
+pub(crate) fn pending(app: &AppHandle, owner: &Identity) -> Result<Vec<ReminderItem>> {
+    let state = state(app)?;
+    let watches: Vec<_> = state
+        .inner
+        .lock()
+        .map_err(|_| unavailable())?
+        .stored
+        .watches
+        .iter()
+        .filter(|w| w.owner == *owner && w.config.enabled)
+        .cloned()
+        .collect();
+    let mut items = Vec::new();
+    for snapshot in watches {
+        // Completed/deleted/changed-due resources and revoked grants cannot leave
+        // stale private contents in the feed, even immediately after a delivery.
+        let fresh = current_candidates(app, &snapshot);
+        let mut inner = state.inner.lock().map_err(|_| unavailable())?;
+        inner.health.insert(
+            key(owner, &snapshot.config),
+            Health {
+                available: fresh.is_ok(),
+                last_checked_at: Some(now()),
+            },
+        );
+        if let Some(watch) = inner
+            .stored
+            .watches
+            .iter()
+            .find(|w| matches(w, owner, &snapshot.config))
+        {
+            items.extend(policy::pending_items(
+                watch,
+                fresh.as_deref().map_err(|_| ()),
+            ));
+        }
+    }
+    items.sort_by(|a, b| (a.due_at, &a.id).cmp(&(b.due_at, &b.id)));
+    items.truncate(policy::MAX_BATCH);
+    Ok(items)
+}
+
+pub(crate) fn acknowledge(app: &AppHandle, owner: &Identity, ids: &[String]) -> Result<()> {
+    if ids.len() > policy::MAX_BATCH
+        || ids
+            .iter()
+            .any(|id| id.len() != 64 || !id.bytes().all(|b| b.is_ascii_hexdigit()))
+    {
+        return Err(Error::new(
+            "invalidRequest",
+            "Invalid reminder delivery IDs",
+        ));
+    }
+    let state = state(app)?;
+    let mut inner = state.inner.lock().map_err(|_| unavailable())?;
+    if ids.iter().any(|id| {
+        !inner
+            .stored
+            .watches
+            .iter()
+            .filter(|w| w.owner == *owner)
+            .any(|w| w.receipts.iter().any(|r| r.id == *id))
+    }) {
+        return Err(Error::new(
+            "forbidden",
+            "Reminder delivery does not belong to this plugin",
+        ));
+    }
+    let mut stored = inner.stored.clone();
+    for watch in stored.watches.iter_mut().filter(|w| w.owner == *owner) {
+        for receipt in &mut watch.receipts {
+            if ids.contains(&receipt.id) {
+                receipt.acknowledged = true;
+            }
+        }
+    }
+    commit(&state, &mut inner, stored)
+}
+
+fn tick(app: &AppHandle, state: &ReminderState) {
+    let snapshots = match state.inner.lock() {
+        Ok(inner) => inner
+            .stored
+            .watches
+            .iter()
+            .filter(|w| w.config.enabled)
+            .cloned()
+            .collect::<Vec<_>>(),
+        Err(_) => return,
+    };
+    let mut notifications: Vec<(String, Vec<String>)> = Vec::new();
+    for snapshot in snapshots {
+        if state.stopping.load(Ordering::Acquire) {
+            return;
+        }
+        let checked_at = now();
+        let minute = (Local::now().hour() * 60 + Local::now().minute()) as u16;
+        let first = current_candidates(app, &snapshot);
+        if let Ok(mut inner) = state.inner.lock() {
+            inner.health.insert(
+                key(&snapshot.owner, &snapshot.config),
+                Health {
+                    available: first.is_ok(),
+                    last_checked_at: Some(checked_at),
+                },
+            );
+        }
+        let Ok(first) = first else {
+            continue;
+        };
+        if policy::select_due(&snapshot, &first, checked_at, minute).is_empty()
+            && policy::fallback_ids(&snapshot, &first, checked_at, minute).is_empty()
+        {
+            continue;
+        }
+        // Second authorized read immediately before due selection/delivery. It
+        // prevents an old scan scheduling deleted/completed records later on.
+        let Ok(fresh) = current_candidates(app, &snapshot) else {
+            if let Ok(mut inner) = state.inner.lock() {
+                inner.health.insert(
+                    key(&snapshot.owner, &snapshot.config),
+                    Health {
+                        available: false,
+                        last_checked_at: Some(now()),
+                    },
+                );
+            }
+            continue;
+        };
+        let Ok(mut inner) = state.inner.lock() else {
+            return;
+        };
+        let mut stored = inner.stored.clone();
+        let Some(index) = stored
+            .watches
+            .iter()
+            .position(|w| matches(w, &snapshot.owner, &snapshot.config))
+        else {
+            continue;
+        };
+        let watch = &mut stored.watches[index];
+        let due = policy::select_due(watch, &fresh, checked_at, minute);
+        policy::record_delivery(watch, &due, checked_at);
+        let ids = policy::fallback_ids(watch, &fresh, checked_at, minute);
+        for receipt in &mut watch.receipts {
+            if ids.contains(&receipt.id) {
+                receipt.notified = true;
+            }
+        }
+        if due.is_empty() && ids.is_empty() {
+            continue;
+        }
+        if commit(state, &mut inner, stored).is_ok() && !ids.is_empty() {
+            notifications.push((key(&snapshot.owner, &snapshot.config), ids));
+        }
+    }
+    if notifications.is_empty() || state.stopping.load(Ordering::Acquire) {
+        return;
+    }
+    // One consolidated fallback for the tick, with no private source details.
+    if crate::platform::host::core::otools_show_notification(
+        app.clone(),
+        "You have reminders".into(),
+        None,
+    )
+    .is_err()
+    {
+        // A failed OS delivery is retryable. Never persist any notification body.
+        if let Ok(mut inner) = state.inner.lock() {
+            let mut stored = inner.stored.clone();
+            for watch in &mut stored.watches {
+                if let Some((_, ids)) = notifications
+                    .iter()
+                    .find(|(k, _)| *k == key(&watch.owner, &watch.config))
+                {
+                    for receipt in &mut watch.receipts {
+                        if ids.contains(&receipt.id) {
+                            receipt.notified = false;
+                        }
+                    }
+                }
+            }
+            let _ = commit(state, &mut inner, stored);
+        }
+    }
+}
diff --git a/src-tauri/src/platform/plugin_reminders/tests.rs b/src-tauri/src/platform/plugin_reminders/tests.rs
new file mode 100644
index 00000000..ce50b212
--- /dev/null
+++ b/src-tauri/src/platform/plugin_reminders/tests.rs
@@ -0,0 +1,201 @@
+use super::{persistence, policy::*, types::*};
+use ot_plugin_data::{Identity, Resource};
+use serde_json::json;
+
+fn identity(uuid: &str) -> Identity {
+    Identity {
+        source: "installed".into(),
+        uuid: uuid.into(),
+    }
+}
+fn resource(data: serde_json::Value) -> Resource {
+    Resource {
+        provider: identity("notes"),
+        resource_type: "notes.v1".into(),
+        id: "note-1".into(),
+        revision: 1,
+        updated_at: 1,
+        deleted: false,
+        data,
+        private_data: None,
+    }
+}
+fn config() -> ConfigureRequest {
+    ConfigureRequest {
+        provider: identity("notes"),
+        resource_type: "notes.v1".into(),
+        enabled: true,
+        quiet_hours: None,
+        cooldown_ms: None,
+    }
+}
+fn watch(now: u64) -> Watch {
+    Watch::new(identity("pet"), config(), now).unwrap()
+}
+const NOW: u64 = 1_794_304_800_000;
+
+#[test]
+fn strict_iso_and_numeric_due_dates_never_guess_relative_text() {
+    assert_eq!(parse_due_value(&json!("2026-11-10T10:00:00Z")), Some(NOW));
+    assert_eq!(parse_due_value(&json!(NOW)), Some(NOW));
+    assert_eq!(parse_due_value(&json!("tomorrow morning")), None);
+    assert_eq!(parse_due_value(&json!("2026-02-30T10:00:00Z")), None);
+    assert_eq!(parse_due_value(&json!(1.5)), None);
+}
+
+#[test]
+fn notes_schedule_only_one_explicit_time_per_item_and_ignore_done() {
+    let row = resource(
+        json!({"title":"Planning", "body":"tomorrow morning", "todos":[
+            {"id":"a","text":"Call 2026-11-10T10:00:00Z","done":false},
+            {"id":"b","text":"Done 2026-11-10T10:00:00Z","done":true},
+            {"id":"c","text":"2026-11-10T10:00:00Z or 2026-11-11T10:00:00Z","done":false}
+        ]}),
+    );
+    let items = candidates(&identity("pet"), &row);
+    assert_eq!(items.len(), 1);
+    assert_eq!(items[0].due_at, NOW);
+    assert!(items[0].body.contains("Call"));
+    assert!(items[0].body.contains("notes"));
+    let mut deleted = row.clone();
+    deleted.deleted = true;
+    assert!(candidates(&identity("pet"), &deleted).is_empty());
+}
+
+#[test]
+fn local_minute_time_uses_local_timezone_and_rejects_ambiguous_dates() {
+    use chrono::{Local, TimeZone};
+    let expected = Local
+        .with_ymd_and_hms(2026, 11, 10, 10, 0, 0)
+        .single()
+        .unwrap()
+        .timestamp_millis() as u64;
+    assert_eq!(
+        explicit_time("Appointment 2026-11-10 10:00"),
+        Some(expected)
+    );
+    assert_eq!(explicit_time("2026-11-10 10:00 or 2026-11-11 10:00"), None);
+    assert_eq!(explicit_time("2026-11-10"), None);
+    assert_eq!(explicit_time("2026-11-10 25:00"), None);
+}
+
+#[test]
+fn generic_metadata_is_bounded_and_receipts_ignore_revision_only_edits() {
+    let mut row = resource(
+        json!({"dueAt":NOW,"title":"a".repeat(500),"body":"b".repeat(2000),"completed":false}),
+    );
+    row.resource_type = "tasks.v2".into();
+    let item = candidates(&identity("pet"), &row).remove(0);
+    assert!(item.title.chars().count() <= 120);
+    assert!(item.body.chars().count() <= 500);
+    row.revision += 1;
+    assert_eq!(candidates(&identity("pet"), &row)[0].id, item.id);
+    row.data["completed"] = json!(true);
+    assert!(candidates(&identity("pet"), &row).is_empty());
+}
+
+#[test]
+fn first_enable_ignores_old_backlog_but_restart_collects_missed_due_and_deduplicates() {
+    let mut watch = watch(NOW);
+    let old = candidates(&watch.owner, &resource(json!({"dueAt":NOW-3_600_000}))).remove(0);
+    let current = candidates(&watch.owner, &resource(json!({"dueAt":NOW}))).remove(0);
+    assert!(select_due(&watch, &[old], NOW, 600).is_empty());
+    assert_eq!(select_due(&watch, &[current.clone()], NOW, 600).len(), 1);
+    record_delivery(&mut watch, &[current.clone()], NOW);
+    let persisted = serde_json::to_string(&watch).unwrap();
+    let restored: Watch = serde_json::from_str(&persisted).unwrap();
+    assert!(select_due(&restored, &[current], NOW + 3_600_000, 660).is_empty());
+    let missed = candidates(&restored.owner, &resource(json!({"dueAt":NOW+600_000}))).remove(0);
+    assert_eq!(
+        select_due(&restored, &[missed], NOW + 86_400_000, 600).len(),
+        1
+    );
+    assert!(!persisted.contains("note-1"));
+}
+
+#[test]
+fn midnight_quiet_hours_cooldown_and_disabled_watch_block_delivery() {
+    let mut watch = watch(NOW);
+    let item = candidates(&watch.owner, &resource(json!({"dueAt":NOW}))).remove(0);
+    watch.config.quiet_hours = Some(QuietHours {
+        start: 1320,
+        end: 420,
+    });
+    assert!(select_due(&watch, &[item.clone()], NOW, 30).is_empty());
+    assert!(select_due(&watch, &[item.clone()], NOW, 1320).is_empty());
+    assert_eq!(select_due(&watch, &[item.clone()], NOW, 420).len(), 1);
+    watch.last_delivered_at = Some(NOW - 1);
+    assert!(select_due(&watch, &[item.clone()], NOW, 600).is_empty());
+    watch.last_delivered_at = None;
+    watch.config.enabled = false;
+    assert!(select_due(&watch, &[item], NOW, 600).is_empty());
+}
+
+#[test]
+fn private_feed_requires_current_authorization_and_fresh_undone_resource() {
+    let mut watch = watch(NOW);
+    let item = candidates(&watch.owner, &resource(json!({"dueAt":NOW}))).remove(0);
+    record_delivery(&mut watch, &[item.clone()], NOW);
+    assert_eq!(pending_items(&watch, Ok(&[item.clone()])).len(), 1);
+    assert!(pending_items(&watch, Err(())).is_empty());
+    assert!(pending_items(&watch, Ok(&[])).is_empty());
+    watch.receipts[0].acknowledged = true;
+    assert!(pending_items(&watch, Ok(&[item])).is_empty());
+}
+
+#[test]
+fn bubble_acknowledgement_cancels_delayed_private_os_fallback() {
+    let mut watch = watch(NOW);
+    let item = candidates(&watch.owner, &resource(json!({"dueAt":NOW}))).remove(0);
+    record_delivery(&mut watch, &[item.clone()], NOW);
+    assert!(fallback_ids(&watch, &[item.clone()], NOW, 600).is_empty());
+    assert_eq!(
+        fallback_ids(&watch, &[item.clone()], NOW + 60_000, 600).len(),
+        1
+    );
+    watch.receipts[0].acknowledged = true;
+    assert!(fallback_ids(&watch, &[item], NOW + 60_000, 600).is_empty());
+}
+
+#[test]
+fn delivery_batches_are_capped_and_owner_identity_changes_delivery_keys() {
+    let watch = watch(NOW);
+    let items: Vec<_> = (0..100)
+        .flat_map(|i| {
+            let mut row = resource(json!({"dueAt":NOW}));
+            row.id = i.to_string();
+            candidates(&watch.owner, &row)
+        })
+        .collect();
+    assert_eq!(select_due(&watch, &items, NOW, 600).len(), 20);
+    assert_ne!(
+        candidates(&identity("pet"), &resource(json!({"dueAt":NOW})))[0].id,
+        candidates(&identity("other"), &resource(json!({"dueAt":NOW})))[0].id
+    );
+}
+
+#[test]
+fn atomic_storage_roundtrips_configuration_without_source_text() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("reminders.json");
+    let mut watch = watch(NOW);
+    let item = candidates(
+        &watch.owner,
+        &resource(json!({"dueAt":NOW,"body":"PRIVATE NOTE SECRET"})),
+    )
+    .remove(0);
+    record_delivery(&mut watch, &[item], NOW);
+    let stored = Stored {
+        version: 1,
+        watches: vec![watch],
+    };
+    persistence::save(&path, &stored).unwrap();
+    let loaded = persistence::load(&path).unwrap();
+    assert_eq!(loaded.watches[0].receipts.len(), 1);
+    assert!(!std::fs::read_to_string(&path)
+        .unwrap()
+        .contains("PRIVATE NOTE SECRET"));
+    persistence::save(&path, &Stored::default()).unwrap();
+    assert!(persistence::load(&path).unwrap().watches.is_empty());
+    assert_eq!(std::fs::read_dir(dir.path()).unwrap().count(), 1);
+}
