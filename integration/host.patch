@@ -0,0 +1,234 @@
+//! Host-owned persistent resource broker. This crate does not authenticate callers:
+//! adapters must supply the identity resolved by the runtime and validate manifests.
+//! Grant mutation is a host-only capability and must never be exposed to consumers.
+mod types;
+pub use types::*;
+
+use base64::{engine::general_purpose::URL_SAFE_NO_PAD, Engine};
+use hmac::{Hmac, Mac};
+use rusqlite::{params, Connection, OptionalExtension, Transaction, TransactionBehavior};
+use serde::{Deserialize, Serialize};
+use sha2::Sha256;
+use std::{path::Path, time::{Duration, SystemTime, UNIX_EPOCH}};
+
+const MAX_SAFE_INTEGER: u64 = 9_007_199_254_740_991;
+const MAX_RECORD_BYTES: usize = 1024 * 1024;
+const MAX_PAGE: usize = 500;
+
+pub struct Store { connection: Connection, retention: usize, cursor_key: Vec<u8> }
+#[derive(Serialize, Deserialize)]
+struct Cursor {
+    version: u8, viewer: Identity, provider: Identity,
+    resource_type: String, grant_revision: u64, sequence: u64,
+    kind: String, last_id: Option<String>,
+}
+struct Access { scope: Scope, revision: u64 }
+impl Access {
+    fn includes(&self, id: &str) -> bool { match &self.scope { Scope::All => true, Scope::Ids { ids } => ids.iter().any(|x| x == id) } }
+    fn ids(&self) -> Result<Option<String>> { match &self.scope { Scope::All => Ok(None), Scope::Ids { ids } => Ok(Some(serde_json::to_string(ids)?)) } }
+}
+
+pub fn validate_identity(identity: &Identity) -> Result<()> {
+    for value in [&identity.source, &identity.uuid] {
+        validate_name(value)?;
+        if value.trim() != value || *value != value.to_ascii_lowercase() { return Err(invalid("Identity must be canonical lowercase")); }
+    }
+    Ok(())
+}
+pub fn validate_name(value: &str) -> Result<()> {
+    if value.is_empty() || value.len() > 256 || value.chars().any(char::is_control) { return Err(invalid("Name must contain 1..256 bytes without control characters")); }
+    Ok(())
+}
+pub fn validate_scope(scope: &Scope) -> Result<()> {
+    if let Scope::Ids { ids } = scope {
+        if ids.is_empty() || ids.len() > 256 { return Err(invalid("Scope must contain 1..256 IDs")); }
+        for id in ids { validate_name(id)?; }
+    }
+    Ok(())
+}
+fn invalid(message: &str) -> Error { Error::new("invalidRequest", message) }
+fn denied() -> Error { Error::new("permissionDenied", "Resource access is not granted") }
+fn resync() -> Error { Error::new("resyncRequired", "Reload the resource list before polling again") }
+fn invalid_cursor() -> Error { Error::new("invalidCursor", "Cursor does not belong to this request") }
+fn key(identity: &Identity) -> Result<String> { validate_identity(identity)?; Ok(serde_json::to_string(identity)?) }
+fn page_limit(limit: usize) -> Result<i64> { if limit == 0 || limit > MAX_PAGE { Err(invalid("Page limit must be 1..500")) } else { Ok(limit as i64) } }
+
+impl Store {
+    pub fn open(path: &Path, retention: usize) -> Result<Self> {
+        #[cfg(unix)] {
+            use std::os::unix::fs::OpenOptionsExt;
+            std::fs::OpenOptions::new().write(true).create(true).truncate(false).mode(0o600).open(path)
+                .map_err(|_| Error::new("storageFailed", "Cannot open plugin data store"))?;
+        }
+        Self::initialize(Connection::open(path)?, retention)
+    }
+    pub fn memory(retention: usize) -> Result<Self> { Self::initialize(Connection::open_in_memory()?, retention) }
+    fn initialize(mut connection: Connection, retention: usize) -> Result<Self> {
+        if !(1..=10_000).contains(&retention) { return Err(invalid("Change retention must be 1..10000")); }
+        connection.busy_timeout(Duration::from_secs(5))?;
+        connection.execute_batch("PRAGMA journal_mode=WAL; PRAGMA synchronous=FULL; PRAGMA foreign_keys=ON;")?;
+        let tx = connection.transaction_with_behavior(TransactionBehavior::Immediate)?;
+        let version: u32 = tx.query_row("PRAGMA user_version", [], |r| r.get(0))?;
+        if version > 1 { return Err(Error::new("storageFailed", "Unsupported plugin data schema version")); }
+        tx.execute_batch(include_str!("schema.sql"))?;
+        tx.execute("INSERT OR IGNORE INTO metadata(key,value) VALUES('cursorKey',?1)", [format!("{}{}", uuid::Uuid::new_v4(), uuid::Uuid::new_v4())])?;
+        let cursor_key: String = tx.query_row("SELECT value FROM metadata WHERE key='cursorKey'", [], |r| r.get(0))?;
+        tx.commit()?;
+        Ok(Self { connection, retention, cursor_key: cursor_key.into_bytes() })
+    }
+
+    /// Whole-record replacement. Use the owner's last revision to avoid stale layout/content writes.
+    pub fn put(&mut self, owner: &Identity, request: PutRequest) -> Result<Resource> {
+        self.write(owner, request, false)
+    }
+    /// expectedRevision=0 may create a tombstone for a deleted legacy resource.
+    pub fn remove(&mut self, owner: &Identity, request: RemoveRequest) -> Result<Resource> {
+        self.write(owner, PutRequest { resource_type: request.resource_type, id: request.id,
+            expected_revision: request.expected_revision, data: serde_json::Value::Null,
+            private_data: None, recreate: false }, true)
+    }
+    fn write(&mut self, owner: &Identity, request: PutRequest, deleted: bool) -> Result<Resource> {
+        let provider = key(owner)?; validate_name(&request.resource_type)?; validate_name(&request.id)?;
+        if request.expected_revision >= MAX_SAFE_INTEGER { return Err(invalid("Revision is outside the supported range")); }
+        let tx = self.connection.transaction_with_behavior(TransactionBehavior::Immediate)?;
+        let old = load(&tx, &provider, &request.resource_type, &request.id)?;
+        if old.as_ref().map_or(0, |x| x.revision) != request.expected_revision {
+            return Err(Error::new("conflict", "Resource revision has changed"));
+        }
+        if old.as_ref().is_some_and(|x| x.deleted) && !deleted && !request.recreate {
+            return Err(Error::new("deleted", "Recreation requires explicit intent and the tombstone revision"));
+        }
+        if request.recreate && !old.as_ref().is_some_and(|x| x.deleted) { return Err(invalid("Only tombstones can be recreated")); }
+        // Idempotent deletion must not advance the revision or retain deleted content.
+        if deleted && old.as_ref().is_some_and(|x| x.deleted) { return Ok(old.unwrap()); }
+        let now = SystemTime::now().duration_since(UNIX_EPOCH).map_err(|_| Error::new("storageFailed", "System clock is invalid"))?.as_millis() as u64;
+        let resource = Resource { provider: owner.clone(), resource_type: request.resource_type,
+            id: request.id, revision: request.expected_revision + 1,
+            updated_at: now.max(old.as_ref().map_or(0, |x| x.updated_at)), deleted,
+            data: request.data, private_data: request.private_data };
+        let record = serde_json::to_string(&resource)?;
+        if record.len() > MAX_RECORD_BYTES { return Err(invalid("Resource exceeds 1 MiB")); }
+        tx.execute("INSERT INTO resources(provider,type,id,record) VALUES(?1,?2,?3,?4) ON CONFLICT(provider,type,id) DO UPDATE SET record=excluded.record",
+            params![provider, resource.resource_type, resource.id, record])?;
+        tx.execute("INSERT INTO streams(provider,type,sequence) VALUES(?1,?2,1) ON CONFLICT(provider,type) DO UPDATE SET sequence=sequence+1", params![provider, resource.resource_type])?;
+        let (sequence, _) = stream(&tx, &provider, &resource.resource_type)?;
+        if sequence > MAX_SAFE_INTEGER { return Err(Error::new("storageFailed", "Change sequence exhausted")); }
+        // Keep only invalidation metadata/history of shared fields; private fields never enter the log.
+        let mut public = resource.clone(); public.private_data = None;
+        tx.execute("INSERT INTO changes(provider,type,sequence,id,record) VALUES(?1,?2,?3,?4,?5)",
+            params![provider, resource.resource_type, sequence, resource.id, serde_json::to_string(&public)?])?;
+        let floor = sequence.saturating_sub(self.retention as u64);
+        tx.execute("DELETE FROM changes WHERE provider=?1 AND type=?2 AND sequence<=?3", params![provider, resource.resource_type, floor])?;
+        tx.execute("UPDATE streams SET floor=MAX(floor,?3) WHERE provider=?1 AND type=?2", params![provider, resource.resource_type, floor])?;
+        tx.commit()?;
+        Ok(resource)
+    }
+
+    pub fn list_grants(&mut self) -> Result<Vec<Grant>> {
+        let mut statement = self.connection.prepare(
+            "SELECT consumer,provider,type,scope,subscribe FROM grants WHERE active=1 ORDER BY consumer,provider,type LIMIT 1001",
+        )?;
+        let rows = statement.query_map([], |row| Ok((
+            row.get::<_, String>(0)?, row.get::<_, String>(1)?, row.get::<_, String>(2)?,
+            row.get::<_, String>(3)?, row.get::<_, bool>(4)?,
+        )))?.collect::<std::result::Result<Vec<_>, _>>()?;
+        if rows.len() > 1000 { return Err(Error::new("busy", "Too many grants to display safely")); }
+        rows.into_iter().map(|(consumer, provider, resource_type, scope, subscribe)| Ok(Grant {
+            consumer: serde_json::from_str(&consumer)?, provider: serde_json::from_str(&provider)?,
+            resource_type, scope: serde_json::from_str(&scope)?, subscribe,
+        })).collect()
+    }
+
+    /// Trusted host only. Changing or restoring a grant invalidates previous cursors.
+    pub fn set_grant(&mut self, consumer: &Identity, provider: &Identity, resource_type: &str, scope: Scope, subscribe: bool) -> Result<()> {
+        validate_scope(&scope)?;
+        self.change_grant(consumer, provider, resource_type, scope, subscribe, true)
+    }
+    pub fn revoke(&mut self, consumer: &Identity, provider: &Identity, resource_type: &str) -> Result<()> {
+        self.change_grant(consumer, provider, resource_type, Scope::All, false, false)
+    }
+    fn change_grant(&mut self, consumer: &Identity, provider: &Identity, resource_type: &str, scope: Scope, subscribe: bool, active: bool) -> Result<()> {
+        let consumer = key(consumer)?; let provider = key(provider)?; validate_name(resource_type)?;
+        self.connection.execute("INSERT INTO grants(consumer,provider,type,scope,subscribe,active,revision) VALUES(?1,?2,?3,?4,?5,?6,1) ON CONFLICT(consumer,provider,type) DO UPDATE SET scope=excluded.scope,subscribe=excluded.subscribe,active=excluded.active,revision=revision+1",
+            params![consumer, provider, resource_type, serde_json::to_string(&scope)?, subscribe, active])?;
+        Ok(())
+    }
+    pub fn get(&mut self, viewer: &Identity, request: &ReadRequest, id: &str) -> Result<Option<Resource>> {
+        validate_name(id)?;
+        let tx = self.connection.transaction()?;
+        let access = authorize(&tx, viewer, request, false)?;
+        if !access.includes(id) { return Err(denied()); }
+        let resource = load(&tx, &key(&request.provider)?, &request.resource_type, id)?;
+        Ok(resource.map(|x| redact(x, viewer)))
+    }
+    pub fn list(&mut self, viewer: &Identity, request: &ReadRequest, cursor: Option<&str>, limit: usize) -> Result<ListPage> {
+        let limit = page_limit(limit)?;
+        let tx = self.connection.transaction()?;
+        let access = authorize(&tx, viewer, request, false)?;
+        let provider = key(&request.provider)?;
+        let (sequence, _) = stream(&tx, &provider, &request.resource_type)?;
+        let last = if let Some(cursor) = cursor {
+            let cursor = decode(&self.cursor_key, cursor, viewer, request, &access, "list")?;
+            if cursor.sequence != sequence { return Err(resync()); }
+            cursor.last_id
+        } else { None };
+        let ids = access.ids()?;
+        let mut statement = tx.prepare("SELECT record FROM resources WHERE provider=?1 AND type=?2 AND (?3 IS NULL OR id>?3) AND (?4 IS NULL OR id IN (SELECT value FROM json_each(?4))) ORDER BY id LIMIT ?5")?;
+        let records = statement.query_map(params![provider, request.resource_type, last, ids, limit+1], |row| row.get::<_,String>(0))?.collect::<std::result::Result<Vec<_>,_>>()?;
+        let mut items = records.into_iter().map(|x| Ok(redact(serde_json::from_str(&x)?, viewer))).collect::<Result<Vec<_>>>()?;
+        let more = items.len() > limit as usize; items.truncate(limit as usize);
+        let next = if more { Some(encode(&self.cursor_key, cursor_for(viewer, request, &access, sequence, "list", items.last().map(|x| x.id.clone())))?) } else { None };
+        let after = encode(&self.cursor_key, cursor_for(viewer, request, &access, sequence, "changes", None))?;
+        Ok(ListPage { items, next, after })
+    }
+    pub fn changes(&mut self, viewer: &Identity, request: &ReadRequest, after: &str, limit: usize) -> Result<ChangesPage> {
+        let limit = page_limit(limit)?;
+        let tx = self.connection.transaction()?;
+        let access = authorize(&tx, viewer, request, true)?;
+        let cursor = decode(&self.cursor_key, after, viewer, request, &access, "changes")?;
+        let provider = key(&request.provider)?;
+        let (sequence, floor) = stream(&tx, &provider, &request.resource_type)?;
+        if cursor.sequence < floor || cursor.sequence > sequence { return Err(resync()); }
+        let mut statement = tx.prepare("SELECT sequence,record FROM changes WHERE provider=?1 AND type=?2 AND sequence>?3 AND (?4 IS NULL OR id IN (SELECT value FROM json_each(?4))) ORDER BY sequence LIMIT ?5")?;
+        let mut records = statement.query_map(params![provider, request.resource_type, cursor.sequence, access.ids()?, limit+1], |row| Ok((row.get::<_,u64>(0)?,row.get::<_,String>(1)?)))?.collect::<std::result::Result<Vec<_>,_>>()?;
+        let has_more = records.len() > limit as usize; records.truncate(limit as usize);
+        let position = if has_more { records.last().unwrap().0 } else { sequence };
+        let items = records.into_iter().map(|(_,x)| Ok(redact(serde_json::from_str(&x)?, viewer))).collect::<Result<Vec<_>>>()?;
+        let after = encode(&self.cursor_key, cursor_for(viewer, request, &access, position, "changes", None))?;
+        Ok(ChangesPage { items, after, has_more })
+    }
+}
+fn load(tx: &Transaction<'_>, provider: &str, resource_type: &str, id: &str) -> Result<Option<Resource>> {
+    tx.query_row("SELECT record FROM resources WHERE provider=?1 AND type=?2 AND id=?3", params![provider, resource_type, id], |r| r.get::<_,String>(0)).optional()?.map(|x| serde_json::from_str(&x).map_err(Into::into)).transpose()
+}
+fn stream(tx: &Transaction<'_>, provider: &str, resource_type: &str) -> Result<(u64,u64)> {
+    Ok(tx.query_row("SELECT sequence,floor FROM streams WHERE provider=?1 AND type=?2", params![provider, resource_type], |r| Ok((r.get(0)?,r.get(1)?))).optional()?.unwrap_or((0,0)))
+}
+fn authorize(tx: &Transaction<'_>, viewer: &Identity, request: &ReadRequest, subscribe: bool) -> Result<Access> {
+    let consumer = key(viewer)?; let provider = key(&request.provider)?; validate_name(&request.resource_type)?;
+    if viewer == &request.provider { return Ok(Access { scope: Scope::All, revision: 0 }); }
+    let grant = tx.query_row("SELECT scope,subscribe,active,revision FROM grants WHERE consumer=?1 AND provider=?2 AND type=?3", params![consumer,provider,request.resource_type], |r| Ok((r.get::<_,String>(0)?,r.get::<_,bool>(1)?,r.get::<_,bool>(2)?,r.get::<_,u64>(3)?))).optional()?.ok_or_else(denied)?;
+    if !grant.2 || (subscribe && !grant.1) { return Err(denied()); }
+    Ok(Access { scope: serde_json::from_str(&grant.0)?, revision: grant.3 })
+}
+fn redact(mut resource: Resource, viewer: &Identity) -> Resource { if &resource.provider != viewer { resource.private_data = None; } resource }
+fn cursor_for(viewer: &Identity, request: &ReadRequest, access: &Access, sequence: u64, kind: &str, last_id: Option<String>) -> Cursor {
+    Cursor { version:1,viewer:viewer.clone(),provider:request.provider.clone(),resource_type:request.resource_type.clone(),grant_revision:access.revision,sequence,kind:kind.into(),last_id }
+}
+fn encode(key: &[u8], cursor: Cursor) -> Result<String> {
+    let json = serde_json::to_vec(&cursor)?;
+    let mut mac = Hmac::<Sha256>::new_from_slice(key).map_err(|_| invalid_cursor())?; mac.update(&json);
+    Ok(format!("{}.{}", URL_SAFE_NO_PAD.encode(&json), URL_SAFE_NO_PAD.encode(mac.finalize().into_bytes())))
+}
+fn decode(key: &[u8], token: &str, viewer: &Identity, request: &ReadRequest, access: &Access, kind: &str) -> Result<Cursor> {
+    if token.len() > 4096 { return Err(invalid_cursor()); }
+    let (data, signature) = token.split_once('.').ok_or_else(invalid_cursor)?;
+    let data = URL_SAFE_NO_PAD.decode(data).map_err(|_| invalid_cursor())?;
+    let signature = URL_SAFE_NO_PAD.decode(signature).map_err(|_| invalid_cursor())?;
+    let mut mac = Hmac::<Sha256>::new_from_slice(key).map_err(|_| invalid_cursor())?; mac.update(&data);
+    mac.verify_slice(&signature).map_err(|_| invalid_cursor())?;
+    let cursor: Cursor = serde_json::from_slice(&data).map_err(|_| invalid_cursor())?;
+    if cursor.version != 1 || &cursor.viewer != viewer || cursor.provider != request.provider || cursor.resource_type != request.resource_type || cursor.kind != kind { return Err(invalid_cursor()); }
+    if cursor.grant_revision != access.revision { return Err(resync()); }
+    Ok(cursor)
+}
diff --git a/crates/ot-plugin-data/src/schema.sql b/crates/ot-plugin-data/src/schema.sql
new file mode 100644
index 00000000..fc15f729
--- /dev/null
+++ b/crates/ot-plugin-data/src/schema.sql
@@ -0,0 +1,22 @@
+CREATE TABLE IF NOT EXISTS metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);
+CREATE TABLE IF NOT EXISTS resources (
+    provider TEXT NOT NULL, type TEXT NOT NULL, id TEXT NOT NULL,
+    record TEXT NOT NULL,
+    PRIMARY KEY (provider, type, id)
+);
+CREATE TABLE IF NOT EXISTS streams (
+    provider TEXT NOT NULL, type TEXT NOT NULL, sequence INTEGER NOT NULL DEFAULT 0,
+    floor INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (provider, type)
+);
+CREATE TABLE IF NOT EXISTS changes (
+    provider TEXT NOT NULL, type TEXT NOT NULL, sequence INTEGER NOT NULL,
+    id TEXT NOT NULL, record TEXT NOT NULL,
+    PRIMARY KEY (provider, type, sequence)
+);
+CREATE TABLE IF NOT EXISTS grants (
+    consumer TEXT NOT NULL, provider TEXT NOT NULL, type TEXT NOT NULL,
+    scope TEXT NOT NULL, subscribe INTEGER NOT NULL, active INTEGER NOT NULL,
+    revision INTEGER NOT NULL,
+    PRIMARY KEY (consumer, provider, type)
+);
+PRAGMA user_version = 1;
diff --git a/crates/ot-plugin-data/src/types.rs b/crates/ot-plugin-data/src/types.rs
new file mode 100644
index 00000000..e551bb93
--- /dev/null
+++ b/crates/ot-plugin-data/src/types.rs
@@ -0,0 +1,66 @@
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Identity { pub source: String, pub uuid: String }
+#[derive(Clone, Debug, Default, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Declaration {
+    #[serde(default)] pub provides: Vec<String>,
+    #[serde(default)] pub consumes: Vec<String>,
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Resource {
+    pub provider: Identity,
+    #[serde(rename = "type")] pub resource_type: String,
+    pub id: String, pub revision: u64, pub updated_at: u64, pub deleted: bool, pub data: Value,
+    #[serde(skip_serializing_if = "Option::is_none")] pub private_data: Option<Value>,
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ReadRequest { pub provider: Identity, #[serde(rename = "type")] pub resource_type: String }
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct PutRequest {
+    #[serde(rename = "type")] pub resource_type: String,
+    pub id: String, pub expected_revision: u64, pub data: Value,
+    #[serde(default)] pub private_data: Option<Value>,
+    #[serde(default)] pub recreate: bool,
+}
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct RemoveRequest {
+    #[serde(rename = "type")] pub resource_type: String,
+    pub id: String, pub expected_revision: u64,
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "camelCase", deny_unknown_fields)]
+pub enum Scope { All, Ids { ids: Vec<String> } }
+impl Default for Scope { fn default() -> Self { Self::All } }
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ListPage { pub items: Vec<Resource>, pub next: Option<String>, pub after: String }
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ChangesPage { pub items: Vec<Resource>, pub after: String, pub has_more: bool }
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Grant {
+    pub consumer: Identity, pub provider: Identity,
+    #[serde(rename = "type")] pub resource_type: String,
+    pub scope: Scope, pub subscribe: bool,
+}
+#[derive(Clone, Debug, Serialize)]
+pub struct Error { pub code: String, pub message: String }
+impl Error {
+    pub fn new(code: &str, message: impl Into<String>) -> Self { Self { code: code.into(), message: message.into() } }
+}
+impl std::fmt::Display for Error {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { write!(f, "{}: {}", self.code, self.message) }
+}
+impl std::error::Error for Error {}
+impl From<rusqlite::Error> for Error { fn from(_: rusqlite::Error) -> Self { Self::new("storageFailed", "Plugin data storage operation failed") } }
+impl From<serde_json::Error> for Error { fn from(_: serde_json::Error) -> Self { Self::new("storageFailed", "Invalid stored plugin data") } }
+pub type Result<T> = std::result::Result<T, Error>;
diff --git a/crates/ot-plugin-data/tests/broker.rs b/crates/ot-plugin-data/tests/broker.rs
new file mode 100644
index 00000000..9209e877
--- /dev/null
+++ b/crates/ot-plugin-data/tests/broker.rs
@@ -0,0 +1,121 @@
+use ot_plugin_data::*;
+use serde_json::json;
+
+fn identity(source: &str, uuid: &str) -> Identity { Identity { source: source.into(), uuid: uuid.into() } }
+fn owner() -> Identity { identity("market", "notes") }
+fn consumer() -> Identity { identity("market", "lingchat") }
+fn put(id: &str, expected: u64) -> PutRequest {
+    PutRequest { resource_type: "note".into(), id: id.into(), expected_revision: expected,
+        data: json!({"text":"shared"}), private_data: Some(json!({"geometry":"secret"})), recreate: false }
+}
+fn query() -> ReadRequest { ReadRequest { provider: owner(), resource_type: "note".into() } }
+fn grant(store: &mut Store, scope: Scope, subscribe: bool) {
+    store.set_grant(&consumer(), &owner(), "note", scope, subscribe).unwrap();
+}
+
+#[test]
+fn persistence_default_deny_source_isolation_and_private_redaction() {
+    let dir = tempfile::tempdir().unwrap(); let path = dir.path().join("data.db");
+    let mut store = Store::open(&path, 4).unwrap();
+    assert_eq!(store.put(&owner(), put("a", 0)).unwrap().revision, 1);
+    assert_eq!(store.get(&consumer(), &query(), "a").unwrap_err().code, "permissionDenied");
+    grant(&mut store, Scope::All, true);
+    assert_eq!(store.get(&consumer(), &query(), "a").unwrap().unwrap().private_data, None);
+    assert_eq!(store.get(&identity("dev-debug", "lingchat"), &query(), "a").unwrap_err().code, "permissionDenied");
+    let spoofed = ReadRequest { provider: identity("dev-debug", "notes"), ..query() };
+    assert_eq!(store.get(&consumer(), &spoofed, "a").unwrap_err().code, "permissionDenied");
+    drop(store);
+    let mut store = Store::open(&path, 4).unwrap();
+    assert_eq!(store.get(&owner(), &query(), "a").unwrap().unwrap().private_data, Some(json!({"geometry":"secret"})));
+    let page = store.list(&consumer(), &query(), None, 10).unwrap();
+    assert_eq!(page.items.len(), 1); assert!(page.items[0].private_data.is_none());
+    assert!(!serde_json::to_string(&page).unwrap().contains("privateData"));
+}
+
+#[test]
+fn cas_delete_and_migration_cannot_resurrect_without_explicit_recreate() {
+    let mut store = Store::memory(4).unwrap();
+    store.put(&owner(), put("a", 0)).unwrap();
+    assert_eq!(store.put(&owner(), put("a", 0)).unwrap_err().code, "conflict");
+    let removed = store.remove(&owner(), RemoveRequest { resource_type:"note".into(), id:"a".into(), expected_revision:1 }).unwrap();
+    assert_eq!(removed.revision, 2); assert!(removed.deleted);
+    assert_eq!(removed.data, serde_json::Value::Null); assert!(removed.private_data.is_none());
+    assert_eq!(store.put(&owner(), put("a", 0)).unwrap_err().code, "conflict");
+    assert_eq!(store.put(&owner(), put("a", 2)).unwrap_err().code, "deleted");
+    let mut recreate = put("a", 2); recreate.recreate = true;
+    assert_eq!(store.put(&owner(), recreate).unwrap().revision, 3);
+    store.remove(&owner(), RemoveRequest { resource_type:"note".into(), id:"legacy".into(), expected_revision:0 }).unwrap();
+    assert_eq!(store.put(&owner(), put("legacy", 0)).unwrap_err().code, "conflict");
+}
+
+#[test]
+fn scope_revocation_and_cursor_binding_apply_to_every_read() {
+    let mut store = Store::memory(8).unwrap();
+    store.put(&owner(), put("a", 0)).unwrap(); store.put(&owner(), put("b", 0)).unwrap();
+    grant(&mut store, Scope::Ids { ids: vec!["a".into()] }, true);
+    let page = store.list(&consumer(), &query(), None, 1).unwrap();
+    assert_eq!(page.items.iter().map(|x|x.id.as_str()).collect::<Vec<_>>(), vec!["a"]);
+    assert_eq!(store.get(&consumer(), &query(), "b").unwrap_err().code, "permissionDenied");
+    assert_eq!(store.changes(&owner(), &query(), &page.after, 2).unwrap_err().code, "invalidCursor");
+    store.put(&owner(), put("a", 1)).unwrap(); store.put(&owner(), put("b", 1)).unwrap();
+    let changes = store.changes(&consumer(), &query(), &page.after, 1).unwrap();
+    assert_eq!(changes.items.len(), 1); assert_eq!(changes.items[0].id, "a");
+    store.revoke(&consumer(), &owner(), "note").unwrap();
+    assert_eq!(store.get(&consumer(), &query(), "a").unwrap_err().code, "permissionDenied");
+    assert_eq!(store.changes(&consumer(), &query(), &changes.after, 1).unwrap_err().code, "permissionDenied");
+    grant(&mut store, Scope::All, true);
+    assert_eq!(store.changes(&consumer(), &query(), &changes.after, 1).unwrap_err().code, "resyncRequired");
+}
+
+#[test]
+fn bounded_change_retention_snapshot_pagination_and_tampering() {
+    let mut store = Store::memory(2).unwrap();
+    let initial = store.list(&owner(), &query(), None, 1).unwrap();
+    store.put(&owner(), put("a", 0)).unwrap(); store.put(&owner(), put("b", 0)).unwrap();
+    let page = store.list(&owner(), &query(), None, 1).unwrap();
+    assert_eq!(page.items[0].id, "a");
+    let next = store.list(&owner(), &query(), page.next.as_deref(), 1).unwrap();
+    assert_eq!(next.items[0].id, "b"); assert!(next.next.is_none());
+    store.put(&owner(), put("c", 0)).unwrap();
+    assert_eq!(store.list(&owner(), &query(), page.next.as_deref(), 1).unwrap_err().code, "resyncRequired");
+    assert_eq!(store.changes(&owner(), &query(), &initial.after, 1).unwrap_err().code, "resyncRequired");
+    let changes = store.changes(&owner(), &query(), &page.after, 1).unwrap();
+    assert_eq!(changes.items[0].id, "c"); assert!(!changes.has_more);
+    assert_eq!(store.changes(&owner(), &query(), &(page.after + "x"), 1).unwrap_err().code, "invalidCursor");
+    assert_eq!(store.list(&owner(), &query(), None, 0).unwrap_err().code, "invalidRequest");
+}
+
+#[test]
+fn read_grant_does_not_authorize_change_subscription_or_provider_writes() {
+    let mut store = Store::memory(4).unwrap(); store.put(&owner(), put("a", 0)).unwrap();
+    grant(&mut store, Scope::All, false);
+    let page = store.list(&consumer(), &query(), None, 10).unwrap();
+    assert_eq!(store.changes(&consumer(), &query(), &page.after, 10).unwrap_err().code, "permissionDenied");
+    store.put(&consumer(), put("a", 0)).unwrap();
+    assert_eq!(store.get(&owner(), &query(), "a").unwrap().unwrap().revision, 1);
+}
+
+#[test]
+fn trusted_management_lists_only_active_grants_and_revocation_is_durable() {
+    let dir = tempfile::tempdir().unwrap(); let path = dir.path().join("data.db");
+    let mut store = Store::open(&path, 4).unwrap();
+    grant(&mut store, Scope::Ids { ids: vec!["one".into()] }, true);
+    let grants = store.list_grants().unwrap();
+    assert_eq!(grants.len(), 1); assert_eq!(grants[0].consumer, consumer());
+    assert_eq!(grants[0].provider, owner()); assert!(grants[0].subscribe);
+    store.revoke(&consumer(), &owner(), "note").unwrap(); drop(store);
+    assert!(Store::open(&path, 4).unwrap().list_grants().unwrap().is_empty());
+}
+
+#[test]
+fn separate_connections_serialize_compare_and_swap_and_preserve_cursor_across_restart() {
+    let dir = tempfile::tempdir().unwrap(); let path = dir.path().join("data.db");
+    let mut first = Store::open(&path, 4).unwrap(); let mut second = Store::open(&path, 4).unwrap();
+    first.put(&owner(), put("a", 0)).unwrap();
+    let page = first.list(&owner(), &query(), None, 10).unwrap();
+    second.put(&owner(), put("a", 1)).unwrap();
+    assert_eq!(first.put(&owner(), put("a", 1)).unwrap_err().code, "conflict");
+    drop(first); drop(second);
+    let mut reopened = Store::open(&path, 4).unwrap();
+    assert_eq!(reopened.changes(&owner(), &query(), &page.after, 10).unwrap().items[0].revision, 2);
+}
diff --git a/crates/ot-plugin-data/tests/consent.rs b/crates/ot-plugin-data/tests/consent.rs
