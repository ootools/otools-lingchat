--- /dev/null
+++ b/src-tauri/src/platform/observation/core.rs
@@ -0,0 +1,156 @@
+//! Bounded host-owned authorization; testable without Tauri or an active display.
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc,
+};
+pub const HEARTBEAT_MS: u64 = 2_500;
+pub const PENDING_MS: u64 = 120_000;
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Owner {
+    pub label: String,
+    pub uuid: String,
+    pub source: String,
+    pub url: String,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Phase {
+    Pending,
+    Active,
+    Stopped,
+}
+#[derive(Debug)]
+pub struct Session {
+    pub id: String,
+    pub owner: Owner,
+    pub interval_ms: u64,
+    pub phase: Phase,
+    pub reason: Option<&'static str>,
+    pub created_at: u64,
+    pub heartbeat_at: Option<u64>,
+    pub last_capture: Option<u64>,
+    pub in_flight: bool,
+    pub cancel: Arc<AtomicBool>,
+}
+impl Session {
+    pub fn new(
+        id: String,
+        owner: Owner,
+        interval: Option<u64>,
+        now: u64,
+    ) -> Result<Self, &'static str> {
+        let interval_ms = interval.unwrap_or(60_000);
+        if !(30_000..=3_600_000).contains(&interval_ms) {
+            return Err("invalidRequest");
+        }
+        Ok(Self {
+            id,
+            owner,
+            interval_ms,
+            phase: Phase::Pending,
+            reason: None,
+            created_at: now,
+            heartbeat_at: None,
+            last_capture: None,
+            in_flight: false,
+            cancel: Arc::new(AtomicBool::new(false)),
+        })
+    }
+    pub fn authorize(&self, owner: &Owner) -> Result<(), &'static str> {
+        if self.owner != *owner {
+            Err("forbidden")
+        } else {
+            Ok(())
+        }
+    }
+    pub fn approve(&mut self, now: u64, permission: bool) -> Result<(), &'static str> {
+        if self.phase == Phase::Stopped {
+            return Err("stopped");
+        }
+        if self.phase != Phase::Pending {
+            return Err("invalidRequest");
+        }
+        if now.saturating_sub(self.created_at) > PENDING_MS {
+            self.stop("expired");
+            return Err("expired");
+        }
+        if !permission {
+            return Err("permissionDenied");
+        }
+        self.phase = Phase::Active;
+        // A post-approval heartbeat proves the active indicator was rendered.
+        self.heartbeat_at = None;
+        Ok(())
+    }
+    pub fn heartbeat(&mut self, now: u64, visible: bool) -> Result<(), &'static str> {
+        if self.phase == Phase::Stopped {
+            return Err("stopped");
+        }
+        if !visible {
+            self.stop("indicatorUnavailable");
+            return Err("indicatorUnavailable");
+        }
+        self.heartbeat_at = Some(now);
+        Ok(())
+    }
+    pub fn begin_capture(&mut self, owner: &Owner, now: u64) -> Result<(), &'static str> {
+        self.authorize(owner)?;
+        match self.phase {
+            Phase::Pending => return Err("consentRequired"),
+            Phase::Stopped => return Err("stopped"),
+            _ => {}
+        }
+        if self.heartbeat_at.is_none() {
+            return Err("indicatorUnavailable");
+        }
+        if self
+            .heartbeat_at
+            .is_some_and(|last| now.saturating_sub(last) > HEARTBEAT_MS)
+        {
+            self.stop("indicatorUnavailable");
+            return Err("indicatorUnavailable");
+        }
+        if self.in_flight {
+            return Err("busy");
+        }
+        if self
+            .last_capture
+            .is_some_and(|last| now.saturating_sub(last) < self.interval_ms)
+        {
+            return Err("tooSoon");
+        }
+        self.last_capture = Some(now);
+        self.in_flight = true;
+        Ok(())
+    }
+    pub fn finish_capture(&mut self) -> bool {
+        self.in_flight = false;
+        self.phase == Phase::Active && !self.cancel.load(Ordering::Acquire)
+    }
+    pub fn stop(&mut self, reason: &'static str) {
+        if self.phase != Phase::Stopped {
+            self.reason = Some(reason);
+        }
+        self.phase = Phase::Stopped;
+        self.cancel.store(true, Ordering::Release);
+    }
+}
+/// Continuous time includes sleep; awake time excludes sleep on macOS. Either
+/// clock disagreement or a missed supervisor deadline revokes consent permanently.
+#[derive(Default)]
+pub struct SafetyClock {
+    previous: Option<(u64, u64)>,
+}
+impl SafetyClock {
+    pub fn sample(&mut self, continuous: u64, awake: u64) -> bool {
+        let safe = self.previous.is_none_or(|(c, a)| {
+            let dc = continuous.saturating_sub(c);
+            let da = awake.saturating_sub(a);
+            continuous >= c && awake >= a && dc <= 2_000 && dc.abs_diff(da) <= 10
+        });
+        self.previous = Some((continuous, awake));
+        safe
+    }
+}
