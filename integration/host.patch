diff --git a/src/features/observation/main.ts b/src/features/observation/main.ts
new file mode 100644
index 00000000..8c2f06fd
--- /dev/null
+++ b/src/features/observation/main.ts
@@ -0,0 +1,64 @@
+import { invoke } from '@tauri-apps/api/core';
+import { createIndicator, type Surface } from './controller';
+import { labels } from './labels';
+import './style.css';
+const params = new URLSearchParams(location.search);
+const id = params.get('id') ?? '';
+const locale = params.get('locale') ?? 'en-US';
+const text = labels(locale);
+document.documentElement.lang = locale;
+document.documentElement.dir = locale === 'ar-SA' ? 'rtl' : 'ltr';
+document.title = `OTools · ${text.title}`;
+const root = document.querySelector<HTMLElement>('#observation-root')!;
+function element<K extends keyof HTMLElementTagNameMap>(tag: K, value?: string) {
+  const node = document.createElement(tag); if (value) node.textContent = value; return node;
+}
+const brand = element('div', 'OTools'); brand.className = 'brand';
+const heading = element('h1', text.title);
+const badge = element('p', text.pending); badge.className = 'badge'; badge.setAttribute('role', 'status');
+const details = element('dl');
+const consent = element('p', text.consent);
+const safety = element('p', text.safety); safety.className = 'safety';
+const error = element('p'); error.className = 'error'; error.setAttribute('role', 'alert');
+const actions = element('div'); actions.className = 'actions';
+const permission = element('button', text.permission);
+const approve = element('button', text.approve); approve.className = 'approve'; approve.disabled = true;
+const stop = element('button', text.cancel); stop.className = 'stop';
+actions.append(permission, approve, stop);
+root.append(brand, heading, badge, details, consent, safety, error, actions);
+let busy = false;
+function render(value: Surface) {
+  const { status } = value;
+  badge.textContent = text[status.state]; badge.dataset.state = status.state;
+  const target = status.target;
+  const targetLabel = `${target.kind === 'screen' ? text.screen : text.window} ${target.kind === 'screen' ? target.displayId : target.windowId}`;
+  details.replaceChildren();
+  for (const [key, valueText] of [[text.plugin, `${value.pluginName} (${value.pluginUuid} · ${value.source})`], [text.target, value.targetName ?? targetLabel], [text.interval, `${status.intervalMs / 1000} ${text.seconds}`]]) {
+    details.append(element('dt', key), element('dd', valueText));
+  }
+  permission.hidden = value.permissionGranted || status.state !== 'pending';
+  approve.hidden = status.state !== 'pending';
+  approve.disabled = busy || !value.permissionGranted;
+  stop.textContent = status.state === 'pending' ? text.cancel : text.stop;
+  consent.hidden = status.state !== 'pending';
+}
+const controller = createIndicator(id, {
+  invoke, render,
+  painted: () => new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(() => resolve()))),
+  visible: () => document.visibilityState === 'visible',
+});
+async function act(action: () => Promise<void>) {
+  if (busy) return;
+  busy = true; approve.disabled = true; permission.disabled = true; error.textContent = '';
+  try { await action(); }
+  catch { error.textContent = text.error; }
+  finally { busy = false; permission.disabled = false; }
+}
+permission.onclick = () => { void act(async () => { await controller.permission(); busy = false; await controller.load(); }); };
+approve.onclick = () => { void act(() => controller.approve()); };
+// Stop remains usable while permission/approval is pending.
+stop.onclick = () => { stop.disabled = true; void controller.stop().catch(() => { stop.disabled = false; error.textContent = text.error; }); };
+document.addEventListener('visibilitychange', () => { if (document.visibilityState !== 'visible') void controller.stop().catch(() => {}); });
+window.addEventListener('pagehide', () => { void controller.stop().catch(() => {}); });
+void controller.load().catch(() => { error.textContent = text.error; });
+setInterval(() => { void controller.tick().catch(() => { error.textContent = text.error; void controller.stop().catch(() => {}); }); }, 500);
