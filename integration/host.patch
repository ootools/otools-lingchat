+import { describe, expect, it } from 'vitest';
+import { createSSRApp } from 'vue';
+import { renderToString } from 'vue/server-renderer';
+import ConsentView from './ConsentView.vue';
+import type { ViewState } from './controller';
+
+const state: ViewState = {
+  mode: 'consent', phase: 'ready', canDecide: true, grants: [],
+  request: { id: 'r', consumer: { source: 'market', uuid: '<img src=x onerror=alert(1)>' }, provider: { source: 'builtin', uuid: 'notes' },
+    type: 'note', scope: { kind: 'ids', ids: ['<script>bad()</script>'] }, subscribe: true, expiresAt: 5000 },
+};
+const render = (value = state, locale = 'en') => renderToString(createSSRApp(ConsentView, { state: value, locale }));
+describe('consent rendering', () => {
+  it('discloses AI use, persistent access, subscriptions, source and exact selected resources as escaped text', async () => {
+    const html = await render();
+    expect(html).toContain('AI'); expect(html).toContain('revoked'); expect(html).toContain('market');
+    expect(html).toContain('&lt;script&gt;bad()&lt;/script&gt;');
+    expect(html).not.toContain('<img'); expect(html).not.toContain('<script>');
+    expect(html).not.toContain('<iframe'); expect(html).not.toContain('href=');
+    expect(html).toContain('future changes');
+  });
+  it('disables approve and deny after expiry and explains that the request must be restarted', async () => {
+    const html = await render({ ...state, phase: 'expired', canDecide: false });
+    expect(html).toMatch(/data-action="approve"[^>]*disabled/);
+    expect(html).toMatch(/data-action="deny"[^>]*disabled/);
+    expect(html).toContain('expired');
+  });
+  it('shows all-resource grants, an empty management state, and revoke confirmation', async () => {
+    const grant = { ...state.request!, scope: { kind: 'all' as const } };
+    const html = await render({ mode: 'management', phase: 'ready', canDecide: false, grants: [grant], confirmIndex: 0 });
+    expect(html).toContain('All current and future resources'); expect(html).toContain('Confirm revoke');
+    const empty = await render({ mode: 'management', phase: 'ready', canDecide: false, grants: [] });
+    expect(empty).toContain('No active grants');
+  });
+  it.each(['zh', 'en', 'ja', 'ko', 'de', 'es', 'ru', 'ar'])('renders complete localized labels for %s', async locale => {
+    const html = await render(state, locale);
+    expect(html).not.toContain('undefined');
+    expect(html).toContain(locale === 'ar' ? 'dir="rtl"' : 'dir="ltr"');
+    if (locale !== 'en') expect(html).not.toContain('Approve access');
+  });
+});
diff --git a/src/features/plugin-data/ConsentView.vue b/src/features/plugin-data/ConsentView.vue
