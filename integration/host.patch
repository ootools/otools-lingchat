diff --git a/plugins/otools-notes/src/hostNotesStore.test.ts b/plugins/otools-notes/src/hostNotesStore.test.ts
new file mode 100644
index 00000000..ed5acb49
--- /dev/null
+++ b/plugins/otools-notes/src/hostNotesStore.test.ts
@@ -0,0 +1,175 @@
+import { describe, expect, it } from 'vitest'
+import { createNotesStore } from './notes'
+import { createHostNotesStore } from './hostNotesStore'
+import { memoryStorage, MemoryNotesHost } from './notesTestHost'
+
+function legacy() {
+  const storage = memoryStorage()
+  const store = createNotesStore(storage)
+  store.create('work/日 %')
+  store.patch('work/日 %', { title: 'Keep title', body: 'Keep body', todos: [{ id: 'task', text: 'Call Sam', done: true }], color: 'pink', alwaysOnTop: true, x: -120, y: 40, width: 500 })
+  store.remove('deleted')
+  return storage
+}
+
+describe('host Notes migration', () => {
+  it('imports v1 content and tombstones once, preserving layout privately and all local backups', async () => {
+    const storage = legacy()
+    const backup = [...storage.data]
+    const host = new MemoryNotesHost()
+    const store = createHostNotesStore(host, storage)
+    await store.initialize()
+    const imported = await store.load('work/日 %')
+    expect(imported).toEqual(createNotesStore(storage).load('work/日 %'))
+    const resource = await host.get({ type: 'notes.v1', id: 'work/日 %' })
+    expect(resource?.data).toEqual({ title: 'Keep title', body: 'Keep body', todos: [{ id: 'task', text: 'Call Sam', done: true }], createdAt: imported!.createdAt, updatedAt: imported!.updatedAt })
+    expect(resource?.privateData).toEqual({ color: 'pink', alwaysOnTop: true, width: 500, height: 440, x: -120, y: 40 })
+    expect(await host.get({ type: 'notes.v1', id: 'deleted' })).toMatchObject({ deleted: true, revision: 1 })
+    await createHostNotesStore(host, storage).initialize()
+    expect(host.sequence).toBe(2)
+    expect([...storage.data]).toEqual(backup)
+  })
+
+  it('resumes partial failure without overwriting migrated records or deleting backups', async () => {
+    const storage = legacy()
+    const backup = [...storage.data]
+    const host = new MemoryNotesHost()
+    host.failId = 'deleted'
+    await expect(createHostNotesStore(host, storage).initialize()).rejects.toThrow('unavailable')
+    expect([...storage.data]).toEqual(backup)
+    host.failId = undefined
+    await createHostNotesStore(host, storage).initialize()
+    expect(host.sequence).toBe(2)
+    expect(await host.get({ type: 'notes.v1', id: 'deleted' })).toMatchObject({ deleted: true })
+  })
+
+  it('keeps a host tombstone when an old local record migrates again', async () => {
+    const storage = legacy()
+    const host = new MemoryNotesHost()
+    const store = createHostNotesStore(host, storage)
+    await store.initialize()
+    await store.remove('work/日 %')
+    await createHostNotesStore(host, storage).initialize()
+    expect(await store.create('work/日 %')).toBeNull()
+    expect(await store.patch('work/日 %', { width: 900 })).toBeNull()
+    expect(await store.list()).toEqual([])
+  })
+
+  it('ignores malformed or noncanonical legacy keys and preserves the raw source', async () => {
+    const storage = memoryStorage()
+    storage.setItem('otools-notes:v1:a', '{broken')
+    storage.setItem('otools-notes:v1:%62', JSON.stringify({ version: 1, id: 'b', title: 'wrong key' }))
+    storage.setItem('otools-notes:v1:c', JSON.stringify({ version: 2, id: 'c' }))
+    storage.setItem('otools-notes:v1:d', JSON.stringify({ version: 1, id: 'other', deleted: true }))
+    const backup = [...storage.data]
+    const host = new MemoryNotesHost()
+    await createHostNotesStore(host, storage).initialize()
+    expect(host.sequence).toBe(0)
+    expect([...storage.data]).toEqual(backup)
+  })
+
+  it('handles two migrations starting together with create-only revision checks', async () => {
+    const storage = legacy()
+    const host = new MemoryNotesHost()
+    await Promise.all([createHostNotesStore(host, storage).initialize(), createHostNotesStore(host, storage).initialize()])
+    expect(host.sequence).toBe(2)
+    expect(host.conflicts).toBeGreaterThan(0)
+  })
+})
+
+describe('host Notes revisions', () => {
+  it('rebases simultaneous content and layout patches on the latest revision', async () => {
+    const host = new MemoryNotesHost()
+    const a = createHostNotesStore(host, memoryStorage())
+    const b = createHostNotesStore(host, memoryStorage())
+    await a.create('a')
+    await Promise.all([a.patch('a', { body: 'New body' }), b.patch('a', { width: 700, x: 60 })])
+    expect(await a.load('a')).toMatchObject({ body: 'New body', width: 700, x: 60 })
+    expect(host.conflicts).toBeGreaterThan(0)
+    expect(await host.get({ type: 'notes.v1', id: 'a' })).toMatchObject({ revision: 3 })
+  })
+
+  it('rebases todo operations so different windows do not replace each other’s tasks', async () => {
+    const host = new MemoryNotesHost()
+    const a = createHostNotesStore(host, memoryStorage())
+    const b = createHostNotesStore(host, memoryStorage())
+    await a.create('a')
+    await a.patch('a', { todos: [{ id: 'one', text: 'One', done: false }, { id: 'two', text: 'Two', done: false }] })
+    await Promise.all([
+      a.patch('a', note => ({ todos: note.todos.map(todo => todo.id === 'one' ? { ...todo, done: true } : todo) })),
+      b.patch('a', note => ({ todos: note.todos.map(todo => todo.id === 'two' ? { ...todo, text: 'Edited' } : todo) })),
+    ])
