+++ b/src/features/plugin-data/bootstrap.ts
@@ -0,0 +1,19 @@
+export type Bootstrap = {
+  mode: 'consent'; token: string; locale: string; requestId: string;
+} | { mode: 'management'; token: string; locale: string };
+
+export function takeBootstrap(host: { __OToolsDataConsent?: unknown }): Bootstrap | undefined {
+  const value = host.__OToolsDataConsent;
+  delete host.__OToolsDataConsent;
+  if (!value || typeof value !== 'object') return;
+  const data = value as Record<string, unknown>;
+  if (typeof data.token !== 'string' || !data.token || typeof data.locale !== 'string') return;
+  if (data.mode === 'management') return { mode: data.mode, token: data.token, locale: data.locale };
+  if (data.mode === 'consent' && typeof data.requestId === 'string' && data.requestId) {
+    return { mode: data.mode, token: data.token, locale: data.locale, requestId: data.requestId };
+  }
+}
+
+declare global {
+  interface Window { __OToolsDataConsent?: unknown }
+}
