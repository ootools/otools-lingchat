diff --git a/src-tauri/src/platform/ai/jobs.rs b/src-tauri/src/platform/ai/jobs.rs
new file mode 100644
index 00000000..c37cba6b
--- /dev/null
+++ b/src-tauri/src/platform/ai/jobs.rs
@@ -0,0 +1,107 @@
+//! Host AI job lifecycle. Only the transport may supply an authenticated owner.
+use super::queue::{AiReadResult, JobOwner, JobRegistry, MAX_JOB_MS};
+use crate::platform::capture;
+use base64::Engine;
+use ot_ai_generate_text::{
+    conversation::{prepare_request, stream_conversation, AiCapabilities, AiRequest},
+    resolve_ai_settings,
+};
+use serde::Serialize;
+use std::{
+    sync::{atomic::{AtomicBool, Ordering}, Mutex, MutexGuard, Once, OnceLock},
+    time::{Duration, Instant},
+};
+use tauri::{AppHandle, Webview};
+
+static JOBS: OnceLock<Mutex<JobRegistry>> = OnceLock::new();
+static EPOCH: OnceLock<Instant> = OnceLock::new();
+static REAPER: Once = Once::new();
+static SHUTDOWN: AtomicBool = AtomicBool::new(false);
+fn now() -> u64 { EPOCH.get_or_init(Instant::now).elapsed().as_millis() as u64 }
+fn registry() -> Result<MutexGuard<'static, JobRegistry>, String> {
+    JOBS.get_or_init(|| Mutex::new(JobRegistry::default())).lock().map_err(|_| "aiUnavailable".into())
+}
+
+fn ensure_reaper() {
+    REAPER.call_once(|| {
+        tauri::async_runtime::spawn(async {
+            while !SHUTDOWN.load(Ordering::Acquire) {
+                tokio::time::sleep(Duration::from_secs(15)).await;
+                if let Ok(mut jobs) = registry() { jobs.prune(now()); }
+            }
+        });
+    });
+}
+
+#[derive(Serialize)]
+pub struct StartedJob { pub id: String }
+
+pub fn capabilities() -> AiCapabilities {
+    // No per-request overrides, including for image requests.
+    let settings = resolve_ai_settings(None).ok();
+    AiCapabilities::from_settings(settings.as_ref())
+}
+
+pub fn start(app: &AppHandle, webview: &Webview, owner: JobOwner, request: AiRequest) -> Result<StartedJob, String> {
+    request.validate()?;
+    if SHUTDOWN.load(Ordering::Acquire) { return Err("aiUnavailable".into()); }
+    ensure_reaper();
+    let id = uuid::Uuid::new_v4().to_string();
+    let cancellation = registry()?.start(id.clone(), owner.clone(), now())?;
+    let prepared = (|| {
+        let settings = resolve_ai_settings(None).map_err(|_| "invalidHostConfiguration".to_owned())?;
+        let mut image_bytes = 0usize;
+        let built = prepare_request(&request, &settings.model, |image_id| {
+            // Capture ownership/permission is checked independently on every image.
+            // Arc bytes are borrowed; AI never consumes or extends the caller's lease.
+            let capture_owner = capture::identity::caller(app, webview).map_err(|error| error.code)?;
+            let bytes = capture::service::image_bytes(&capture_owner, image_id).map_err(|error| error.code)?;
+            image_bytes = image_bytes.saturating_add(bytes.len());
+            if image_bytes > 32 * 1024 * 1024 { return Err("imagesTooLarge".into()); }
+            Ok(format!("data:image/png;base64,{}", base64::engine::general_purpose::STANDARD.encode(bytes.as_ref())))
+        })?;
+        // The reservation precedes this second authorization. A close during
+        // preparation either invalidates identity or removes/cancels the reservation.
+        if super::transport::ai_owner(app, webview)? != owner { return Err("forbidden".into()); }
+        Ok((settings, built))
+    })();
+    let (settings, built) = match prepared {
+        Ok(value) => value,
+        Err(error) => { registry()?.remove(&id); return Err(error); }
+    };
+    let task_id = id.clone();
+    tauri::async_runtime::spawn(async move {
+        let delta_id = task_id.clone();
+        let provider = stream_conversation(&settings, built, move |delta| registry()?.delta(&delta_id, delta, now()));
+        tokio::select! {
+            biased;
+            _ = cancellation.cancelled() => {},
+            _ = tokio::time::sleep(Duration::from_millis(MAX_JOB_MS)) => {
+                if let Ok(mut jobs) = registry() { jobs.finish(&task_id, Some("timeout"), now()); }
+            },
+            result = provider => {
+                if let Ok(mut jobs) = registry() { jobs.finish(&task_id, result.as_ref().err().map(String::as_str), now()); }
+            },
+        }
+        // All prepared image data and the HTTP stream are dropped here on every exit.
+    });
+    Ok(StartedJob { id })
+}
+
+pub fn read(owner: &JobOwner, id: &str, after: u64) -> Result<AiReadResult, String> {
+    let mut jobs = registry()?;
+    jobs.prune(now());
+    jobs.read(owner, id, after)
+}
+pub fn cancel(owner: &JobOwner, id: &str) -> Result<(), String> { registry()?.cancel(owner, id, now()) }
+
+/// Hook actual child-Webview destruction, custom-window cleanup, and runtime
+/// binding replacement/navigation. Drops private output and stops HTTP inference.
+pub fn handle_window_destroyed(label: &str) {
+    if let Ok(mut jobs) = registry() { jobs.remove_owner(label); }
+}
+/// Hook host exit before shutting down the async runtime.
+pub fn handle_shutdown() {
+    SHUTDOWN.store(true, Ordering::Release);
+    if let Ok(mut jobs) = registry() { jobs.shutdown(); }
+}
