+use tauri::{AppHandle, Webview};
+
+/// Opens a native-managed UI only. Grant mutations require that UI's private token.
+#[tauri::command]
+pub async fn otools_host_plugin_data_open_settings(
+    app: AppHandle,
+    webview: Webview,
+) -> Result<(), String> {
+    crate::platform::capture::identity::validate_host_view_action(&app, &webview)
+        .map_err(|error| error.to_string())?;
+    tauri::async_runtime::spawn_blocking(move || super::consent_window::open_management(&app))
+        .await
+        .map_err(|error| error.to_string())?
+}
diff --git a/src-tauri/src/platform/plugin_data/transport.rs b/src-tauri/src/platform/plugin_data/transport.rs
new file mode 100644
index 00000000..fb1743a4
--- /dev/null
+++ b/src-tauri/src/platform/plugin_data/transport.rs
@@ -0,0 +1,112 @@
+use super::{access::AccessRequest, identity, policy, service};
+use ot_plugin_data::{ChangesPage, Identity, ListPage, PutRequest, ReadRequest, RemoveRequest, Resource, Result, Scope};
+use serde::{Deserialize, Serialize};
+use tauri::{AppHandle, Webview};
+fn default_limit() -> usize { 100 }
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ListRequest {
+    pub provider: Option<Identity>, #[serde(rename = "type")] pub resource_type: String,
+    pub cursor: Option<String>, #[serde(default = "default_limit")] pub limit: usize,
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct GetRequest { pub provider: Option<Identity>, #[serde(rename = "type")] pub resource_type: String, pub id: String }
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ChangesRequest {
+    pub provider: Option<Identity>, #[serde(rename = "type")] pub resource_type: String,
+    pub after: String, #[serde(default = "default_limit")] pub limit: usize,
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct RequestAccessRequest {
+    pub provider: Identity, #[serde(rename = "type")] pub resource_type: String,
+    #[serde(default)] pub scope: Scope, #[serde(default)] pub subscribe: bool,
+}
+#[derive(Serialize)]
+pub struct AccessStatus { pub id: String, pub status: String }
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ConsentReadRequest { pub token: String }
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub enum Decision { Approve, Deny, Revoke }
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ConsentDecisionRequest { pub token: String, pub decision: Decision }
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct RevokeGrantRequest {
+    pub token: String, pub consumer: Identity, pub provider: Identity,
+    #[serde(rename = "type")] pub resource_type: String,
+}
+#[tauri::command]
+pub fn otools_host_plugin_data_grants_list(app: AppHandle, webview: Webview, request: ConsentReadRequest) -> Result<Vec<ot_plugin_data::Grant>> {
+    service::validate_management(&app, &webview, &request.token)?;
+    service::with_store(&app, |store| store.list_grants())
+}
+#[tauri::command]
+pub fn otools_host_plugin_data_grants_revoke(app: AppHandle, webview: Webview, request: RevokeGrantRequest) -> Result<()> {
+    service::validate_management(&app, &webview, &request.token)?;
+    service::with_store(&app, |store| store.revoke(&request.consumer, &request.provider, &request.resource_type))
+}
+
+#[tauri::command]
+pub fn otools_host_plugin_data_discover(app: AppHandle, webview: Webview) -> Result<Vec<policy::Provider>> {
+    policy::discover(&identity::participants(&app)?, &identity::caller(&app, &webview)?)
+}
+#[tauri::command]
+pub fn otools_host_plugin_data_list(app: AppHandle, webview: Webview, request: ListRequest) -> Result<ListPage> {
+    let caller = identity::caller(&app, &webview)?;
+    let read = ReadRequest {provider:request.provider.unwrap_or_else(|| caller.clone()),resource_type:request.resource_type};
+    service::authorized_list_for_principal(&app, &caller, &read, request.cursor.as_deref(), request.limit)
+}
+#[tauri::command]
+pub fn otools_host_plugin_data_get(app: AppHandle, webview: Webview, request: GetRequest) -> Result<Option<Resource>> {
+    let caller = identity::caller(&app, &webview)?;
+    let read = ReadRequest {provider:request.provider.unwrap_or_else(|| caller.clone()),resource_type:request.resource_type};
+    policy::authorize_read(&identity::participants(&app)?, &caller, &read)?;
+    service::with_store(&app, |store| store.get(&caller, &read, &request.id))
+}
+#[tauri::command]
+pub fn otools_host_plugin_data_put(app: AppHandle, webview: Webview, request: PutRequest) -> Result<Resource> {
+    let caller = identity::caller(&app, &webview)?;
+    policy::authorize_write(&identity::participants(&app)?, &caller, &request.resource_type)?;
+    service::with_store(&app, |store| store.put(&caller, request))
+}
+#[tauri::command]
+pub fn otools_host_plugin_data_remove(app: AppHandle, webview: Webview, request: RemoveRequest) -> Result<Resource> {
+    let caller = identity::caller(&app, &webview)?;
+    policy::authorize_write(&identity::participants(&app)?, &caller, &request.resource_type)?;
+    service::with_store(&app, |store| store.remove(&caller, request))
+}
+#[tauri::command]
+pub fn otools_host_plugin_data_changes(app: AppHandle, webview: Webview, request: ChangesRequest) -> Result<ChangesPage> {
+    let caller = identity::caller(&app, &webview)?;
+    let read = ReadRequest {provider:request.provider.unwrap_or_else(|| caller.clone()),resource_type:request.resource_type};
+    policy::authorize_read(&identity::participants(&app)?, &caller, &read)?;
+    service::with_store(&app, |store| store.changes(&caller, &read, &request.after, request.limit))
+}
+#[tauri::command]
+pub async fn otools_host_plugin_data_request_access(app: AppHandle, webview: Webview, request: RequestAccessRequest) -> Result<AccessStatus> {
+    let caller = identity::caller(&app, &webview)?;
+    tauri::async_runtime::spawn_blocking(move || service::request_access(&app, caller, request))
+        .await.map_err(|_| service::unavailable())?
+}
+#[tauri::command]
+pub fn otools_host_plugin_data_revoke_access(app: AppHandle, webview: Webview, request: ReadRequest) -> Result<()> {
+    let caller = identity::caller(&app, &webview)?;
+    // Revocation needs no enabled provider/declaration; removing a manifest should not
+    // prevent a consumer withdrawing its existing grant. The consumer cannot be supplied.
+    service::with_store(&app, |store| store.revoke(&caller, &request.provider, &request.resource_type))
+}
+#[tauri::command]
+pub fn otools_host_plugin_data_consent_read(app: AppHandle, webview: Webview, request: ConsentReadRequest) -> Result<AccessRequest> {
+    service::read_consent(&app, &webview, &request.token)
+}
+#[tauri::command]
+pub fn otools_host_plugin_data_consent_decide(app: AppHandle, webview: Webview, request: ConsentDecisionRequest) -> Result<()> {
+    service::decide_consent(&app, &webview, &request.token, request.decision)
+}
