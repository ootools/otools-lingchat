+            model: Some("model-b".into()),
+            reasoning_effort: None
+        }
+    );
+    assert_eq!(
+        preference
+            .for_request(&request(Some("model-a"), Some("high")), "model-b")
+            .reasoning_effort,
+        Some("high".into())
+    );
+}
+#[test]
+fn rejects_oversized_or_whitespace_preferences_before_storage() {
+    let dir = tempfile::tempdir().unwrap();
+    let own = owner("market", "pet");
