+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { createApp, nextTick } from 'vue'
+import { useNotes } from './useNotes'
+import { createNotesStore } from './notes'
+import { MemoryNotesHost } from './notesTestHost'
+
+const bridge = vi.hoisted(() => ({ tauri: false, close: vi.fn(async () => {}), positioned: vi.fn(async () => {}), monitorWait: undefined as Promise<unknown[]> | undefined }))
+vi.mock('@tauri-apps/api/core', () => ({ isTauri: () => bridge.tauri }))
+vi.mock('@tauri-apps/api/window', () => ({ getCurrentWindow: () => ({
+  label: 'notes', close: bridge.close, setAlwaysOnTop: async () => {}, setSize: async () => {},
+  setPosition: bridge.positioned, center: bridge.positioned, scaleFactor: async () => 1,
+  onMoved: async () => () => {}, onResized: async () => () => {},
+}), availableMonitors: () => bridge.monitorWait ?? Promise.resolve([]) }))
+vi.mock('@tauri-apps/api/event', () => ({ listen: async () => () => {} }))
+vi.mock('@tauri-apps/api/webviewWindow', () => ({ WebviewWindow: class {} }))
+
+const apps: ReturnType<typeof createApp>[] = []
+function mount() {
+  let state!: ReturnType<typeof useNotes>
+  const app = createApp({ setup() { state = useNotes(); return () => null } })
+  const el = document.createElement('div'); document.body.append(el); app.mount(el); apps.push(app)
+  return state
+}
+async function settle() { for (let i = 0; i < 50; i++) await Promise.resolve(); await nextTick() }
+function deferred() { let resolve!: () => void; const promise = new Promise<void>(done => { resolve = done }); return { promise, resolve } }
+let host: MemoryNotesHost
+beforeEach(() => {
+  localStorage.clear(); bridge.tauri = false; bridge.monitorWait = undefined; bridge.close.mockClear(); bridge.positioned.mockClear()
+  host = new MemoryNotesHost()
+  Object.assign(window, { otools: { data: host } })
+})
+afterEach(() => { apps.splice(0).forEach(app => app.unmount()); document.body.innerHTML = ''; Reflect.deleteProperty(window, 'otools'); vi.useRealTimers() })
+
+describe('host Notes editor', () => {
+  it('migrates on startup and saves to the injected host without changing the local backup', async () => {
+    const legacy = createNotesStore(localStorage); legacy.create('main'); legacy.patch('main', { body: 'Legacy' })
+    const backup = localStorage.getItem('otools-notes:v1:main')
+    const state = mount(); await settle()
+    expect(state.note.value?.body).toBe('Legacy')
+    state.update({ body: 'Host edit' }); await settle()
+    expect((await host.get({ type: 'notes.v1', id: 'main' }))?.data).toMatchObject({ body: 'Host edit' })
+    expect(localStorage.getItem('otools-notes:v1:main')).toBe(backup)
+  })
+
+  it('keeps newer typing visible while an earlier save is pending and waits before closing', async () => {
+    const state = mount(); await settle()
+    const gate = deferred(); host.beforeWrite = () => gate.promise
+    state.update({ body: 'First' }); await settle()
+    state.update({ body: 'Second' })
+    expect(state.note.value?.body).toBe('Second')
+    const closing = state.close(); await settle()
+    expect(bridge.close).not.toHaveBeenCalled()
+    gate.resolve(); await closing; await settle()
+    expect((await host.get({ type: 'notes.v1', id: 'main' }))?.data).toMatchObject({ body: 'Second' })
+    expect(bridge.close).toHaveBeenCalledOnce()
+  })
+
+  it('flushes typing that arrives while the previous save refreshes the list', async () => {
+    const state = mount(); await settle()
+    const gate = deferred(); host.beforeList = () => gate.promise
+    state.update({ body: 'First' }); await settle()
+    state.update({ body: 'During refresh' })
+    const closing = state.close(); await settle()
+    expect(bridge.close).not.toHaveBeenCalled()
+    gate.resolve(); await closing; await settle()
+    expect((await host.get({ type: 'notes.v1', id: 'main' }))?.data).toMatchObject({ body: 'During refresh' })
+  })
+
+  it('retains failed edits for retry without closing or updating the browser backup', async () => {
+    const state = mount(); await settle()
+    host.failId = 'main'; state.update({ body: 'Unsaved' }); await settle()
+    expect(state.saveFailed.value).toBe(true)
+    expect(state.note.value?.body).toBe('Unsaved')
+    await state.close(); expect(bridge.close).not.toHaveBeenCalled()
+    host.failId = undefined; await state.retry(); await settle()
+    expect(state.saveFailed.value).toBe(false)
+    expect((await host.get({ type: 'notes.v1', id: 'main' }))?.data).toMatchObject({ body: 'Unsaved' })
+    expect(localStorage.getItem('otools-notes:v1:main')).toBeNull()
+  })
+
+  it('polls other windows and stops accepting edits after an external delete', async () => {
+    vi.useFakeTimers()
+    const a = mount(); const b = mount(); await settle()
+    a.update({ body: 'Remote edit' }); await settle()
+    await vi.advanceTimersByTimeAsync(1500); await settle()
+    expect(b.note.value?.body).toBe('Remote edit')
+    await a.remove(); await vi.advanceTimersByTimeAsync(1500); await settle()
+    expect(b.closed.value).toBe(true)
+    b.update({ width: 999 }); await settle()
+    expect(await host.get({ type: 'notes.v1', id: 'main' })).toMatchObject({ deleted: true })
+  })
+
+  it('rebases queued todo operations across two live editors', async () => {
+    const a = mount(); const b = mount(); await settle()
+    a.addTodo('First'); b.addTodo('Second'); await settle()
+    const resource = await host.get({ type: 'notes.v1', id: 'main' })
+    expect((resource?.data as { todos: { text: string }[] }).todos.map(todo => todo.text).sort()).toEqual(['First', 'Second'])
+  })
+
+  it('does not replace a committed edit with a poll started during its save', async () => {
+    vi.useFakeTimers()
+    const state = mount(); await settle()
+    const write = deferred(); host.beforeWrite = () => write.promise
+    state.update({ body: 'Committed' }); await settle()
+    const poll = deferred()
+    let lists = 0
+    host.beforeList = () => ++lists === 1 ? poll.promise : Promise.resolve()
+    await vi.advanceTimersByTimeAsync(1000); await settle()
+    write.resolve(); await settle()
+    poll.resolve(); await settle()
+    expect(state.note.value?.body).toBe('Committed')
+  })
+
+  it('stops background polling and ignores native restore callbacks after unmount', async () => {
+    vi.useFakeTimers(); bridge.tauri = true
+    const gate = deferred(); bridge.monitorWait = gate.promise.then(() => [])
+    mount(); await settle()
+    apps.splice(0).forEach(app => app.unmount())
+    let reads = 0; host.beforeList = async () => { reads++ }
+    gate.resolve(); await settle(); await vi.advanceTimersByTimeAsync(2000)
+    expect(bridge.positioned).not.toHaveBeenCalled()
+    expect(reads).toBe(0)
+  })
+
+  it('does not automatically reopen a tombstone on remount', async () => {
+    const a = mount(); await settle(); await a.remove()
+    const b = mount(); await settle()
+    expect(b.closed.value).toBe(true)
+    expect(await host.get({ type: 'notes.v1', id: 'main' })).toMatchObject({ deleted: true })
+    await b.reopen(); await settle()
+    expect(b.closed.value).toBe(false)
+    expect(b.note.value?.body).toBe('')
+  })
+
+  it('stops pending geometry restoration if another window deleted the note', async () => {
+    bridge.tauri = true
+    const gate = deferred(); bridge.monitorWait = gate.promise.then(() => [])
+    mount(); await settle()
+    const resource = await host.get({ type: 'notes.v1', id: 'main' })
+    expect(resource).not.toBeNull()
+    await host.remove({ type: 'notes.v1', id: 'main', expectedRevision: resource!.revision })
+    gate.resolve(); await settle()
+    expect(bridge.positioned).not.toHaveBeenCalled()
+  })
+
+  it('fails visibly when a host runtime has no data API, without silently switching to preview', async () => {
+    bridge.tauri = true; Object.assign(window, { otools: {} })
+    const state = mount(); await settle()
+    expect(state.saveFailed.value).toBe(true)
+    expect(state.note.value).toBeNull()
+    expect(localStorage.getItem('otools-notes:v1:main')).toBeNull()
+  })
+})
