diff --git a/src-tauri/src/platform/observation/safety.rs b/src-tauri/src/platform/observation/safety.rs
new file mode 100644
index 00000000..6da5cdf4
--- /dev/null
+++ b/src-tauri/src/platform/observation/safety.rs
@@ -0,0 +1,144 @@
+//! Native session metadata only: never executes commands or reads screen content.
+#[cfg(target_os = "macos")]
+mod native {
+    use std::{
+        ffi::{c_char, c_void},
+        sync::{
+            atomic::{AtomicU64, Ordering},
+            Once,
+        },
+    };
+    type Cf = *const c_void;
+    #[repr(C)]
+    struct Timebase {
+        numer: u32,
+        denom: u32,
+    }
+    #[link(name = "CoreGraphics", kind = "framework")]
+    extern "C" {
+        fn CGSessionCopyCurrentDictionary() -> Cf;
+    }
+    #[link(name = "CoreFoundation", kind = "framework")]
+    extern "C" {
+        fn CFStringCreateWithCString(allocator: Cf, text: *const c_char, encoding: u32) -> Cf;
+        fn CFDictionaryGetValue(dictionary: Cf, key: Cf) -> Cf;
+        fn CFBooleanGetValue(value: Cf) -> bool;
+        fn CFBooleanGetTypeID() -> usize;
+        fn CFGetTypeID(value: Cf) -> usize;
+        fn CFRelease(value: Cf);
+        fn CFNotificationCenterGetDistributedCenter() -> Cf;
+        fn CFNotificationCenterAddObserver(
+            center: Cf,
+            observer: Cf,
+            callback: extern "C" fn(Cf, Cf, Cf, Cf, Cf),
+            name: Cf,
+            object: Cf,
+            behavior: usize,
+        );
+    }
+    extern "C" {
+        fn mach_continuous_time() -> u64;
+        fn mach_absolute_time() -> u64;
+        fn mach_timebase_info(info: *mut Timebase) -> i32;
+    }
+    static EPOCH: AtomicU64 = AtomicU64::new(0);
+    static INSTALL: Once = Once::new();
+    extern "C" fn invalidated(_: Cf, _: Cf, _: Cf, _: Cf, _: Cf) {
+        EPOCH.fetch_add(1, Ordering::AcqRel);
+    }
+    unsafe fn string(value: &'static [u8]) -> Cf {
+        CFStringCreateWithCString(std::ptr::null(), value.as_ptr().cast(), 0x08000100)
+    }
+    unsafe fn boolean(dict: Cf, name: &'static [u8]) -> Result<Option<bool>, &'static str> {
+        let key = string(name);
+        if key.is_null() {
+            return Err("unsupported");
+        }
+        let value = CFDictionaryGetValue(dict, key);
+        CFRelease(key);
+        if value.is_null() {
+            return Ok(None);
+        }
+        if CFGetTypeID(value) != CFBooleanGetTypeID() {
+            return Err("unsupported");
+        }
+        Ok(Some(CFBooleanGetValue(value)))
+    }
+    pub fn sample() -> Result<(u64, u64, u64), &'static str> {
+        INSTALL.call_once(|| unsafe {
+            let center = CFNotificationCenterGetDistributedCenter();
+            if center.is_null() {
+                return;
+            }
+            for name in [
+                b"com.apple.screenIsLocked\0".as_slice(),
+                b"com.apple.sessionDidMoveOffConsole\0".as_slice(),
+            ] {
+                let key = string(name);
+                if !key.is_null() {
+                    CFNotificationCenterAddObserver(
+                        center,
+                        &EPOCH as *const _ as Cf,
+                        invalidated,
+                        key,
+                        std::ptr::null(),
+                        4,
+                    );
+                    CFRelease(key);
+                }
+            }
+        });
+        unsafe {
+            let dict = CGSessionCopyCurrentDictionary();
+            if dict.is_null() {
+                return Err("sessionUnavailable");
+            }
+            let safe: Result<bool, &'static str> = (|| {
+                // The lock key is absent in an unlocked session on supported macOS.
+                // Unknown value types fail closed; no current console/login also denies.
+                Ok(boolean(dict, b"kCGSSessionOnConsoleKey\0")? == Some(true)
+                    && boolean(dict, b"kCGSessionLoginDoneKey\0")? == Some(true)
+                    && boolean(dict, b"CGSSessionScreenIsLocked\0")? != Some(true))
+            })();
+            CFRelease(dict);
+            if !safe? {
+                return Err("screenLocked");
+            }
+            let mut base = Timebase { numer: 0, denom: 0 };
+            if mach_timebase_info(&mut base) != 0 || base.denom == 0 {
+                return Err("unsupported");
+            }
+            let millis = |ticks: u64| {
+                ((ticks as u128 * base.numer as u128) / base.denom as u128 / 1_000_000) as u64
+            };
+            Ok((
+                millis(mach_continuous_time()),
+                millis(mach_absolute_time()),
+                EPOCH.load(Ordering::Acquire),
+            ))
+        }
+    }
+}
+pub fn sample() -> Result<(u64, u64, u64), &'static str> {
+    #[cfg(target_os = "macos")]
+    {
+        native::sample()
+    }
+    #[cfg(not(target_os = "macos"))]
+    {
+        Err("unsupported")
+    }
+}
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn native_session_probe_is_available_without_capturing() {
+        #[cfg(target_os = "macos")]
+        assert!(matches!(
+            super::sample(),
+            Ok(_) | Err("screenLocked") | Err("sessionUnavailable")
+        ));
+        #[cfg(not(target_os = "macos"))]
+        assert_eq!(super::sample(), Err("unsupported"));
+    }
+}
diff --git a/src-tauri/src/platform/observation/service.rs b/src-tauri/src/platform/observation/service.rs
new file mode 100644
index 00000000..aac5ce56
--- /dev/null
+++ b/src-tauri/src/platform/observation/service.rs
@@ -0,0 +1,398 @@
+//! Host-owned opt-in sessions. The supervisor only checks safety; it never captures.
+use super::{
+    core::{self, Owner, Phase, SafetyClock, Session},
+    identity, safety,
+    types::*,
+    windows,
+};
+use crate::platform::capture::{service as capture, types::CaptureResult};
+use std::{
+    collections::HashMap,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Mutex, MutexGuard, OnceLock,
+    },
+    time::{Duration, Instant},
+};
+use tauri::{AppHandle, Manager};
+struct Entry {
+    session: Session,
+    target: Target,
+    clock: SafetyClock,
+    safety_epoch: u64,
+    image: Option<String>,
+    stopped_at: Option<u64>,
+    activated_at: Option<u64>,
+}
+#[derive(Default)]
+struct State {
+    sessions: HashMap<String, Entry>,
+}
+static STATE: OnceLock<Mutex<State>> = OnceLock::new();
+static RUNNING: AtomicBool = AtomicBool::new(false);
+static SHUTDOWN: AtomicBool = AtomicBool::new(false);
+fn state() -> Result<MutexGuard<'static, State>, Error> {
+    STATE
+        .get_or_init(|| Mutex::new(State::default()))
+        .lock()
+        .map_err(|_| error("stopped"))
+}
+fn now() -> u64 {
+    static START: OnceLock<Instant> = OnceLock::new();
+    START.get_or_init(Instant::now).elapsed().as_millis() as u64
+}
+fn entry<'a>(state: &'a mut State, id: &str) -> Result<&'a mut Entry, Error> {
+    state.sessions.get_mut(id).ok_or_else(|| error("notFound"))
+}
+pub fn status_internal(id: &str) -> Result<Status, Error> {
+    let mut state = state()?;
+    let entry = entry(&mut state, id)?;
+    Ok(Status::from(&entry.session, &entry.target))
+}
+pub fn status(app: &AppHandle, owner: &Owner, id: &str) -> Result<Status, Error> {
+    {
+        let mut state = state()?;
+        entry(&mut state, id)?
+            .session
+            .authorize(owner)
+            .map_err(error)?;
+    }
+    check(app, id);
+    status_internal(id)
+}
+fn initialize(app: &AppHandle) -> Result<(), Error> {
+    if SHUTDOWN.load(Ordering::Acquire) {
+        return Err(error("stopped"));
+    }
+    if RUNNING
+        .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+        .is_err()
+    {
+        return Ok(());
+    }
+    let app = app.clone();
+    std::thread::Builder::new()
+        .name("otools-observation-safety".into())
+        .spawn(move || {
+            while !SHUTDOWN.load(Ordering::Acquire) {
+                std::thread::sleep(Duration::from_millis(200));
+                let ids = state()
+                    .map(|s| s.sessions.keys().cloned().collect::<Vec<_>>())
+                    .unwrap_or_default();
+                for id in ids {
+                    check(&app, &id);
+                }
+                if let Ok(mut s) = state() {
+                    s.sessions.retain(|_, e| {
+                        e.session.in_flight
+                            || e.stopped_at
+                                .is_none_or(|t| now().saturating_sub(t) < 120_000)
+                    });
+                }
+            }
+        })
+        .map_err(|_| {
+            RUNNING.store(false, Ordering::Release);
+            error("unsupported")
+        })?;
+    Ok(())
+}
+pub fn request(app: &AppHandle, owner: Owner, options: Request) -> Result<Status, Error> {
+    options.target.validate()?;
+    let (continuous, awake, epoch) = safety::sample().map_err(error)?;
+    initialize(app)?;
+    let id = uuid::Uuid::new_v4().to_string();
+    let session = Session::new(id.clone(), owner, options.interval_ms, now()).map_err(error)?;
+    let target = options.target;
+    // Verify target exists with metadata only, before presenting consent.
+    super::targets::validate(&target)?;
+    {
+        let mut s = state()?;
+        if s.sessions
+            .values()
+            .any(|e| e.session.phase != Phase::Stopped || e.session.in_flight)
+            || s.sessions.len() >= 32
+        {
+            return Err(error("busy"));
+        }
+        let mut clock = SafetyClock::default();
+        clock.sample(continuous, awake);
+        s.sessions.insert(
+            id.clone(),
+            Entry {
+                session,
+                target,
+                clock,
+                safety_epoch: epoch,
+                image: None,
+                stopped_at: None,
+                activated_at: None,
+            },
+        );
+    }
+    if let Err(e) = windows::open(app, &id) {
+        stop_internal(app, &id, "indicatorUnavailable");
+        return Err(e);
+    }
+    status_internal(&id)
+}
+pub fn surface(app: &AppHandle, id: &str) -> Result<Surface, Error> {
+    check(app, id);
+    let mut s = state()?;
+    let e = entry(&mut s, id)?;
+    let plugin_name = app
+        .try_state::<crate::platform::plugins::ToolPluginsAppState>()
+        .and_then(|s| s.snapshot().ok())
+        .and_then(|plugins| {
+            plugins
+                .into_iter()
+                .find(|p| p.uuid.eq_ignore_ascii_case(&e.session.owner.uuid))
+        })
+        .map(|p| p.display_name)
+        .unwrap_or_else(|| e.session.owner.uuid.clone());
+    Ok(Surface {
+        status: Status::from(&e.session, &e.target),
+        plugin_name,
+        plugin_uuid: e.session.owner.uuid.clone(),
+        source: e.session.owner.source.clone(),
+        permission_granted: capture::permission_status()?.granted,
+    })
+}
+pub fn heartbeat(app: &AppHandle, id: &str) -> Result<Status, Error> {
+    check(app, id);
+    let visible = windows::visible(app, id);
+    let result = {
+        let mut s = state()?;
+        entry(&mut s, id)?
+            .session
+            .heartbeat(now(), visible)
+            .map_err(error)
+    };
+    if result.is_err() {
+        stop_internal(app, id, "indicatorUnavailable");
+    }
+    result?;
+    status_internal(id)
+}
+pub fn permission(app: &AppHandle, id: &str) -> Result<bool, Error> {
+    if status_internal(id)?.state != "pending" || !windows::visible(app, id) {
+        return Err(error("stopped"));
+    }
+    Ok(capture::request_permission()?.granted)
+}
+pub fn approve(app: &AppHandle, id: &str) -> Result<Status, Error> {
+    check(app, id);
+    if !windows::visible(app, id) {
+        stop_internal(app, id, "indicatorUnavailable");
+        return Err(error("indicatorUnavailable"));
+    }
+    let permission = capture::permission_status()?.granted;
+    {
+        let mut s = state()?;
+        let e = entry(&mut s, id)?;
+        e.session.approve(now(), permission).map_err(error)?;
+        e.activated_at = Some(now());
+    }
+    status_internal(id)
+}
+/// Safety failures revoke the session; no automatic resume after unlock/wake.
+fn check(app: &AppHandle, id: &str) {
+    let snapshot = state().ok().and_then(|s| {
+        s.sessions.get(id).map(|e| {
+            (
+                e.session.owner.clone(),
+                e.session.phase,
+                e.session.created_at,
+                e.session.heartbeat_at,
+                e.activated_at,
+                e.session.in_flight,
+            )
+        })
+    });
+    let Some((owner, phase, created, heartbeat, activated, in_flight)) = snapshot else {
+        return;
+    };
+    if phase == Phase::Stopped {
+        if in_flight {
+            cancel_capture(app, &owner);
+        }
+        return;
+    }
+    let reason = if SHUTDOWN.load(Ordering::Acquire) {
+        Some("shutdown")
+    } else if !identity::live(app, &owner) {
+        Some("ownerUnavailable")
+    } else if !windows::owner_visible(app, &owner) {
+        Some("ownerHidden")
+    } else if (phase == Phase::Active || now().saturating_sub(created) > 5_000)
+        && !windows::visible(app, id)
+    {
+        Some("indicatorUnavailable")
+    } else if phase == Phase::Pending && now().saturating_sub(created) > core::PENDING_MS {
+        Some("expired")
+    } else if phase == Phase::Active
+        && now().saturating_sub(heartbeat.or(activated).unwrap_or(0)) > core::HEARTBEAT_MS
+    {
+        Some("indicatorUnavailable")
+    } else if phase == Phase::Active && !capture::permission_status().is_ok_and(|p| p.granted) {
+        Some("permissionDenied")
+    } else {
+        match safety::sample() {
+            Err(reason) => Some(reason),
+            Ok((continuous, awake, epoch)) => state().ok().and_then(|mut s| {
+                let e = s.sessions.get_mut(id)?;
+                (!e.clock.sample(continuous, awake) || e.safety_epoch != epoch)
+                    .then_some("safetyInterrupted")
+            }),
+        }
+    };
+    if let Some(reason) = reason {
+        stop_internal(app, id, reason);
+    }
+}
+fn cancel_capture(app: &AppHandle, owner: &Owner) {
+    // cancel validates exact capture owner; never cancel another caller's session.
+    if let Some(id) = capture::active_session_id() {
+        let _ = capture::cancel(app, &identity::capture_owner(owner), &id);
+    }
+}
+pub fn capture_image(app: &AppHandle, owner: &Owner, id: &str) -> Result<CaptureImage, Error> {
+    {
+        let mut s = state()?;
+        entry(&mut s, id)?.session.authorize(owner).map_err(error)?;
+    }
+    check(app, id);
+    if !windows::visible(app, id) {
+        stop_internal(app, id, "indicatorUnavailable");
+        return Err(error("indicatorUnavailable"));
+    }
+    let (target, previous, cancelled) = {
+        let mut s = state()?;
+        let e = entry(&mut s, id)?;
+        e.session.begin_capture(owner, now()).map_err(error)?;
+        (e.target.clone(), e.image.take(), e.session.cancel.clone())
+    };
+    let capture_owner = identity::capture_owner(owner);
+    if let Some(image) = previous {
+        let _ = capture::release(&capture_owner, &image);
+    }
+    let result = if cancelled.load(Ordering::Acquire) {
+        Err(error("stopped"))
+    } else {
+        capture::direct(
+            app.clone(),
+            capture_owner.clone(),
+            target.capture_target(),
+            false,
+        )
+    };
+    check(app, id);
+    let image = match result {
+        Ok(CaptureResult::Completed { image, .. }) => Some(image),
+        Ok(_) => None,
+        Err(e) => {
+            if let Ok(mut s) = state() {
+                if let Some(e) = s.sessions.get_mut(id) {
+                    e.session.finish_capture();
+                }
+            }
+            return Err(e);
+        }
+    };
+    let Some(image) = image else {
+        if let Ok(mut s) = state() {
+            if let Some(e) = s.sessions.get_mut(id) {
+                e.session.finish_capture();
+            }
+        }
+        return Err(error("stopped"));
+    };
+    // Validate ownership through the existing artifact store before delivery.
+    let owned = capture::image_bytes(&capture_owner, &image.image_id).is_ok();
+    let accepted = state()
+        .ok()
+        .and_then(|mut s| {
+            let e = s.sessions.get_mut(id)?;
+            let active = e.session.finish_capture();
+            if active && owned {
+                e.image = Some(image.image_id.clone());
+                Some(true)
+            } else {
+                None
+            }
+        })
+        .unwrap_or(false);
+    if !accepted {
+        let _ = capture::release(&capture_owner, &image.image_id);
+        return Err(error("stopped"));
+    }
+    Ok(image)
+}
+pub fn stop(app: &AppHandle, owner: &Owner, id: &str) -> Result<(), Error> {
+    {
+        let mut s = state()?;
+        entry(&mut s, id)?.session.authorize(owner).map_err(error)?;
+    }
+    stop_internal(app, id, "stopped");
+    Ok(())
+}
+pub fn stop_from_indicator(app: &AppHandle, id: &str) {
+    stop_internal(app, id, "userStopped");
+}
+fn stop_internal(app: &AppHandle, id: &str, reason: &'static str) {
+    let stopped = state().ok().and_then(|mut s| {
+        let e = s.sessions.get_mut(id)?;
+        e.session.stop(reason);
+        e.stopped_at.get_or_insert_with(now);
+        Some((e.session.owner.clone(), e.image.take()))
+    });
+    if let Some((owner, image)) = stopped {
+        cancel_capture(app, &owner);
+        // Do not cancel unrelated AI jobs owned by the same window: the plugin
+        // aborts its own observation request, and window destruction removes
+        // every job through handle_window_destroyed.
+        if let Some(image) = image {
+            let _ = capture::release(&identity::capture_owner(&owner), &image);
+        }
+        windows::close(app, id);
+    }
+}
+/// Call for owner/indicator close, destroy, hide, minimize, and explicit pause.
+pub fn handle_window_unavailable(app: &AppHandle, label: &str) {
+    let ids = state()
+        .map(|s| {
+            s.sessions
+                .iter()
+                .filter(|(id, e)| e.session.owner.label == label || windows::label(id) == label)
+                .map(|(id, _)| id.clone())
+                .collect::<Vec<_>>()
+        })
+        .unwrap_or_default();
+    for id in ids {
+        stop_internal(app, &id, "windowUnavailable");
+    }
+}
+/// Call before disabling/removing a plugin, while its runtime identity still exists.
+pub fn stop_plugin(app: &AppHandle, uuid: &str) {
+    let ids = state()
+        .map(|s| {
+            s.sessions
+                .iter()
+                .filter(|(_, e)| e.session.owner.uuid.eq_ignore_ascii_case(uuid))
+                .map(|(id, _)| id.clone())
+                .collect::<Vec<_>>()
+        })
+        .unwrap_or_default();
+    for id in ids {
+        stop_internal(app, &id, "pluginDisabled");
+    }
+}
+pub fn shutdown(app: &AppHandle) {
+    SHUTDOWN.store(true, Ordering::Release);
+    let ids = state()
+        .map(|s| s.sessions.keys().cloned().collect::<Vec<_>>())
+        .unwrap_or_default();
+    for id in ids {
+        stop_internal(app, &id, "shutdown");
+    }
+}
diff --git a/src-tauri/src/platform/observation/targets.rs b/src-tauri/src/platform/observation/targets.rs
new file mode 100644
index 00000000..13be8315
--- /dev/null
+++ b/src-tauri/src/platform/observation/targets.rs
@@ -0,0 +1,66 @@
+//! Metadata-only target discovery; no capture API is called here.
+use super::types::{error, Error, Target};
+use serde::Serialize;
+#[derive(Serialize)]
+pub struct Screen {
+    pub id: String,
+    pub name: String,
+}
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Window {
+    pub id: String,
+    pub title: String,
+    pub app_name: String,
+}
+#[derive(Serialize)]
+pub struct Targets {
+    pub screens: Vec<Screen>,
+    pub windows: Vec<Window>,
+}
+pub fn list() -> Result<Targets, Error> {
+    super::safety::sample().map_err(error)?;
+    #[cfg(target_os = "macos")]
+    {
+        let bounded = |text: String| text.chars().take(512).collect();
+        let screens = xcap::Monitor::all()
+            .map_err(|_| error("unsupported"))?
+            .into_iter()
+            .take(32)
+            .map(|screen| {
+                Ok(Screen {
+                    id: screen.id().map_err(|_| error("unsupported"))?.to_string(),
+                    name: bounded(screen.name().unwrap_or_default()),
+                })
+            })
+            .collect::<Result<Vec<_>, Error>>()?;
+        let windows = xcap::Window::all()
+            .map_err(|_| error("unsupported"))?
+            .into_iter()
+            .take(512)
+            .filter(|w| !w.is_minimized().unwrap_or(true))
+            .map(|window| {
+                Ok(Window {
+                    id: window.id().map_err(|_| error("unsupported"))?.to_string(),
+                    title: bounded(window.title().unwrap_or_default()),
+                    app_name: bounded(window.app_name().unwrap_or_default()),
+                })
+            })
+            .collect::<Result<Vec<_>, Error>>()?;
+        Ok(Targets { screens, windows })
+    }
+    #[cfg(not(target_os = "macos"))]
+    Err(error("unsupported"))
+}
+pub fn validate(target: &Target) -> Result<(), Error> {
+    let targets = list()?;
+    let exists = match target {
+        Target::Screen { display_id } => targets.screens.iter().any(|s| s.id == *display_id),
+        Target::Window { window_id } => targets.windows.iter().any(|w| w.id == *window_id),
+    };
+    if exists {
+        Ok(())
+    } else {
+        Err(error("notFound"))
+    }
+}
diff --git a/src-tauri/src/platform/observation/transport.rs b/src-tauri/src/platform/observation/transport.rs
new file mode 100644
index 00000000..81b37b20
