+++ b/plugins/otools-notes/src/hostNotesStore.ts
@@ -0,0 +1,140 @@
+import { normalizeNote, type Note } from './notes'
+
+type Changes = Partial<Pick<Note, 'title' | 'body' | 'todos' | 'color' | 'alwaysOnTop' | 'width' | 'height' | 'x' | 'y'>>
+export type NotePatch = Changes | ((current: Note) => Changes)
+export interface NoteResource {
+  provider: { source: string; uuid: string }
+  type: string
+  id: string
+  revision: number
+  updatedAt: number
+  deleted: boolean
+  data: unknown
+  privateData?: unknown
+}
+// Owner reads omit provider; the broker derives source + uuid from the caller.
+// Kept narrow so the injected SDK API is structurally compatible.
+export interface NotesDataApi {
+  get(request: { type: string; id: string }): Promise<NoteResource | null>
+  list(request: { type: string; cursor?: string; limit?: number }): Promise<{ items: NoteResource[]; next: string | null; after: string }>
+  put(request: { type: string; id: string; data: unknown; privateData?: unknown; expectedRevision: number; recreate?: boolean }): Promise<NoteResource>
+  remove(request: { type: string; id: string; expectedRevision: number }): Promise<NoteResource>
+}
+export type LegacyStorage = Pick<Storage, 'getItem' | 'setItem' | 'length' | 'key'>
+
+const TYPE = 'notes.v1'
+const PREFIX = 'otools-notes:v1:'
+const record = (value: unknown): Record<string, unknown> =>
+  value !== null && typeof value === 'object' && !Array.isArray(value) ? value as Record<string, unknown> : {}
+const conflict = (error: unknown) => record(error).code === 'conflict'
+
+function fromResource(resource: NoteResource | null): Note | null {
+  if (!resource || resource.deleted) return null
+  const shared = record(resource.data)
+  const layout = record(resource.privateData)
+  return normalizeNote(resource.id, {
+    title: shared.title, body: shared.body, todos: shared.todos,
+    createdAt: shared.createdAt, updatedAt: shared.updatedAt,
+    color: layout.color, alwaysOnTop: layout.alwaysOnTop,
+    width: layout.width, height: layout.height, x: layout.x, y: layout.y,
+  })
+}
+
+function projection(note: Note) {
+  const { title, body, todos, createdAt, updatedAt, color, alwaysOnTop, width, height, x, y } = note
+  return {
+    data: { title, body, todos, createdAt, updatedAt },
+    privateData: { color, alwaysOnTop, width, height, ...(x === undefined ? {} : { x }), ...(y === undefined ? {} : { y }) },
+  }
+}
+
+export function createHostNotesStore(data: NotesDataApi, storage: LegacyStorage) {
+  const get = (id: string) => data.get({ type: TYPE, id })
+  async function retry<T>(operation: () => Promise<T>): Promise<T> {
+    for (let attempt = 0; ; attempt++) {
+      try { return await operation() }
+      catch (error) { if (!conflict(error) || attempt >= 7) throw error }
+    }
+  }
+  return {
+    async initialize(): Promise<void> {
+      // Take a snapshot before awaiting host writes. Keep all legacy source bytes
+      // as backups. Existing resources (including tombstones) are durable import
+      // markers: migration never updates or resurrects an existing host record.
+      const imports: Array<{ id: string; value: Record<string, unknown> }> = []
+      for (let index = 0; index < storage.length; index++) {
+        const key = storage.key(index)
+        if (!key?.startsWith(PREFIX)) continue
+        let id: string
+        let value: Record<string, unknown>
+        try {
+          id = decodeURIComponent(key.slice(PREFIX.length))
+          if (`${PREFIX}${encodeURIComponent(id)}` !== key) continue
+        } catch { continue }
+        const raw = storage.getItem(key)
+        try { value = record(JSON.parse(raw ?? 'null')) } catch { continue }
+        if (value.version === 1 && value.id === id) imports.push({ id, value })
+      }
+      for (const { id, value } of imports) {
+        if (await get(id)) continue
+        try {
+          if (value.deleted === true) await data.remove({ type: TYPE, id, expectedRevision: 0 })
+          else await data.put({ type: TYPE, id, ...projection(normalizeNote(id, value)), expectedRevision: 0 })
+        } catch (error) {
+          // Another window may have migrated or deleted this ID first. Confirm
+          // the durable record before considering a create-only conflict done.
+          if (!conflict(error) || !await get(id)) throw error
+        }
+      }
+    },
+    async load(id: string): Promise<Note | null> { return fromResource(await get(id)) },
+    async list(): Promise<Note[]> {
+      for (let attempt = 0; ; attempt++) {
+        try {
+          const notes: Note[] = []
+          let cursor: string | undefined
+          do {
+            const page = await data.list({ type: TYPE, cursor, limit: 100 })
+            for (const resource of page.items) {
+              const note = fromResource(resource)
+              if (note) notes.push(note)
+            }
+            cursor = page.next ?? undefined
+          } while (cursor)
+          return notes.sort((a, b) => b.updatedAt - a.updatedAt || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0))
+        } catch (error) {
+          if (record(error).code !== 'resyncRequired' || attempt >= 7) throw error
+        }
+      }
+    },
+    async create(id: string, recreate = false): Promise<Note | null> {
+      return retry(async () => {
+        const resource = await get(id)
+        if (resource && (!resource.deleted || !recreate)) return fromResource(resource)
+        const now = Date.now()
+        return fromResource(await data.put({ type: TYPE, id,
+          ...projection(normalizeNote(id, { createdAt: now, updatedAt: now })),
+          expectedRevision: resource?.revision ?? 0,
+          ...(resource?.deleted ? { recreate: true } : {}),
+        }))
+      })
+    },
+    async patch(id: string, changes: NotePatch): Promise<Note | null> {
+      return retry(async () => {
+        const resource = await get(id)
+        const current = fromResource(resource)
+        if (!current || !resource) return null
+        const patch = typeof changes === 'function' ? changes(current) : changes
+        const next = normalizeNote(id, { ...current, ...patch, createdAt: current.createdAt, updatedAt: Date.now() })
+        return fromResource(await data.put({ type: TYPE, id, ...projection(next), expectedRevision: resource.revision }))
+      })
+    },
+    async remove(id: string): Promise<void> {
+      await retry(async () => {
+        const resource = await get(id)
+        if (resource?.deleted) return
+        await data.remove({ type: TYPE, id, expectedRevision: resource?.revision ?? 0 })
+      })
+    },
+  }
+}
