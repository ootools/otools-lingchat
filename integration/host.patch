@@ -0,0 +1,88 @@
+use super::*;
+fn owner() -> Owner {
+    Owner {
+        label: "pet".into(),
+        uuid: "pet".into(),
+        source: "market".into(),
+        url: "otools-plugin://localhost/pet/index.html".into(),
+    }
+}
+fn session() -> Session {
+    Session::new("one".into(), owner(), None, 100).unwrap()
+}
+fn ready() -> Session {
+    let mut s = session();
+    s.approve(200, true).unwrap();
+    s.heartbeat(201, true).unwrap();
+    s
+}
+#[test]
+fn default_off_requires_consent_permission_and_rendered_indicator() {
+    let mut s = session();
+    assert_eq!(s.interval_ms, 60_000);
+    assert_eq!(s.begin_capture(&owner(), 202), Err("consentRequired"));
+    assert_eq!(s.approve(200, false), Err("permissionDenied"));
+    s.approve(200, true).unwrap();
+    assert_eq!(s.begin_capture(&owner(), 202), Err("indicatorUnavailable"));
+    s.heartbeat(203, true).unwrap();
+    assert!(s.begin_capture(&owner(), 204).is_ok());
+}
+#[test]
+fn spacing_is_atomic_and_owner_includes_source_and_actual_window() {
+    let mut s = ready();
+    let mut foreign = owner();
+    foreign.source = "dev-debug".into();
+    assert_eq!(s.begin_capture(&foreign, 202), Err("forbidden"));
+    foreign = owner();
+    foreign.label = "other-pet".into();
+    assert_eq!(s.begin_capture(&foreign, 202), Err("forbidden"));
+    s.begin_capture(&owner(), 202).unwrap();
+    assert_eq!(s.begin_capture(&owner(), 203), Err("busy"));
+    assert!(s.finish_capture());
+    s.heartbeat(500, true).unwrap();
+    assert_eq!(s.begin_capture(&owner(), 501), Err("tooSoon"));
+    s.heartbeat(60_203, true).unwrap();
+    assert!(s.begin_capture(&owner(), 60_203).is_ok());
+}
+#[test]
+fn stopped_and_late_results_never_reactivate() {
+    let mut s = ready();
+    s.begin_capture(&owner(), 202).unwrap();
+    let cancellation = s.cancel.clone();
+    s.stop("ownerClosed");
+    assert!(cancellation.load(std::sync::atomic::Ordering::Acquire));
+    assert!(!s.finish_capture());
+    assert_eq!(s.approve(300, true), Err("stopped"));
+    assert_eq!(s.heartbeat(300, true), Err("stopped"));
+    assert_eq!(s.begin_capture(&owner(), 301), Err("stopped"));
+}
+#[test]
+fn lost_or_stale_indicator_stops_and_requires_new_request() {
+    let mut s = ready();
+    assert_eq!(s.heartbeat(202, false), Err("indicatorUnavailable"));
+    assert_eq!(s.phase, Phase::Stopped);
+    let mut s = ready();
+    assert_eq!(
+        s.begin_capture(&owner(), 4_000),
+        Err("indicatorUnavailable")
+    );
+    assert_eq!(s.phase, Phase::Stopped);
+}
+#[test]
+fn pending_requests_timeout_and_intervals_are_bounded() {
+    assert!(Session::new("id".into(), owner(), Some(29_999), 0).is_err());
+    assert!(Session::new("id".into(), owner(), Some(3_600_001), 0).is_err());
+    let mut s = session();
+    assert_eq!(s.approve(120_101, true), Err("expired"));
+    assert_eq!(s.phase, Phase::Stopped);
+}
+#[test]
+fn safety_gap_and_sleep_clock_drift_fail_closed() {
+    let mut guard = SafetyClock::default();
+    assert!(guard.sample(1_000, 500));
+    assert!(guard.sample(1_500, 1_000));
+    assert!(!guard.sample(2_100, 1_100)); // continuous clock advanced during sleep
+    let mut guard = SafetyClock::default();
+    assert!(guard.sample(1_000, 500));
+    assert!(!guard.sample(4_000, 3_500)); // process/watchdog stopped responding
+}
diff --git a/src-tauri/src/platform/observation/identity.rs b/src-tauri/src/platform/observation/identity.rs
new file mode 100644
index 00000000..2a6e1794
--- /dev/null
+++ b/src-tauri/src/platform/observation/identity.rs
@@ -0,0 +1,103 @@
+use super::{
+    core::Owner,
+    types::{error, Error},
+};
+use crate::platform::webview::{core as runtime, custom};
+use tauri::{AppHandle, Manager, Webview};
+
+pub fn caller(app: &AppHandle, webview: &Webview) -> Result<Owner, Error> {
+    crate::platform::capture::identity::ensure_runtime()?;
+    // The source-qualified custom-window registry is authoritative. A UUID-only
+    // lookup would mix dev and market installations or permit cross-source calls.
+    let plugin = custom::caller_plugin(app, webview, None, None).map_err(|_| error("forbidden"))?;
+    if !plugin.enabled || !plugin.screen_capture.unwrap_or(false) {
+        return Err(error("permissionDenied"));
+    }
+    let source = custom::source(&plugin);
+    let url = webview.url().map_err(|_| error("forbidden"))?;
+    let root = custom::protocol_root(webview.label(), &plugin.uuid);
+    let allowed = if url.scheme() == "otools-plugin" {
+        root.is_some() && protocol_url(&url, &plugin.uuid)
+    } else if url.scheme() == "file" {
+        root.as_ref()
+            .and_then(|root| {
+                let root = root.canonicalize().ok()?;
+                let file = url.to_file_path().ok()?.canonicalize().ok()?;
+                Some(file.starts_with(root))
+            })
+            .unwrap_or(false)
+    } else if cfg!(debug_assertions) && plugin.quick_dev.unwrap_or(false) {
+        app.config()
+            .build
+            .dev_url
+            .as_ref()
+            .is_some_and(|dev| url.origin() == dev.origin())
+            && url
+                .query_pairs()
+                .any(|(key, value)| key == "plugin" && value == plugin.packid)
+    } else {
+        let entry = if source == "dev-debug" {
+            plugin.dev_url.as_deref().unwrap_or(&plugin.entry)
+        } else {
+            &plugin.entry
+        };
+        tauri::Url::parse(entry).is_ok_and(|entry| {
+            matches!(entry.scheme(), "http" | "https") && url.origin() == entry.origin()
+        })
+    };
+    if !allowed {
+        return Err(error("forbidden"));
+    }
+    Ok(Owner {
+        label: webview.label().into(),
+        uuid: plugin.uuid,
+        source,
+        url: url.to_string(),
+    })
+}
+fn protocol_url(url: &tauri::Url, uuid: &str) -> bool {
+    url.scheme() == "otools-plugin"
+        && url.host_str() == Some("localhost")
+        && url.path_segments().and_then(|mut p| p.next()) == Some(uuid)
+}
+pub fn live(app: &AppHandle, owner: &Owner) -> bool {
+    app.get_webview(&owner.label)
+        .is_some_and(|view| caller(app, &view).is_ok_and(|actual| actual == *owner))
+}
+pub fn capture_owner(owner: &Owner) -> crate::platform::capture::types::CaptureOwner {
+    crate::platform::capture::types::CaptureOwner {
+        label: owner.label.clone(),
+        plugin_uuid: Some(owner.uuid.clone()),
+    }
+}
+pub fn indicator(app: &AppHandle, view: &Webview, id: &str) -> Result<(), Error> {
+    if view.label() != super::windows::label(id)
+        || runtime::plugin_for_runtime_binding(view.label()).is_some()
+    {
+        return Err(error("forbidden"));
+    }
+    let url = view.url().map_err(|_| error("forbidden"))?;
+    if !super::windows::trusted_url(app, &url, id) {
+        return Err(error("forbidden"));
+    }
+    super::service::status_internal(id)?;
+    Ok(())
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn protocol_binding_rejects_another_plugin_and_allows_custom_queries() {
+        for url in [
+            "otools-plugin://localhost/evil/index.html",
+            "https://localhost/pet/index.html",
+            "otools-plugin://elsewhere/pet/index.html",
+        ] {
+            assert!(!protocol_url(&tauri::Url::parse(url).unwrap(), "pet"));
+        }
+        assert!(protocol_url(
+            &tauri::Url::parse("otools-plugin://localhost/pet/child.html?window=two").unwrap(),
+            "pet"
+        ));
+    }
+}
