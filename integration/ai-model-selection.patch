+    );
+    assert_eq!(
+        AiSelection {
+            model: Some("model-b".into()),
+            reasoning_effort: Some("high".into())
+        }
+        .validate("model-a", &models)
+        .unwrap_err(),
+        "unsupportedReasoningEffort"
+    );
+    assert_eq!(
+        AiSelection::default()
+            .for_request(&request(None, None), "model-a")
+            .reasoning_effort,
+        None
+    );
+}
+#[test]
+fn different_request_model_drops_saved_effort_without_affecting_saved_preference() {
+    let preference = AiSelection {
+        model: Some("model-a".into()),
+        reasoning_effort: Some("ultra".into()),
