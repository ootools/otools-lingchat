@@ -0,0 +1,41 @@
+use super::{
+    service,
+    types::{ConfigureRequest, ReminderItem, ReminderStatus},
+};
+use ot_plugin_data::Result;
+use tauri::{AppHandle, Webview};
+
+#[tauri::command]
+pub fn otools_host_plugin_reminders_configure(
+    app: AppHandle,
+    webview: Webview,
+    request: ConfigureRequest,
+) -> Result<ReminderStatus> {
+    let owner = crate::platform::plugin_data::identity::caller(&app, &webview)?;
+    service::configure(&app, owner, request)
+}
+#[tauri::command]
+pub fn otools_host_plugin_reminders_status(
+    app: AppHandle,
+    webview: Webview,
+) -> Result<Vec<ReminderStatus>> {
+    let owner = crate::platform::plugin_data::identity::caller(&app, &webview)?;
+    service::status(&app, &owner)
+}
+#[tauri::command]
+pub fn otools_host_plugin_reminders_pending(
+    app: AppHandle,
+    webview: Webview,
+) -> Result<Vec<ReminderItem>> {
+    let owner = crate::platform::plugin_data::identity::caller(&app, &webview)?;
+    service::pending(&app, &owner)
+}
+#[tauri::command]
+pub fn otools_host_plugin_reminders_acknowledge(
+    app: AppHandle,
+    webview: Webview,
+    ids: Vec<String>,
+) -> Result<()> {
+    let owner = crate::platform::plugin_data::identity::caller(&app, &webview)?;
+    service::acknowledge(&app, &owner, &ids)
+}
diff --git a/src-tauri/src/platform/plugin_reminders/types.rs b/src-tauri/src/platform/plugin_reminders/types.rs
new file mode 100644
index 00000000..153b35bd
--- /dev/null
+++ b/src-tauri/src/platform/plugin_reminders/types.rs
@@ -0,0 +1,115 @@
+use ot_plugin_data::{Error, Identity, ReadRequest};
+use serde::{Deserialize, Serialize};
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct QuietHours {
+    pub start: u16,
+    pub end: u16,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ConfigureRequest {
+    pub provider: Identity,
+    #[serde(rename = "type")]
+    pub resource_type: String,
+    pub enabled: bool,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub quiet_hours: Option<QuietHours>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub cooldown_ms: Option<u64>,
+}
+impl ConfigureRequest {
+    pub fn read_request(&self) -> ReadRequest {
+        ReadRequest {
+            provider: self.provider.clone(),
+            resource_type: self.resource_type.clone(),
+        }
+    }
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Receipt {
+    pub id: String,
+    pub due_at: u64,
+    pub delivered_at: u64,
+    pub acknowledged: bool,
+    pub notified: bool,
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Watch {
+    pub owner: Identity,
+    pub config: ConfigureRequest,
+    pub eligible_since: u64,
+    pub last_delivered_at: Option<u64>,
+    pub receipts: Vec<Receipt>,
+}
+impl Watch {
+    pub fn new(owner: Identity, config: ConfigureRequest, now: u64) -> Result<Self, Error> {
+        super::policy::validate(&config)?;
+        let mut config = config;
+        config.cooldown_ms = Some(
+            config
+                .cooldown_ms
+                .unwrap_or(super::policy::DEFAULT_COOLDOWN_MS),
+        );
+        Ok(Self {
+            owner,
+            config,
+            eligible_since: super::policy::initial_cutoff(now),
+            last_delivered_at: None,
+            receipts: Vec::new(),
+        })
+    }
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Stored {
+    pub version: u32,
+    pub watches: Vec<Watch>,
+}
+impl Default for Stored {
+    fn default() -> Self {
+        Self {
+            version: 1,
+            watches: vec![],
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct Candidate {
