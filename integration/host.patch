@@ -0,0 +1,45 @@
+<script setup lang="ts">
+import { computed } from 'vue';
+import type { Decision, ViewState } from './controller';
+import GrantDetails from './GrantDetails.vue';
+import { labels } from './labels';
+const props = defineProps<{ state: ViewState; locale: string }>();
+const emit = defineEmits<{ decide: [decision: Decision]; confirm: [index?: number]; revoke: [index: number]; refresh: []; close: [] }>();
+const text = computed(() => labels(props.locale));
+const status = computed(() => {
+  if (props.state.phase === 'expired') return text.value.expired;
+  if (props.state.phase === 'error') return text.value.error;
+  if (props.state.phase === 'complete') return props.state.decision === 'deny' ? text.value.denied : text.value.complete;
+  if (props.state.phase === 'loading' || props.state.phase === 'busy') return text.value.loading;
+  return '';
+});
+</script>
+<template>
+  <main :dir="locale.startsWith('ar') ? 'rtl' : 'ltr'" :aria-busy="state.phase === 'busy' || state.phase === 'loading'">
+    <header><span class="brand">OTools</span><h1>{{ state.mode === 'management' ? text.management : text.title }}</h1></header>
+    <p v-if="status" class="status" :class="state.phase" :role="state.phase === 'error' ? 'alert' : 'status'">{{ status }}</p>
+    <template v-if="state.mode === 'consent'">
+      <section v-if="state.request" class="grant"><GrantDetails :grant="state.request" :locale="locale" /></section>
+      <p v-if="state.request" class="notice">{{ text.ai }}</p>
+      <p v-if="state.request" class="lifetime">{{ text.lifetime }}</p>
+      <footer>
+        <button data-action="close" @click="emit('close')">{{ text.close }}</button>
+        <button data-action="deny" :disabled="!state.canDecide" @click="emit('decide', 'deny')">{{ text.deny }}</button>
+        <button data-action="approve" class="primary" :disabled="!state.canDecide" @click="emit('decide', 'approve')">{{ text.approve }}</button>
+      </footer>
+    </template>
+    <template v-else>
+      <p class="lifetime">{{ text.lifetime }}</p>
+      <p v-if="state.phase === 'ready' && !state.grants.length" class="empty">{{ text.empty }}</p>
+      <section v-for="(grant, index) in state.grants" :key="JSON.stringify([grant.consumer, grant.provider, grant.type])" class="grant">
+        <GrantDetails :grant="grant" :locale="locale" />
+        <div v-if="state.confirmIndex === index" class="confirmation" role="group" :aria-label="text.confirm">
+          <p>{{ text.revokeNotice }}</p>
+          <div class="actions"><button @click="emit('confirm')">{{ text.cancel }}</button><button class="danger" @click="emit('revoke', index)">{{ text.confirm }}</button></div>
+        </div>
+        <div v-else class="actions"><button class="danger" :disabled="state.phase !== 'ready'" @click="emit('confirm', index)">{{ text.revoke }}</button></div>
+      </section>
+      <footer><button @click="emit('close')">{{ text.close }}</button><button :disabled="state.phase === 'busy' || state.phase === 'loading'" @click="emit('refresh')">{{ text.refresh }}</button></footer>
+    </template>
+  </main>
+</template>
