@@ -0,0 +1,34 @@
+import { describe, expect, it } from 'vitest';
+import { createIndicator } from './controller';
+const surface = { status: { id: 's', state: 'pending' as const, target: { kind: 'screen' as const, displayId: '1' }, intervalMs: 60_000 }, pluginName: 'Pet', pluginUuid: 'pet', source: 'market', permissionGranted: true };
+describe('trusted observation indicator', () => {
+  it('renders active state before sending the heartbeat that permits capture', async () => {
+    const events: string[] = [];
+    const controller = createIndicator('s', {
+      invoke: async (method) => { events.push(method); return method.endsWith('_surface') ? surface : { ...surface.status, state: 'active' }; },
+      render: value => events.push(`render:${value.status.state}`),
+      painted: async () => { events.push('paint'); }, visible: () => true,
+    });
+    await controller.load();
+    events.length = 0;
+    await controller.approve();
+    expect(events.slice(0, events.indexOf('otools_host_observation_heartbeat') + 1)).toEqual(['otools_host_observation_approve', 'render:active', 'paint', 'otools_host_observation_heartbeat']);
+  });
+  it('stops immediately on hidden UI instead of renewing capture permission', async () => {
+    const calls: string[] = [];
+    const controller = createIndicator('s', { invoke: async method => { calls.push(method); return surface; }, render: () => {}, painted: async () => {}, visible: () => false });
+    await controller.tick();
+    expect(calls).toEqual(['otools_host_observation_stop_from_indicator']);
+  });
+  it('never exposes an approval result after stop raced a pending approval', async () => {
+    let resolve!: (value: unknown) => void;
+    const states: string[] = [];
+    const controller = createIndicator('s', {
+      invoke: async method => method.endsWith('_surface') ? surface : method.endsWith('_approve') ? new Promise(r => { resolve = r; }) : undefined,
+      render: value => states.push(value.status.state), painted: async () => {}, visible: () => true,
+    });
+    await controller.load();
+    const approval = controller.approve(); await controller.stop(); resolve({ ...surface.status, state: 'active' }); await approval;
+    expect(states).toEqual(['pending']);
+  });
+});
diff --git a/src/features/observation/controller.ts b/src/features/observation/controller.ts
new file mode 100644
index 00000000..922981ef
--- /dev/null
+++ b/src/features/observation/controller.ts
@@ -0,0 +1,64 @@
+export interface Status {
+  id: string; state: 'pending' | 'active' | 'stopped'; intervalMs: number;
+  target: { kind: 'screen'; displayId: string } | { kind: 'window'; windowId: string }; reason?: string;
+}
+export interface Surface { status: Status; pluginName: string; pluginUuid: string; source: string; permissionGranted: boolean; targetName?: string }
+interface Host {
+  invoke(command: string, args: { id: string }): Promise<unknown>;
+  render(surface: Surface): void;
+  painted(): Promise<void>;
+  visible(): boolean;
+}
+export function createIndicator(id: string, host: Host) {
+  let surface: Surface | undefined;
+  let stopped = false;
+  let approving = false;
+  let ticking = false;
+  let generation = 0;
+  const invoke = <T>(method: string) => host.invoke(`otools_host_observation_${method}`, { id }) as Promise<T>;
+  const stop = async () => {
+    if (stopped) return;
+    stopped = true; generation++;
+    await invoke('stop_from_indicator');
+  };
+  const load = async () => {
+    const current = generation;
+    const value = await invoke<Surface>('surface');
+    if (stopped || current !== generation) return;
+    surface = value; host.render(value);
+  };
+  const heartbeat = async () => {
+    if (stopped) return;
+    if (!host.visible()) { await stop(); return; }
+    const value = await invoke<Status>('heartbeat');
+    if (stopped || !surface) return;
+    surface = { ...surface, status: value }; host.render(surface);
+    if (value.state === 'stopped') stopped = true;
+  };
+  return {
+    load, stop,
+    async permission() {
+      if (stopped || approving) return;
+      await invoke('permission'); await load();
+    },
+    async approve() {
+      if (stopped || approving || surface?.status.state !== 'pending') return;
+      approving = true; generation++;
+      try {
+        const status = await invoke<Status>('approve');
+        if (stopped || !surface) return;
+        surface = { ...surface, status }; host.render(surface);
+        await host.painted();
+        await heartbeat();
+      } finally { approving = false; }
+    },
+    async tick() {
+      if (stopped || ticking || approving) return;
+      ticking = true;
+      try {
+        if (!host.visible()) { await stop(); return; }
+        if (surface?.status.state === 'active') await heartbeat(); else await load();
+      } finally { ticking = false; }
+    },
+  };
+}
