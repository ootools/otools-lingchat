@@ -0,0 +1,103 @@
+//! Native IPC derives caller identity; plugins have no approval capability.
+use super::{identity, service, targets, types::*};
+use tauri::{AppHandle, Webview};
+async fn blocking<T: Send + 'static>(
+    f: impl FnOnce() -> Result<T, Error> + Send + 'static,
+) -> Result<T, Error> {
+    tauri::async_runtime::spawn_blocking(f)
+        .await
+        .map_err(|_| error("stopped"))?
+}
+#[tauri::command]
+pub async fn otools_host_observation_targets(
+    app: AppHandle,
+    webview: Webview,
+) -> Result<targets::Targets, Error> {
+    identity::caller(&app, &webview)?;
+    blocking(targets::list).await
+}
+#[tauri::command]
+pub async fn otools_host_observation_request(
+    app: AppHandle,
+    webview: Webview,
+    options: Request,
+) -> Result<Status, Error> {
+    let owner = identity::caller(&app, &webview)?;
+    blocking(move || service::request(&app, owner, options)).await
+}
+#[tauri::command]
+pub async fn otools_host_observation_status(
+    app: AppHandle,
+    webview: Webview,
+    id: String,
+) -> Result<Status, Error> {
+    let owner = identity::caller(&app, &webview)?;
+    blocking(move || service::status(&app, &owner, &id)).await
+}
+#[tauri::command]
+pub async fn otools_host_observation_capture(
+    app: AppHandle,
+    webview: Webview,
+    id: String,
+) -> Result<CaptureImage, Error> {
+    let owner = identity::caller(&app, &webview)?;
+    blocking(move || service::capture_image(&app, &owner, &id)).await
+}
+#[tauri::command]
+pub async fn otools_host_observation_stop(
+    app: AppHandle,
+    webview: Webview,
+    id: String,
+) -> Result<(), Error> {
+    let owner = identity::caller(&app, &webview)?;
+    blocking(move || service::stop(&app, &owner, &id)).await
+}
+#[tauri::command]
+pub async fn otools_host_observation_surface(
+    app: AppHandle,
+    webview: Webview,
+    id: String,
+) -> Result<Surface, Error> {
+    identity::indicator(&app, &webview, &id)?;
+    blocking(move || service::surface(&app, &id)).await
+}
+#[tauri::command]
+pub async fn otools_host_observation_heartbeat(
+    app: AppHandle,
+    webview: Webview,
+    id: String,
+) -> Result<Status, Error> {
+    identity::indicator(&app, &webview, &id)?;
+    blocking(move || service::heartbeat(&app, &id)).await
+}
+#[tauri::command]
+pub async fn otools_host_observation_approve(
+    app: AppHandle,
+    webview: Webview,
+    id: String,
+) -> Result<Status, Error> {
+    identity::indicator(&app, &webview, &id)?;
+    blocking(move || service::approve(&app, &id)).await
+}
+#[tauri::command]
+pub async fn otools_host_observation_permission(
+    app: AppHandle,
+    webview: Webview,
+    id: String,
+) -> Result<bool, Error> {
+    identity::indicator(&app, &webview, &id)?;
+    blocking(move || service::permission(&app, &id)).await
+}
+#[tauri::command]
+pub async fn otools_host_observation_stop_from_indicator(
+    app: AppHandle,
+    webview: Webview,
+    id: String,
+) -> Result<(), Error> {
+    identity::indicator(&app, &webview, &id)?;
+    blocking(move || {
+        service::stop_from_indicator(&app, &id);
+        Ok(())
+    })
+    .await
+}
diff --git a/src-tauri/src/platform/observation/types.rs b/src-tauri/src/platform/observation/types.rs
new file mode 100644
index 00000000..eb5ca2b6
--- /dev/null
+++ b/src-tauri/src/platform/observation/types.rs
@@ -0,0 +1,102 @@
+use super::core::{Phase, Session};
+pub use crate::platform::capture::types::{CaptureError as Error, CaptureImage};
+use serde::{Deserialize, Serialize};
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "camelCase", deny_unknown_fields)]
+pub enum Target {
+    Screen {
+        #[serde(rename = "displayId")]
+        display_id: String,
+    },
+    Window {
+        #[serde(rename = "windowId")]
+        window_id: String,
+    },
+}
+impl Target {
+    pub fn validate(&self) -> Result<(), Error> {
+        let id = match self {
+            Self::Screen { display_id } => display_id,
+            Self::Window { window_id } => window_id,
+        };
+        // The supported native backend uses explicit positive CG IDs. No implicit
+        // current screen/window whose meaning could change after consent.
+        if id.parse::<u32>().ok().is_none_or(|n| n == 0) {
+            return Err(error("invalidRequest"));
+        }
+        Ok(())
+    }
+    pub fn capture_target(&self) -> crate::platform::capture::service::CaptureTarget {
+        use crate::platform::capture::service::CaptureTarget;
+        match self {
+            Self::Screen { display_id } => CaptureTarget::Screen(Some(display_id.clone())),
+            Self::Window { window_id } => CaptureTarget::Window(Some(window_id.clone())),
+        }
+    }
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Request {
+    pub target: Target,
+    pub interval_ms: Option<u64>,
+}
+#[derive(Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Status {
+    pub id: String,
+    pub state: &'static str,
+    pub target: Target,
+    pub interval_ms: u64,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub reason: Option<&'static str>,
+}
+impl Status {
+    pub fn from(session: &Session, target: &Target) -> Self {
+        Self {
+            id: session.id.clone(),
+            state: match session.phase {
+                Phase::Pending => "pending",
+                Phase::Active => "active",
+                Phase::Stopped => "stopped",
+            },
+            target: target.clone(),
+            interval_ms: session.interval_ms,
+            reason: session.reason,
+        }
+    }
+}
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Surface {
+    pub status: Status,
+    pub plugin_name: String,
+    pub plugin_uuid: String,
+    pub source: String,
+    pub permission_granted: bool,
+}
+pub fn error(code: &str) -> Error {
+    Error::new(
+        code,
+        match code {
+            "unsupported" => {
+                "Automatic observation is unavailable: native lock/sleep safety is not supported"
+            }
+            "forbidden" => "Observation belongs to another runtime or source",
+            "tooSoon" => "Observation interval has not elapsed",
+            "permissionDenied" => "Screen recording permission is required",
+            "busy" => "An observation request or capture is already in progress",
+            "consentRequired" => "Approve observation in the OTools privacy window",
+            "indicatorUnavailable" => "Observation indicator is missing, hidden or not responding",
+            "screenLocked" | "sessionUnavailable" | "safetyInterrupted" => {
+                "Observation stopped after a lock, sleep or session interruption"
+            }
+            "stopped" => "Observation stopped; request fresh consent to restart",
+            "expired" => "Observation consent request expired",
+            "invalidRequest" => {
+                "Provide an explicit target and an interval between 30000 and 3600000 ms"
+            }
+            "notFound" => "Observation session was not found",
+            _ => "Observation could not continue",
+        },
+    )
+}
diff --git a/src-tauri/src/platform/observation/windows.rs b/src-tauri/src/platform/observation/windows.rs
new file mode 100644
index 00000000..adc4f186
--- /dev/null
+++ b/src-tauri/src/platform/observation/windows.rs
@@ -0,0 +1,98 @@
+use super::types::{error, Error};
+use tauri::{AppHandle, Manager, WebviewUrl, WebviewWindowBuilder};
+pub fn label(id: &str) -> String {
+    format!("otools-observation-{id}")
+}
+pub fn trusted_url(app: &AppHandle, url: &tauri::Url, id: &str) -> bool {
+    let origin = (url.scheme() == "tauri" && url.host_str() == Some("localhost"))
+        || (matches!(url.scheme(), "http" | "https") && url.host_str() == Some("tauri.localhost"))
+        || (cfg!(debug_assertions)
+            && app
+                .config()
+                .build
+                .dev_url
+                .as_ref()
+                .is_some_and(|dev| dev.origin() == url.origin()));
+    origin
+        && url.path() == "/observation.html"
+        && url
+            .query_pairs()
+            .any(|(key, value)| key == "id" && value == id)
+}
+pub fn visible(app: &AppHandle, id: &str) -> bool {
+    app.get_webview_window(&label(id)).is_some_and(|w| {
+        w.is_visible().unwrap_or(false)
+            && !w.is_minimized().unwrap_or(true)
+            && w.url().is_ok_and(|url| trusted_url(app, &url, id))
+    })
+}
+pub fn owner_visible(app: &AppHandle, owner: &super::core::Owner) -> bool {
+    app.get_webview(&owner.label).is_some_and(|view| {
+        let w = view.window();
+        w.is_visible().unwrap_or(false) && !w.is_minimized().unwrap_or(true)
+    })
+}
+pub fn open(app: &AppHandle, id: &str) -> Result<(), Error> {
+    let id = id.to_owned();
+    crate::platform::capture::windows::on_main(app, move |app| {
+        if super::service::status_internal(&id)?.state != "pending" {
+            return Err(error("stopped"));
+        }
+        let locale = crate::platform::i18n::current_locale();
+        let url = if cfg!(debug_assertions) {
+            if let Some(dev) = &app.config().build.dev_url {
+                let mut url = dev
+                    .join("observation.html")
+                    .map_err(|_| error("invalidRequest"))?;
+                url.query_pairs_mut()
+                    .append_pair("id", &id)
+                    .append_pair("locale", &locale);
+                WebviewUrl::External(url)
+            } else {
+                WebviewUrl::App(format!("observation.html?id={id}&locale={locale}").into())
+            }
+        } else {
+            WebviewUrl::App(format!("observation.html?id={id}&locale={locale}").into())
+        };
+        let navigation_app = app.clone();
+        let navigation_id = id.clone();
+        let w = WebviewWindowBuilder::new(&app, label(&id), url)
+            .title("OTools · Screen observation")
+            .inner_size(460., 410.)
+            .resizable(false)
+            .maximizable(false)
+            .minimizable(false)
+            .always_on_top(true)
+            .visible_on_all_workspaces(true)
+            .skip_taskbar(false)
+            .visible(true)
+            .focused(true)
+            .on_navigation(move |url| trusted_url(&navigation_app, url, &navigation_id))
+            .build()
+            .map_err(|_| error("indicatorUnavailable"))?;
+        let handle = app.clone();
+        let window_label = label(&id);
+        w.on_window_event(move |event| {
+            if matches!(
+                event,
+                tauri::WindowEvent::Destroyed | tauri::WindowEvent::CloseRequested { .. }
+            ) {
+                super::service::handle_window_unavailable(&handle, &window_label);
+            }
+        });
+        if super::service::status_internal(&id)?.state == "stopped" {
+            let _ = w.destroy();
+            return Err(error("stopped"));
+        }
+        Ok(())
+    })
+}
+pub fn close(app: &AppHandle, id: &str) {
+    let handle = app.clone();
+    let label = label(id);
+    let _ = app.run_on_main_thread(move || {
+        if let Some(w) = handle.get_webview_window(&label) {
+            let _ = w.destroy();
+        }
+    });
+}
diff --git a/src-tauri/src/platform/plugin_data/access.rs b/src-tauri/src/platform/plugin_data/access.rs
new file mode 100644
index 00000000..3d603c24
--- /dev/null
+++ b/src-tauri/src/platform/plugin_data/access.rs
@@ -0,0 +1,87 @@
+//! In-memory consent challenges. No plugin can supply its consumer identity or approve a request.
+use ot_plugin_data::{Error, Identity, Result, Scope};
+use serde::{Deserialize, Serialize};
+use std::collections::HashMap;
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AccessRequest {
+    pub id: String,
+    pub consumer: Identity,
+    pub provider: Identity,
+    #[serde(rename = "type")]
+    pub resource_type: String,
+    pub scope: Scope,
+    pub subscribe: bool,
+    pub expires_at: u64,
+}
+struct Session { label: String, url: String, request_id: String }
+struct ManagementSession { label: String, url: String, expires_at: u64 }
+#[derive(Default)]
+pub struct ConsentQueue {
+    pending: HashMap<String, AccessRequest>,
+    sessions: HashMap<String, Session>,
+    management_sessions: HashMap<String, ManagementSession>,
+}
+impl ConsentQueue {
+    pub fn bind_management(&mut self, label: &str, url: &str, now: u64) -> Result<String> {
+        self.prune(now);
+        if !label.starts_with("plugin-data-consent-") { return Err(Error::new("forbidden", "Invalid management window")); }
+        self.management_sessions.retain(|_, session| session.label != label);
+        if self.management_sessions.len() >= 16 { return Err(Error::new("busy", "Too many management windows")); }
+        let token = format!("{}{}", uuid::Uuid::new_v4(), uuid::Uuid::new_v4());
+        self.management_sessions.insert(token.clone(), ManagementSession { label: label.into(), url: url.into(), expires_at: now.saturating_add(300_000) });
+        Ok(token)
+    }
+    pub fn validate_management(&mut self, label: &str, url: &str, token: &str, now: u64) -> Result<()> {
+        self.prune(now);
+        if self.management_sessions.get(token).is_some_and(|session| session.label == label && session.url == url) { Ok(()) }
+        else { Err(Error::new("forbidden", "Management challenge is invalid or expired")) }
+    }
+    fn prune(&mut self, now: u64) {
+        self.pending.retain(|_, request| request.expires_at > now);
+        self.sessions.retain(|_, session| self.pending.contains_key(&session.request_id));
+        self.management_sessions.retain(|_, session| session.expires_at > now);
+    }
+    pub fn request(&mut self, mut request: AccessRequest, now: u64) -> Result<AccessRequest> {
+        self.prune(now);
+        ot_plugin_data::validate_identity(&request.consumer)?;
+        ot_plugin_data::validate_identity(&request.provider)?;
+        ot_plugin_data::validate_name(&request.resource_type)?;
+        ot_plugin_data::validate_scope(&request.scope)?;
+        if let Some(existing) = self.pending.values().find(|x| x.consumer == request.consumer && x.provider == request.provider && x.resource_type == request.resource_type && x.scope == request.scope && x.subscribe == request.subscribe) {
+            return Ok(existing.clone());
+        }
+        if self.pending.len() >= 64 || self.pending.values().filter(|x| x.consumer == request.consumer).count() >= 4 {
+            return Err(Error::new("busy", "Too many pending access requests"));
+        }
+        request.id = uuid::Uuid::new_v4().to_string();
+        request.expires_at = now.saturating_add(300_000);
+        self.pending.insert(request.id.clone(), request.clone());
+        Ok(request)
+    }
+    /// Native-only: the adapter must verify this is a locally created, trusted host view.
+    pub fn bind(&mut self, label: &str, url: &str, request_id: &str, now: u64) -> Result<String> {
+        self.prune(now);
+        if !label.starts_with("plugin-data-consent-") || !self.pending.contains_key(request_id) {
+            return Err(Error::new("forbidden", "Consent window or request is invalid"));
+        }
+        // Rebinding replaces the old challenge rather than allowing an unbounded token set.
+        self.sessions.retain(|_, s| s.request_id != request_id && s.label != label);
+        let token = format!("{}{}", uuid::Uuid::new_v4(), uuid::Uuid::new_v4());
+        self.sessions.insert(token.clone(), Session { label: label.into(), url: url.into(), request_id: request_id.into() });
+        Ok(token)
+    }
+    pub fn read(&mut self, label: &str, url: &str, token: &str, now: u64) -> Result<AccessRequest> {
+        self.prune(now);
+        let session = self.sessions.get(token).filter(|x| x.label == label && x.url == url)
+            .ok_or_else(|| Error::new("forbidden", "Consent challenge is invalid or expired"))?;
+        self.pending.get(&session.request_id).cloned().ok_or_else(|| Error::new("forbidden", "Consent request expired"))
+    }
+    pub fn decide(&mut self, label: &str, url: &str, token: &str, now: u64) -> Result<AccessRequest> {
+        let request = self.read(label, url, token, now)?;
+        self.pending.remove(&request.id);
+        self.sessions.retain(|_, session| session.request_id != request.id);
+        Ok(request)
+    }
+}
diff --git a/src-tauri/src/platform/plugin_data/consent_window.rs b/src-tauri/src/platform/plugin_data/consent_window.rs
new file mode 100644
index 00000000..1b8e82ae
--- /dev/null
+++ b/src-tauri/src/platform/plugin_data/consent_window.rs
@@ -0,0 +1,118 @@
+use super::{identity, service};
+use crate::platform::capture::{types::CaptureError, windows::on_main};
+use tauri::{AppHandle, Manager, WebviewUrl, WebviewWindowBuilder};
+
+/// Call from a blocking worker, not the UI thread: `on_main` waits for completion.
+pub fn open(app: &AppHandle, id: &str) -> Result<(), String> {
+    open_window(
+        app,
+        format!("plugin-data-consent-{id}"),
+        Some(id.to_owned()),
+    )
+}
+
+/// Management views each receive their own native session and private bootstrap.
+pub fn open_management(app: &AppHandle) -> Result<(), String> {
+    open_window(
+        app,
+        format!("plugin-data-consent-management-{}", uuid::Uuid::new_v4()),
+        None,
+    )
+}
+
+fn window_error(error: tauri::Error) -> CaptureError {
+    CaptureError::new("unavailable", error.to_string())
+}
+
+fn session_error(error: ot_plugin_data::Error) -> CaptureError {
+    CaptureError::new(error.code, error.message)
+}
+
+fn open_window(app: &AppHandle, label: String, request_id: Option<String>) -> Result<(), String> {
+    on_main(app, move |app| {
+        // Keep lookup, registration and injection serialized. Rebinding an existing
+        // view would invalidate the token the frontend has already consumed.
+        let existing = app.get_webview_window(&label);
+        let newly_created = existing.is_none();
+        let window = if let Some(window) = existing {
+            window
+        } else {
+            let dev_url = app
+                .config()
+                .build
+                .dev_url
+                .as_ref()
+                .filter(|_| cfg!(debug_assertions));
+            let url = if let Some(dev) = dev_url {
+                WebviewUrl::External(
+                    dev.join("/plugin-data-consent.html")
+                        .map_err(|error| CaptureError::invalid(error.to_string()))?,
+                )
+            } else {
+                WebviewUrl::App("plugin-data-consent.html".into())
+            };
+            let dev_origin = dev_url.map(|url| url.origin());
+            let request_on_load = request_id.clone();
+            let initialized = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+            WebviewWindowBuilder::new(&app, label, url)
+                .title("OTools")
+                .inner_size(680.0, 600.0)
+                .center()
+                .visible(false)
+                .focused(false)
+                .on_page_load(move |view, payload| {
+                    if !matches!(payload.event(), tauri::webview::PageLoadEvent::Finished)
+                        || initialized.swap(true, std::sync::atomic::Ordering::AcqRel) { return; }
+                    let app = view.app_handle();
+                    let bootstrap = (|| {
+                        // register_* authenticate the exact Webview, not the window.
+                        let webview = app.get_webview(view.label())
+                            .ok_or_else(|| "consent webview is unavailable".to_string())?;
+                        let token = match request_on_load.as_deref() {
+                            Some(id) => service::register_consent_session(app, &webview, id),
+                            None => service::register_management_session(app, &webview),
+                        }.map_err(|error| error.to_string())?;
+                        let value = serde_json::json!({
+                            "mode": if request_on_load.is_some() { "consent" } else { "management" },
+                            "token": token, "locale": crate::platform::i18n::current_locale(),
+                            "requestId": request_on_load,
+                        });
+                        let json = serde_json::to_string(&value).map_err(|error| error.to_string())?
+                            .replace('\u{2028}', "\\u2028").replace('\u{2029}', "\\u2029");
+                        view.eval(format!("window.__OToolsDataConsent = {json};")).map_err(|error| error.to_string())
+                    })();
+                    if let Err(error) = bootstrap {
+                        eprintln!("[plugin-data-consent] {error}");
+                        if let Some(window) = app.get_webview_window(view.label()) { let _ = window.destroy(); }
+                    }
+                })
+                .on_navigation(move |url| {
+                    let host_origin = (url.scheme() == "tauri"
+                        && url.host_str() == Some("localhost"))
+                        || (matches!(url.scheme(), "http" | "https")
+                            && url.host_str() == Some("tauri.localhost"))
+                        || dev_origin
+                            .as_ref()
+                            .is_some_and(|origin| *origin == url.origin());
+                    host_origin
+                        && url.path() == "/plugin-data-consent.html"
+                        && url.query().is_none()
+                        && url.fragment().is_none()
+                })
+                .build()
+                .map_err(window_error)?
+        };
+        let result = (|| {
+            if !newly_created {
+                identity::consent_view(&app, window.as_ref()).map_err(session_error)?;
+            }
+            window.show().map_err(window_error)?;
+            window.set_focus().map_err(window_error)
+        })();
+        if result.is_err() {
+            let _ = window.destroy();
+        }
+        result
+    })
+    .map_err(|error| error.to_string())
+}
diff --git a/src-tauri/src/platform/plugin_data/identity.rs b/src-tauri/src/platform/plugin_data/identity.rs
new file mode 100644
index 00000000..4f267c99
--- /dev/null
+++ b/src-tauri/src/platform/plugin_data/identity.rs
@@ -0,0 +1,51 @@
+use super::policy::Participant;
+use ot_plugin_data::{Declaration, Error, Identity, Result};
+use tauri::{AppHandle, Manager, Webview};
+
+/// Identity is obtained from the source-aware custom registry, never IPC arguments,
+/// URLs, caller labels parsed as identities, or a UUID-only best-match lookup.
+pub(crate) fn caller(app: &AppHandle, webview: &Webview) -> Result<Identity> {
+    let plugin = crate::platform::webview::custom::caller_plugin(app, webview, None, None)
+        .map_err(|_| Error::new("forbidden", "Caller has no source-bound plugin runtime identity"))?;
+    Ok(Identity {
+        source: crate::platform::webview::custom::source(&plugin),
+        uuid: plugin.uuid.trim().to_ascii_lowercase(),
+    })
+}
+
+pub(crate) fn participants(app: &AppHandle) -> Result<Vec<Participant>> {
+    let state = app.try_state::<crate::platform::plugins::ToolPluginsAppState>()
+        .ok_or_else(|| Error::new("unavailable", "Plugin registry is unavailable"))?;
+    state.snapshot().map_err(|_| Error::new("unavailable", "Plugin registry is unavailable"))?
+        .into_iter().map(|plugin| {
+            // Reads the installed host manifest snapshot. Until ToolPlugin preserves
+            // pluginData, a missing declaration fails closed instead of inferring access.
+            let serialized = serde_json::to_value(&plugin)?;
+            let declaration = match serialized.get("pluginData").filter(|v| !v.is_null()) {
+                Some(value) => serde_json::from_value::<Declaration>(value.clone())
+                    .map_err(|_| Error::new("invalidRequest", "Invalid pluginData declaration"))?,
+                None => Declaration::default(),
+            };
+            Ok(Participant { identity: Identity {
+                source: crate::platform::webview::custom::source(&plugin),
+                uuid: plugin.uuid.trim().to_ascii_lowercase(),
+            }, enabled: plugin.enabled, declaration })
+        }).collect()
+}
+
+/// Main/panel labels are deliberately excluded: remote forwarding can evaluate
+/// their JS. Consent is available only in a native-created dedicated view with a
+/// secret challenge retained by the host and injected into that exact view.
+pub(crate) fn consent_view(app: &AppHandle, webview: &Webview) -> Result<String> {
+    let url = webview.url().map_err(|_| Error::new("forbidden", "Consent URL is unavailable"))?;
+    let host_origin = (url.scheme() == "tauri" && url.host_str() == Some("localhost"))
+        || (matches!(url.scheme(), "http" | "https") && url.host_str() == Some("tauri.localhost"))
+        || (cfg!(debug_assertions) && app.config().build.dev_url.as_ref().is_some_and(|dev| url.origin() == dev.origin()));
+    if !webview.label().starts_with("plugin-data-consent-")
+        || !host_origin || url.path() != "/plugin-data-consent.html"
+        || url.query().is_some() || url.fragment().is_some()
+        || crate::platform::webview::core::plugin_for_runtime_binding(webview.label()).is_some() {
+        return Err(Error::new("forbidden", "Caller is not a dedicated host consent view"));
+    }
+    Ok(url.to_string())
+}
