diff --git a/src-tauri/src/platform/ai/settings.rs b/src-tauri/src/platform/ai/settings.rs
new file mode 100644
index 0000000..5536a35
--- /dev/null
+++ b/src-tauri/src/platform/ai/settings.rs
@@ -0,0 +1,217 @@
+//! Host-private model preferences and catalog policy, independent of Tauri.
+use super::queue::JobOwner;
+use base64::{engine::general_purpose::URL_SAFE_NO_PAD, Engine};
+use ot_ai_endpoints::{EndpointClient, ModelInfo, ReasoningLevel};
+use ot_ai_generate_text::{conversation::AiRequest, OtoolsAiSettings};
+use serde::{Deserialize, Serialize};
+use std::{
+    path::{Path, PathBuf},
+    sync::Mutex,
+    time::{Duration, Instant},
+};
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct AiSelection {
+    pub model: Option<String>,
+    pub reasoning_effort: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AiModelInfo {
+    pub id: String,
+    pub owned_by: String,
+    pub capabilities: Vec<String>,
+    pub reasoning_levels: Vec<ReasoningLevel>,
+    pub default_reasoning_level: Option<String>,
+    pub context_window: Option<u64>,
+}
+impl From<ModelInfo> for AiModelInfo {
+    fn from(model: ModelInfo) -> Self {
+        Self {
+            id: model.id,
+            owned_by: model.owned_by,
+            capabilities: model.capabilities,
+            reasoning_levels: model.supported_reasoning_levels,
+            default_reasoning_level: model.default_reasoning_level,
+            context_window: model.context_window,
+        }
+    }
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AiModelCatalog {
+    pub models: Vec<AiModelInfo>,
+    pub default_model: String,
+    pub selection: AiSelection,
+}
+
+impl AiSelection {
+    pub fn validate_syntax(&self) -> Result<(), String> {
+        for (value, maximum) in [(&self.model, 512), (&self.reasoning_effort, 64)] {
+            if value.as_ref().is_some_and(|value| {
+                value.trim().is_empty()
+                    || value.len() > maximum
+                    || value.chars().any(char::is_control)
+                    || value.trim() != value
+            }) {
+                return Err("invalidSettings".into());
+            }
+        }
+        Ok(())
+    }
+    pub fn needs_catalog(&self) -> bool {
+        self.model.is_some() || self.reasoning_effort.is_some()
+    }
+
+    pub fn validate(&self, default_model: &str, models: &[AiModelInfo]) -> Result<(), String> {
+        self.validate_syntax()?;
+        if !self.needs_catalog() {
+            return Ok(());
+        }
+        let id = self.model.as_deref().unwrap_or(default_model);
+        let model = models
+            .iter()
+            .find(|model| model.id == id)
+            .ok_or("modelNotFound")?;
+        if let Some(effort) = &self.reasoning_effort {
+            if !model
+                .reasoning_levels
+                .iter()
+                .any(|level| &level.effort == effort)
+            {
+                return Err("unsupportedReasoningEffort".into());
+            }
+        }
+        Ok(())
+    }
+
+    /// An explicit different model must not inherit another model's saved effort.
+    pub fn for_request(&self, request: &AiRequest, default_model: &str) -> Self {
+        let same_model = request
+            .model
+            .as_deref()
+            .is_none_or(|model| model == self.model.as_deref().unwrap_or(default_model));
+        Self {
+            model: request.model.clone().or_else(|| self.model.clone()),
+            reasoning_effort: request
+                .reasoning_effort
+                .clone()
+                .or_else(|| same_model.then(|| self.reasoning_effort.clone()).flatten()),
+        }
+    }
+}
+
+// Do not derive Debug: this key contains a credential. One entry bounds memory and
+// replacement invalidates cached metadata on endpoint/key/default model changes.
+#[derive(PartialEq, Eq)]
+struct CatalogKey {
+    provider: String,
+    base_url: String,
+    api_key: String,
+    default_model: String,
+}
+impl From<&OtoolsAiSettings> for CatalogKey {
+    fn from(settings: &OtoolsAiSettings) -> Self {
+        Self {
+            provider: settings.provider.clone(),
+            base_url: settings.base_url.clone(),
+            api_key: settings.api_key.clone(),
+            default_model: settings.model.clone(),
+        }
+    }
+}
+struct CachedCatalog {
+    key: CatalogKey,
+    fetched_at: Instant,
+    models: Vec<AiModelInfo>,
+}
+#[derive(Default)]
+pub struct CatalogCache {
+    entry: Option<CachedCatalog>,
+}
+impl CatalogCache {
+    pub fn invalidate(&mut self) {
+        self.entry = None;
+    }
+    pub async fn models(
+        &mut self,
+        settings: &OtoolsAiSettings,
+    ) -> Result<Vec<AiModelInfo>, String> {
+        let key = CatalogKey::from(settings);
+        if let Some(entry) = &self.entry {
+            if entry.key == key && entry.fetched_at.elapsed() < Duration::from_secs(60) {
+                return Ok(entry.models.clone());
+            }
+        }
+        self.entry = None;
+        // resolve_ai_settings(None) already uses the official ai-switch text
+        // settings helper. Its versioned API base also works for legacy providers.
+        let client = EndpointClient::new(&settings.base_url, &settings.api_key)
+            .map_err(|_| "modelsUnavailable".to_owned())?;
+        let models: Vec<AiModelInfo> =
+            tokio::time::timeout(Duration::from_secs(15), client.models_from_api_base())
+                .await
+                .map_err(|_| "modelsUnavailable".to_owned())?
+                .map_err(|_| "modelsUnavailable".to_owned())?
+                .into_iter()
+                .map(Into::into)
+                .collect();
+        self.entry = Some(CachedCatalog {
+            key,
+            fetched_at: Instant::now(),
+            models: models.clone(),
+        });
+        Ok(models)
+    }
+}
+
+static PREFERENCES_LOCK: Mutex<()> = Mutex::new(());
+
+fn preferences_path(app_data: &Path, owner: &JobOwner) -> PathBuf {
+    app_data
+        .join("ai-preferences")
+        .join(URL_SAFE_NO_PAD.encode(owner.source.as_bytes()))
+        .join(URL_SAFE_NO_PAD.encode(owner.uuid.as_bytes()))
+        .join("selection.json")
+}
+
+pub fn load_selection(app_data: &Path, owner: &JobOwner) -> Result<AiSelection, String> {
+    let _guard = PREFERENCES_LOCK
+        .lock()
+        .map_err(|_| "settingsUnavailable".to_owned())?;
+    match std::fs::read(preferences_path(app_data, owner)) {
+        Ok(bytes) => {
+            let value: AiSelection =
+                serde_json::from_slice(&bytes).map_err(|_| "settingsReadFailed".to_owned())?;
+            value.validate_syntax()?;
+            Ok(value)
+        }
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(AiSelection::default()),
+        Err(_) => Err("settingsReadFailed".into()),
+    }
+}
+
+/// Only callers with an authenticated owner and validated selection may write.
+/// The app-data root is supplied by the host, never by plugin arguments.
+pub fn save_selection(
+    app_data: &Path,
+    owner: &JobOwner,
+    selection: &AiSelection,
+) -> Result<(), String> {
+    selection.validate_syntax()?;
+    let _guard = PREFERENCES_LOCK
+        .lock()
+        .map_err(|_| "settingsUnavailable".to_owned())?;
+    let path = preferences_path(app_data, owner);
+    let temporary = path.with_extension("tmp");
+    let result = ot_storage::write_json_file(&temporary, selection).and_then(|_| {
+        std::fs::rename(&temporary, &path).map_err(|_| "settingsSaveFailed".to_owned())
+    });
+    if result.is_err() {
+        let _ = std::fs::remove_file(&temporary);
+    }
+    result.map_err(|_| "settingsSaveFailed".into())
+}
diff --git a/src-tauri/src/platform/ai/model_service.rs b/src-tauri/src/platform/ai/model_service.rs
new file mode 100644
index 0000000..e4920f8
--- /dev/null
+++ b/src-tauri/src/platform/ai/model_service.rs
@@ -0,0 +1,68 @@
+use super::{
+    queue::JobOwner,
+    settings::{self, AiModelCatalog, AiModelInfo, AiSelection, CatalogCache},
+};
+use ot_ai_generate_text::{conversation::AiRequest, resolve_ai_settings, OtoolsAiSettings};
+use std::{path::PathBuf, sync::OnceLock};
+use tauri::{AppHandle, Manager};
+
+static CATALOG: OnceLock<tokio::sync::Mutex<CatalogCache>> = OnceLock::new();
+fn root(app: &AppHandle) -> Result<PathBuf, String> {
+    app.path()
+        .app_data_dir()
+        .map_err(|_| "settingsUnavailable".into())
+}
+pub fn get(app: &AppHandle, owner: &JobOwner) -> Result<AiSelection, String> {
+    settings::load_selection(&root(app)?, owner)
+}
+pub fn persist(app: &AppHandle, owner: &JobOwner, selection: &AiSelection) -> Result<(), String> {
+    settings::save_selection(&root(app)?, owner, selection)
+}
+pub async fn models(
+    settings: &OtoolsAiSettings,
+    refresh: bool,
+) -> Result<Vec<AiModelInfo>, String> {
+    tokio::time::timeout(std::time::Duration::from_secs(20), async {
+        let mut cache = CATALOG
+            .get_or_init(|| tokio::sync::Mutex::new(CatalogCache::default()))
+            .lock()
+            .await;
+        if refresh {
+            cache.invalidate();
+        }
+        cache.models(settings).await
+    })
+    .await
+    .map_err(|_| "modelsUnavailable".to_owned())?
+}
+pub async fn catalog(app: &AppHandle, owner: &JobOwner) -> Result<AiModelCatalog, String> {
+    let config = resolve_ai_settings(None).map_err(|_| "invalidHostConfiguration".to_owned())?;
+    let models = models(&config, true).await?;
+    Ok(AiModelCatalog {
+        models,
+        default_model: config.model,
+        selection: get(app, owner)?,
+    })
+}
+pub async fn validate(selection: &AiSelection, config: &OtoolsAiSettings) -> Result<(), String> {
+    selection.validate_syntax()?;
+    if !selection.needs_catalog() {
+        return Ok(());
+    }
+    selection.validate(&config.model, &models(config, false).await?)
+}
+pub async fn resolve(
+    app: &AppHandle,
+    owner: &JobOwner,
+    request: &mut AiRequest,
+) -> Result<OtoolsAiSettings, String> {
+    let mut config =
+        resolve_ai_settings(None).map_err(|_| "invalidHostConfiguration".to_owned())?;
+    let selection = get(app, owner)?.for_request(request, &config.model);
+    validate(&selection, &config).await?;
+    if let Some(model) = selection.model {
+        config.model = model;
+    }
+    request.reasoning_effort = selection.reasoning_effort;
+    Ok(config)
+}
