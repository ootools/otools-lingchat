@@ -0,0 +1,115 @@
+import { describe, expect, it } from 'vitest';
+import { createConsentController, type AccessRequest, type Grant, type Invoke, type ViewState } from './controller';
+import { takeBootstrap } from './bootstrap';
+
+const request: AccessRequest = {
+  id: 'request-1', consumer: { source: 'market', uuid: 'pet' },
+  provider: { source: 'builtin', uuid: 'notes' }, type: 'note',
+  scope: { kind: 'ids', ids: ['a', '<script>alert(1)</script>'] }, subscribe: true, expiresAt: 5000,
+};
+const grant: Grant = { consumer: request.consumer, provider: request.provider, type: request.type, scope: request.scope, subscribe: true };
+const bootstrap = { mode: 'consent' as const, token: 'private-token', locale: 'en-US', requestId: request.id };
+function fixture(invoke: Invoke, initialTime = 1000) {
+  let time = initialTime;
+  const views: ViewState[] = [];
+  const controller = createConsentController(bootstrap, { invoke, now: () => time, render: state => views.push(state) });
+  return { controller, views, advance: (value: number) => { time = value; }, current: () => views.at(-1)! };
+}
+
+describe('trusted consent UI and broker integration', () => {
+  it('loads the bound request, sends only its token and one decision, and never renders the token', async () => {
+    const calls: unknown[] = [];
+    const f = fixture(async (command, args) => { calls.push([command, args]); return command.endsWith('_read') ? request : undefined; });
+    await f.controller.load();
+    expect(f.current().request).toEqual(request);
+    expect(f.current().canDecide).toBe(true);
+    await Promise.all([f.controller.decide('approve'), f.controller.decide('approve')]);
+    expect(calls).toEqual([
+      ['otools_host_plugin_data_consent_read', { request: { token: 'private-token' } }],
+      ['otools_host_plugin_data_consent_decide', { request: { token: 'private-token', decision: 'approve' } }],
+    ]);
+    expect(f.current().phase).toBe('complete');
+    expect(JSON.stringify(f.views)).not.toContain('private-token');
+  });
+  it('disables rendering and rejects an action at the exact expiry boundary', async () => {
+    const calls: string[] = [];
+    const f = fixture(async command => { calls.push(command); return request; });
+    await f.controller.load(); f.advance(5000); f.controller.tick();
+    expect(f.current().phase).toBe('expired');
+    expect(f.current().canDecide).toBe(false);
+    await f.controller.decide('approve');
+    expect(calls).toEqual(['otools_host_plugin_data_consent_read']);
+  });
+  it('checks expiry on click even if the timer has not run', async () => {
+    let decisions = 0;
+    const f = fixture(async command => { if (command.endsWith('_decide')) decisions++; return request; });
+    await f.controller.load(); f.advance(5001); await f.controller.decide('approve');
+    expect(decisions).toBe(0); expect(f.current().phase).toBe('expired');
+  });
+  it('fails closed on a request mismatch and on an uncertain decision failure', async () => {
+    const mismatch = fixture(async () => ({ ...request, id: 'other' }));
+    await mismatch.controller.load();
+    expect(mismatch.current().canDecide).toBe(false);
+    const failed = fixture(async command => { if (command.endsWith('_read')) return request; throw new Error('private-token'); });
+    await failed.controller.load(); await failed.controller.decide('approve');
+    expect(failed.current().phase).toBe('error'); expect(failed.current().canDecide).toBe(false);
+    expect(JSON.stringify(failed.views)).not.toContain('private-token');
+  });
+  it('cannot replace a terminal decision with a late read response', async () => {
+    let resolve!: (value: unknown) => void;
+    const f = fixture(async () => new Promise(r => { resolve = r; }));
+    const loading = f.controller.load(); f.controller.dispose(); resolve(request); await loading;
+    expect(f.current().canDecide).toBe(false);
+  });
+  it('denial uses the same single-use broker route', async () => {
+    const calls: unknown[] = [];
+    const f = fixture(async (command, args) => { calls.push(args); return command.endsWith('_read') ? request : undefined; });
+    await f.controller.load(); await f.controller.decide('deny');
+    expect(calls.at(-1)).toEqual({ request: { token: 'private-token', decision: 'deny' } });
+    expect(f.current().decision).toBe('deny');
+  });
+  it('management lists real grants, confirms a selected row, revokes and reloads from the broker', async () => {
+    const calls: unknown[] = []; let revoked = false; const views: ViewState[] = [];
+    const controller = createConsentController({ mode: 'management', token: 'management-token', locale: 'en' }, {
+      now: () => 1000, render: state => views.push(state),
+      invoke: async (command, args) => {
+        calls.push([command, args]);
+        if (command.endsWith('_revoke')) { revoked = true; return; }
+        return revoked ? [] : [grant];
+      },
+    });
+    await controller.load();
+    await controller.revoke(0); // Not confirmed yet.
+    expect(revoked).toBe(false);
+    controller.confirmRevoke(0);
+    expect(views.at(-1)?.confirmIndex).toBe(0);
+    await controller.revoke(0);
+    expect(calls).toEqual([
+      ['otools_host_plugin_data_grants_list', { request: { token: 'management-token' } }],
+      ['otools_host_plugin_data_grants_revoke', { request: { token: 'management-token', consumer: request.consumer, provider: request.provider, type: 'note' } }],
+      ['otools_host_plugin_data_grants_list', { request: { token: 'management-token' } }],
+    ]);
+    expect(views.at(-1)?.grants).toEqual([]);
+  });
+  it('cannot turn approval UI into arbitrary management or revoke a row that is not listed', async () => {
+    let writes = 0;
+    const f = fixture(async command => { if (command.endsWith('_revoke')) writes++; return request; });
+    await f.controller.load(); f.controller.confirmRevoke(0); await f.controller.revoke(0);
+    expect(writes).toBe(0);
+  });
+});
+
+describe('private native bootstrap', () => {
+  it('takes the capability once and removes it from the window without interpreting token text', () => {
+    const token = '\";globalThis.pwned=true;//\u2028</script>';
+    const host = { __OToolsDataConsent: { ...bootstrap, token } };
+    expect(takeBootstrap(host)?.token).toBe(token);
+    expect(takeBootstrap(host)).toBeUndefined();
+    expect(Object.keys(host)).toEqual([]);
+  });
+  it('ignores malformed capabilities and never invents access from page parameters', () => {
+    expect(takeBootstrap({ __OToolsDataConsent: { token: '', mode: 'consent' } })).toBeUndefined();
+    expect(takeBootstrap({ __OToolsDataConsent: { token: 'x', mode: 'remote' } })).toBeUndefined();
+    expect(takeBootstrap({})).toBeUndefined();
+  });
+});
diff --git a/src/features/plugin-data/controller.ts b/src/features/plugin-data/controller.ts
new file mode 100644
index 00000000..5ab85043
--- /dev/null
+++ b/src/features/plugin-data/controller.ts
@@ -0,0 +1,87 @@
+import type { Bootstrap } from './bootstrap';
+export type Identity = { source: string; uuid: string };
+export type Scope = { kind: 'all' } | { kind: 'ids'; ids: string[] };
+export type Grant = { consumer: Identity; provider: Identity; type: string; scope: Scope; subscribe: boolean };
+export type AccessRequest = Grant & { id: string; expiresAt: number };
+export type Decision = 'approve' | 'deny';
+export type ViewState = {
+  mode: Bootstrap['mode']; phase: 'loading' | 'ready' | 'busy' | 'expired' | 'complete' | 'error';
+  request?: AccessRequest; grants: Grant[]; canDecide: boolean; confirmIndex?: number; decision?: Decision;
+};
+export type Invoke = (command: string, args: Record<string, unknown>) => Promise<unknown>;
+
+export function createConsentController(bootstrap: Bootstrap, dependencies: {
+  invoke: Invoke; now: () => number; render: (state: ViewState) => void;
+}) {
+  let state: ViewState = { mode: bootstrap.mode, phase: 'loading', grants: [], canDecide: false };
+  let disposed = false;
+  let loading = false;
+  let consumed = false;
+  let generation = 0;
+  const publish = (patch: Partial<ViewState>) => {
+    if (disposed) return;
+    state = { ...state, ...patch };
+    dependencies.render(state);
+  };
+  const fail = () => publish({ phase: 'error', canDecide: false, confirmIndex: undefined });
+  const tick = () => {
+    if (state.request && !consumed && dependencies.now() >= state.request.expiresAt) {
+      publish({ phase: 'expired', canDecide: false });
+    }
+  };
+  const load = async () => {
+    if (disposed || loading || consumed || state.phase === 'busy') return;
+    loading = true;
+    const current = ++generation;
+    publish({ phase: 'loading', canDecide: false, confirmIndex: undefined });
+    try {
+      const value = await dependencies.invoke(bootstrap.mode === 'consent'
+        ? 'otools_host_plugin_data_consent_read' : 'otools_host_plugin_data_grants_list',
+      { request: { token: bootstrap.token } });
+      if (disposed || current !== generation || consumed) return;
+      if (bootstrap.mode === 'consent') {
+        const request = value as AccessRequest;
+        if (!request || request.id !== bootstrap.requestId || !Number.isFinite(request.expiresAt)) throw new Error('Invalid request');
+        publish({ request, phase: 'ready', canDecide: true });
+        tick();
+      } else {
+        if (!Array.isArray(value)) throw new Error('Invalid grants');
+        publish({ grants: value as Grant[], phase: 'ready' });
+      }
+    } catch { if (current === generation) fail(); }
+    finally { loading = false; }
+  };
+  return {
+    load, tick,
+    dispose() { generation++; disposed = true; },
+    async decide(decision: Decision) {
+      tick();
+      if (disposed || bootstrap.mode !== 'consent' || !state.canDecide || consumed || !['approve', 'deny'].includes(decision)) return;
+      // A failed response may already have consumed the native challenge. Never retry it.
+      consumed = true;
+      generation++;
+      publish({ phase: 'busy', canDecide: false });
+      try {
+        await dependencies.invoke('otools_host_plugin_data_consent_decide', { request: { token: bootstrap.token, decision } });
+        publish({ phase: 'complete', decision });
+      } catch { fail(); }
+    },
+    confirmRevoke(index?: number) {
+      if (bootstrap.mode !== 'management' || state.phase !== 'ready') return;
+      publish({ confirmIndex: index !== undefined && Number.isInteger(index) && state.grants[index] ? index : undefined });
+    },
+    async revoke(index: number) {
+      if (disposed || bootstrap.mode !== 'management' || state.phase !== 'ready' || state.confirmIndex !== index) return;
+      const grant = state.grants[index];
+      if (!grant) return;
+      publish({ phase: 'busy', confirmIndex: undefined });
+      try {
+        await dependencies.invoke('otools_host_plugin_data_grants_revoke', {
+          request: { token: bootstrap.token, consumer: grant.consumer, provider: grant.provider, type: grant.type },
+        });
+        publish({ phase: 'ready' });
+        await load();
+      } catch { fail(); }
+    },
+  };
+}
