+
+fn owner(source: &str, uuid: &str) -> JobOwner {
+    JobOwner {
+        source: source.into(),
+        uuid: uuid.into(),
+        label: "window-a".into(),
+    }
+}
+fn catalog() -> Vec<AiModelInfo> {
+    vec![
+        AiModelInfo {
+            id: "model-a".into(),
+            owned_by: "ai-switch".into(),
+            capabilities: vec![],
+            reasoning_levels: vec![ot_ai_endpoints::ReasoningLevel {
+                effort: "ultra".into(),
+                description: "Deep".into(),
+            }],
+            default_reasoning_level: Some("ultra".into()),
+            context_window: Some(200000),
+        },
+        AiModelInfo {
+            id: "model-b".into(),
+            owned_by: "ai-switch".into(),
+            capabilities: vec![],
+            reasoning_levels: vec![],
+            default_reasoning_level: None,
+            context_window: None,
+        },
+    ]
+}
+fn request(model: Option<&str>, reasoning: Option<&str>) -> AiRequest {
+    serde_json::from_value(json!({"messages":[{"role":"user","content":[{"type":"text","text":"Hi"}]}],"model":model,"reasoningEffort":reasoning})).unwrap()
+}
+#[test]
+fn selection_persists_across_windows_but_not_sources_or_plugins() {
+    let dir = tempfile::tempdir().unwrap();
+    let own = owner("market", "pet");
+    let choice = AiSelection {
+        model: Some("model-a".into()),
+        reasoning_effort: Some("ultra".into()),
+    };
+    save_selection(dir.path(), &own, &choice).unwrap();
+    assert_eq!(
+        load_selection(
+            dir.path(),
+            &JobOwner {
+                label: "window-b".into(),
+                ..own.clone()
+            }
+        )
+        .unwrap(),
+        choice
+    );
+    assert_eq!(
+        load_selection(dir.path(), &owner("dev-debug", "pet")).unwrap(),
+        AiSelection::default()
+    );
+    assert_eq!(
+        load_selection(dir.path(), &owner("market", "other")).unwrap(),
+        AiSelection::default()
+    );
+    save_selection(dir.path(), &own, &AiSelection::default()).unwrap();
+    assert_eq!(
+        load_selection(dir.path(), &own).unwrap(),
+        AiSelection::default()
+    );
+}
+#[test]
+fn validates_only_advertised_efforts_and_never_invents_defaults() {
+    let models = catalog();
+    assert!(AiSelection::default().validate("missing", &[]).is_ok());
+    assert!(AiSelection {
+        model: Some("model-a".into()),
+        reasoning_effort: Some("ultra".into())
+    }
+    .validate("model-b", &models)
+    .is_ok());
+    assert_eq!(
+        AiSelection {
+            model: Some("absent".into()),
+            reasoning_effort: None
+        }
