diff --git a/src/features/plugin-data/main.ts b/src/features/plugin-data/main.ts
new file mode 100644
index 00000000..c67b47ae
--- /dev/null
+++ b/src/features/plugin-data/main.ts
@@ -0,0 +1,44 @@
+import { createApp, h, shallowRef } from 'vue';
+import { invoke } from '@tauri-apps/api/core';
+import { getCurrentWindow } from '@tauri-apps/api/window';
+import { takeBootstrap } from './bootstrap';
+import { createConsentController, type ViewState } from './controller';
+import ConsentView from './ConsentView.vue';
+import { labels } from './labels';
+import './style.css';
+
+// Deliberately no plugin SDK, remote transport, event bus, URL parameters or storage.
+const root = document.querySelector<HTMLElement>('#plugin-data-root')!;
+let locale = navigator.language || 'en';
+root.textContent = labels(locale).loading;
+let stopped = false;
+let dispose: (() => void) | undefined;
+let interval: ReturnType<typeof setInterval> | undefined;
+window.addEventListener('pagehide', () => { stopped = true; dispose?.(); clearInterval(interval); }, { once: true });
+const deadline = Date.now() + 15_000;
+const waiting = setInterval(() => {
+  if (stopped) { clearInterval(waiting); return; }
+  const bootstrap = takeBootstrap(window);
+  if (!bootstrap) {
+    if (Date.now() >= deadline) { clearInterval(waiting); root.textContent = labels(locale).error; }
+    return;
+  }
+  clearInterval(waiting);
+  locale = bootstrap.locale;
+  document.documentElement.lang = locale;
+  document.documentElement.dir = locale.startsWith('ar') ? 'rtl' : 'ltr';
+  document.title = `OTools · ${bootstrap.mode === 'management' ? labels(locale).management : labels(locale).title}`;
+  const state = shallowRef<ViewState>({ mode: bootstrap.mode, phase: 'loading', grants: [], canDecide: false });
+  const controller = createConsentController(bootstrap, { invoke, now: Date.now, render: value => { state.value = value; } });
+  dispose = () => controller.dispose();
+  createApp({ render: () => h(ConsentView, {
+    state: state.value, locale,
+    onDecide: decision => { void controller.decide(decision); },
+    onConfirm: index => controller.confirmRevoke(index),
+    onRevoke: index => { void controller.revoke(index); },
+    onRefresh: () => { void controller.load(); },
+    onClose: () => { void getCurrentWindow().close().catch(() => { root.textContent = labels(locale).error; }); },
+  }) }).mount(root);
+  void controller.load();
+  interval = setInterval(() => controller.tick(), 200);
+}, 50);
diff --git a/src/features/plugin-data/style.css b/src/features/plugin-data/style.css
new file mode 100644
index 00000000..bb7b9d76
--- /dev/null
+++ b/src/features/plugin-data/style.css
@@ -0,0 +1,32 @@
+/* This isolated entry is built without the shell's UnoCSS/global stylesheet. */
+:root { font-family: system-ui, sans-serif; color-scheme: light dark; color: #202636; background: #f6f7fb; font-size: 14px; }
+* { box-sizing: border-box; }
+body { margin: 0; }
+main { max-width: 760px; margin: auto; padding: 24px; line-height: 1.55; }
+h1 { margin: 4px 0 20px; font-size: 23px; line-height: 1.3; }
+.brand { font-size: 12px; font-weight: 750; letter-spacing: .08em; color: #59647a; }
+.grant { padding: 16px; margin: 16px 0; border: 1px solid #dce0ea; border-radius: 12px; background: #fff; }
+.grant-details { display: grid; grid-template-columns: minmax(100px, 30%) minmax(0, 1fr); gap: 10px 16px; margin: 0; }
+dt { color: #59647a; } dd { margin: 0; overflow-wrap: anywhere; } small { color: #59647a; }
+.resource-ids { max-height: 160px; overflow: auto; padding-inline-start: 22px; margin: 6px 0 0; }
+.notice, .status, .confirmation { padding: 12px 14px; border-radius: 9px; background: #eaf0ff; }
+.lifetime { color: #59647a; }
+.error, .expired { background: #fff0e6; color: #873b0a; }
+.complete { background: #e4f5eb; color: #20623a; }
+.empty { padding: 30px 0; text-align: center; color: #59647a; }
+.actions, footer { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
+.actions { margin-top: 14px; } footer { margin-top: 22px; }
+button { font: inherit; font-size: 13px; padding: 6px 12px; min-height: 32px; border: 1px solid #c5ccda; border-radius: 7px; background: #fff; color: inherit; cursor: pointer; }
+button.primary { color: #fff; background: #315bd7; border-color: #315bd7; }
+button.danger { color: #ad2424; } button:disabled { opacity: .45; cursor: default; }
+button:focus-visible { outline: 3px solid #7296f9; outline-offset: 2px; }
+@media (prefers-color-scheme: dark) {
+  :root { color: #e6eaf3; background: #171b24; }
+  .grant, button { background: #222838; border-color: #424b60; }
+  .brand, dt, small, .lifetime, .empty { color: #b4bed2; }
+  .notice, .status, .confirmation { background: #273657; }
+  .error, .expired { background: #493121; color: #ffcc9f; }
+  .complete { background: #223e30; color: #a4e6bb; }
+  button.danger { color: #ffaaaa; }
+}
+@media (max-width: 430px) { main { padding: 16px; } .grant-details { grid-template-columns: 1fr; gap: 4px; } dd { margin-bottom: 8px; } }
