@@ -0,0 +1,111 @@
+// Exercise the production host queue without compiling Tauri and its desktop dependencies.
+#[path = "../../../src-tauri/src/platform/ai/queue.rs"]
+mod queue;
+use queue::{JobOwner, JobRegistry, MAX_EVENTS, MAX_QUEUE_BYTES, MAX_JOBS};
+
+fn owner(label: &str) -> JobOwner { JobOwner { label: label.into(), source: "market".into(), uuid: "pet".into() } }
+
+#[test]
+fn private_queue_preserves_sequence_and_terminal_once() {
+    let mut jobs = JobRegistry::default();
+    let owner = owner("pet-1");
+    jobs.start("a".into(), owner.clone(), 0).unwrap();
+    jobs.delta("a", "one", 0).unwrap();
+    jobs.delta("a", "two", 0).unwrap();
+    jobs.finish("a", None, 1);
+    jobs.finish("a", Some("late error"), 1);
+    assert!(jobs.delta("a", "late", 0).is_err());
+    let result = jobs.read(&owner, "a", 0).unwrap();
+    assert!(result.done);
+    assert_eq!(result.events.iter().map(|e| (e.sequence, e.kind.as_str(), e.text.as_deref())).collect::<Vec<_>>(), [(1,"delta",Some("one")),(2,"delta",Some("two")),(3,"done",None)]);
+    assert!(jobs.read(&owner, "a", 3).unwrap().events.is_empty());
+    assert!(jobs.read(&owner, "a", 0).is_err(), "acknowledged history must report a cursor gap");
+    assert!(jobs.read(&owner, "a", 4).is_err(), "future cursors cannot discard unreceived data");
+}
+
+#[test]
+fn denies_other_window_source_or_plugin_without_draining() {
+    let mut jobs = JobRegistry::default();
+    let mine = owner("pet");
+    jobs.start("private".into(), mine.clone(), 0).unwrap();
+    jobs.delta("private", "secret response", 0).unwrap();
+    for other in [owner("other-window"), JobOwner { source:"dev".into(), ..mine.clone() }, JobOwner { uuid:"other".into(), ..mine.clone() }] {
+        assert!(jobs.read(&other, "private", 1).is_err());
+        assert!(jobs.cancel(&other, "private", 1).is_err());
+    }
+    assert_eq!(jobs.read(&mine, "private", 0).unwrap().events[0].text.as_deref(), Some("secret response"));
+}
+
+#[tokio::test]
+async fn cancellation_wakes_worker_and_discards_late_output() {
+    let mut jobs = JobRegistry::default();
+    let mine = owner("pet");
+    let cancellation = jobs.start("a".into(), mine.clone(), 0).unwrap();
+    jobs.cancel(&mine, "a", 1).unwrap();
+    tokio::time::timeout(std::time::Duration::from_millis(50), cancellation.cancelled()).await.unwrap();
+    jobs.cancel(&mine, "a", 2).unwrap();
+    assert!(jobs.delta("a", "late secret", 0).is_err());
+    jobs.finish("a", None, 3);
+    let result = jobs.read(&mine,"a",0).unwrap();
+    assert!(result.done);
+    assert_eq!(result.events.len(),1);
+    assert_eq!(result.events[0].kind,"cancelled");
+}
+
+#[tokio::test]
+async fn overflow_stops_worker_with_explicit_error_without_silent_loss() {
+    let mut jobs = JobRegistry::default();
+    let mine = owner("pet");
+    let cancellation = jobs.start("a".into(), mine.clone(), 0).unwrap();
+    for _ in 0..MAX_EVENTS - 1 { jobs.delta("a","x", 0).unwrap(); }
+    assert!(jobs.delta("a","overflow", 0).is_err());
+    cancellation.cancelled().await;
+    let result = jobs.read(&mine,"a",0).unwrap();
+    assert_eq!(result.events.len(),MAX_EVENTS);
+    assert!(result.done);
+    assert_eq!(result.events.last().unwrap().error.as_deref(),Some("backlogExceeded"));
+    jobs.start("b".into(), mine.clone(), 0).unwrap();
+    assert!(jobs.delta("b",&"x".repeat(MAX_QUEUE_BYTES + 1), 0).is_err());
+    assert_eq!(jobs.read(&mine,"b",0).unwrap().events[0].kind,"error");
+}
+
+#[test]
+fn bounds_job_count_and_reclaims_closed_expired_jobs() {
+    let mut jobs = JobRegistry::default();
+    for i in 0..MAX_JOBS { jobs.start(i.to_string(),owner(&i.to_string()),0).unwrap(); }
+    assert!(jobs.start("overflow".into(),owner("pet"),0).is_err());
+    jobs.remove_owner("0");
+    assert!(jobs.start("replacement".into(),owner("pet"),0).is_ok());
+    jobs.prune(11 * 60 * 1000);
+    assert!(jobs.read(&owner("pet"),"replacement",0).is_err());
+    assert!(jobs.start("new".into(),owner("pet"),11 * 60 * 1000).is_ok());
+    jobs.shutdown();
+    assert!(jobs.read(&owner("pet"),"new",0).is_err());
+}
+
+#[test]
+fn terminal_acknowledgement_releases_capacity_and_expiry_uses_actual_finish_time() {
+    let mut jobs = JobRegistry::default();
+    let mine = owner("pet");
+    for i in 0..10 {
+        let id = i.to_string();
+        jobs.start(id.clone(),mine.clone(),0).unwrap();
+        jobs.finish(&id,None,1);
+        assert!(jobs.read(&mine,&id,1).unwrap().events.is_empty());
+    }
+    jobs.start("overflow".into(),mine.clone(),0).unwrap();
+    assert!(jobs.delta("overflow", &"x".repeat(MAX_QUEUE_BYTES + 1), 120_000).is_err());
+    jobs.prune(120_001);
+    assert!(jobs.read(&mine,"overflow",0).unwrap().done);
+    jobs.prune(180_001);
+    assert!(jobs.read(&mine,"overflow",0).is_err());
+}
+
+#[tokio::test]
+async fn dropping_closed_owner_jobs_cancels_outstanding_network_future() {
+    let mut jobs = JobRegistry::default();
+    let stop = jobs.start("a".into(),owner("closing"),0).unwrap();
+    jobs.remove_owner("closing");
+    stop.cancelled().await;
+    assert!(jobs.read(&owner("closing"),"a",0).is_err());
+}
