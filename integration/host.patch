@@ -0,0 +1,185 @@
+//! Host-configured conversations. Image references are resolved by the caller only
+//! after validation; this wire request deliberately has no provider/credential fields.
+use crate::{build_azure_config, build_openai_config, OtoolsAiSettings};
+use async_openai::types::{CreateChatCompletionRequest, CreateChatCompletionStreamResponse};
+use reqwest_eventsource::{Event, RequestBuilderExt};
+use futures::StreamExt;
+use serde::{Deserialize, Serialize};
+use serde_json::json;
+
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AiCapabilities {
+    pub configured: bool,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub provider: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub model: Option<String>,
+    pub streaming: bool,
+    pub cancellation: bool,
+    pub vision: &'static str,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub reason: Option<&'static str>,
+}
+impl AiCapabilities {
+    pub fn from_settings(settings: Option<&OtoolsAiSettings>) -> Self {
+        let settings = settings.filter(|s| !s.model.trim().is_empty());
+        Self {
+            configured: settings.is_some(),
+            provider: settings.map(|s| s.provider.clone()),
+            model: settings.map(|s| s.model.trim().to_owned()),
+            streaming: true,
+            cancellation: true,
+            // The host has configuration, not trustworthy per-model modality metadata.
+            vision: "unknown",
+            reason: settings.is_none().then_some("invalidHostConfiguration"),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct AiRequest {
+    pub messages: Vec<AiMessage>,
+    pub temperature: Option<f32>,
+    pub max_tokens: Option<u16>,
+}
+
+#[derive(Debug, Clone, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct AiMessage {
+    pub role: AiRole,
+    pub content: Vec<AiContent>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "lowercase")]
+pub enum AiRole {
+    System,
+    User,
+    Assistant,
+}
+
+#[derive(Debug, Clone, Deserialize, Serialize)]
+#[serde(tag = "type", rename_all = "camelCase", deny_unknown_fields)]
+pub enum AiContent {
+    Text { text: String },
+    Image {
+        #[serde(rename = "captureImageId")]
+        capture_image_id: String,
+    },
+}
+
+impl AiRequest {
+    pub fn validate(&self) -> Result<(), String> {
+        if self.messages.is_empty() || self.messages.len() > 128 {
+            return Err("invalidMessages".into());
+        }
+        if self.temperature.is_some_and(|v| !v.is_finite() || !(0.0..=2.0).contains(&v))
+            || self.max_tokens == Some(0)
+        {
+            return Err("invalidParameters".into());
+        }
+        let mut bytes = 0usize;
+        let mut parts = 0usize;
+        let mut images = 0usize;
+        for message in &self.messages {
+            if message.content.is_empty() { return Err("emptyMessage".into()); }
+            for part in &message.content {
+                parts += 1;
+                match part {
+                    AiContent::Text { text } => { bytes = bytes.saturating_add(text.len()); }
+                    AiContent::Image { capture_image_id } => {
+                        images += 1;
+                        if message.role != AiRole::User || capture_image_id.is_empty() || capture_image_id.len() > 256 {
+                            return Err("invalidImageReference".into());
+                        }
+                    }
+                }
+            }
+        }
+        if bytes > 1024 * 1024 || parts > 256 || images > 8 { return Err("requestTooLarge".into()); }
+        Ok(())
+    }
+}
+
+pub fn prepare_request(
+    request: &AiRequest,
+    model: &str,
+    mut resolve_image: impl FnMut(&str) -> Result<String, String>,
+) -> Result<CreateChatCompletionRequest, String> {
+    request.validate()?;
+    if model.trim().is_empty() { return Err("modelNotConfigured".into()); }
+    let mut messages = Vec::with_capacity(request.messages.len());
+    for message in &request.messages {
+        let mut parts = Vec::with_capacity(message.content.len());
+        for part in &message.content {
+            parts.push(match part {
+                AiContent::Text { text } => json!({"type":"text","text":text}),
+                AiContent::Image { capture_image_id } => {
+                    let data_url = resolve_image(capture_image_id)?;
+                    if !data_url.starts_with("data:image/png;base64,") { return Err("invalidCaptureImage".into()); }
+                    json!({"type":"image_url","image_url":{"url":data_url}})
+                }
+            });
+        }
+        messages.push(json!({"role":message.role,"content":parts}));
+    }
+    let mut wire = json!({"model":model.trim(),"messages":messages,"stream":true});
+    if let Some(value) = request.temperature { wire["temperature"] = json!(value); }
+    if let Some(value) = request.max_tokens { wire["max_tokens"] = json!(value); }
+    serde_json::from_value(wire).map_err(|_| "invalidMessages".into())
+}
+
+async fn stream_with_config<C: async_openai::config::Config>(
+    config: C,
+    request: CreateChatCompletionRequest,
+    mut on_delta: impl FnMut(&str) -> Result<(), String>,
+) -> Result<(), String> {
+    // async-openai 0.28's create_stream detaches an unbounded worker. Own the
+    // underlying SSE stream here, using its provider URLs, headers and types.
+    let client = reqwest::Client::builder()
+        .redirect(reqwest::redirect::Policy::none())
+        .connect_timeout(std::time::Duration::from_secs(30))
+        .build().map_err(|_| "providerFailed".to_owned())?;
+    let mut stream = client.post(config.url("/chat/completions"))
+        .headers(config.headers()).query(&config.query()).json(&request)
+        .eventsource().map_err(|_| "providerFailed".to_owned())?;
+    stream.set_retry_policy(Box::new(reqwest_eventsource::retry::Never));
+    let mut has_text = false;
+    let mut completed = false;
+    while let Some(event) = stream.next().await {
+        // Never expose provider error bodies, which can echo credentials/inputs.
+        let event = event.map_err(|_| "providerStreamFailed".to_owned())?;
+        let Event::Message(message) = event else { continue; };
+        if message.data == "[DONE]" { completed = true; break; }
+        if message.data.len() > 256 * 1024 { return Err("providerEventTooLarge".into()); }
+        let chunk: CreateChatCompletionStreamResponse = serde_json::from_str(&message.data)
+            .map_err(|_| "providerStreamFailed".to_owned())?;
+        for choice in chunk.choices {
+            if choice.index != 0 { continue; }
+            if let Some(delta) = choice.delta.content.filter(|text| !text.is_empty()) {
+                has_text |= !delta.trim().is_empty();
+                on_delta(&delta)?;
+            }
+        }
+    }
+    if !completed { return Err("providerStreamFailed".into()); }
+    if !has_text { return Err("emptyResponse".into()); }
+    Ok(())
+}
+
+/// Runs on the caller's async runtime. Dropping this future drops the live HTTP
+/// stream (unlike legacy generate_text's detached worker), enabling cancellation.
+pub async fn stream_conversation(
+    settings: &OtoolsAiSettings,
+    request: CreateChatCompletionRequest,
+    on_delta: impl FnMut(&str) -> Result<(), String>,
+) -> Result<(), String> {
+    if settings.provider == "azure" {
+        let config = build_azure_config(settings).map_err(|_| "invalidHostConfiguration".to_owned())?;
+        stream_with_config(config, request, on_delta).await
+    } else {
+        stream_with_config(build_openai_config(settings), request, on_delta).await
+    }
+}
