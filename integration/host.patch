+:root { font-family: system-ui, sans-serif; color: #17212d; background: #f8fafc; font-synthesis: none; color-scheme: light dark; }
+* { box-sizing: border-box; }
+body { margin: 0; }
+main { padding: 20px; }
+.brand { color: #536174; font-size: 12px; letter-spacing: .08em; font-weight: 700; }
+h1 { font-size: 22px; margin: 6px 0 12px; }
+p { font-size: 13px; line-height: 1.5; }
+.badge { border: 1px solid #c7d2df; border-radius: 8px; background: #edf2f7; padding: 9px 12px; font-weight: 700; }
+.badge[data-state="active"] { background: #fff2da; border-color: #c97400; color: #7b3900; }
+dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 12px; font-size: 13px; }
+dt { color: #596779; }
+dd { margin: 0; overflow-wrap: anywhere; }
+.safety { color: #596779; }
+.actions { display: flex; flex-wrap: wrap; gap: 8px; position: sticky; bottom: 0; padding-top: 8px; background: #f8fafc; }
+button { font: inherit; font-size: 13px; padding: 8px 12px; border: 1px solid #b8c5d4; border-radius: 7px; background: #fff; color: #17212d; cursor: pointer; }
+button:focus-visible { outline: 3px solid #397dcc; outline-offset: 2px; }
+button:disabled { opacity: .55; cursor: default; }
+.approve { background: #1b5caf; color: #fff; border-color: #1b5caf; }
+.stop { background: #ac2635; color: #fff; border-color: #ac2635; margin-inline-start: auto; }
+.error { color: #a61828; }
+[hidden] { display: none !important; }
+@media (prefers-color-scheme: dark) {
+  :root { color: #eef3f9; background: #17212d; }
+  .actions { background: #17212d; }
+  .brand, dt, .safety { color: #b6c5d8; }
