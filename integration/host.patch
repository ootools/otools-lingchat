+use ot_ai_generate_text::conversation::{prepare_request, stream_conversation, AiRequest};
+use ot_ai_generate_text::OtoolsAiSettings;
+use serde_json::{json, Value};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+fn request(value: Value) -> AiRequest { serde_json::from_value(value).unwrap() }
+
+#[test]
+fn preserves_roles_text_whitespace_and_owned_image_resolution() {
+    let input = request(json!({"messages":[
+        {"role":"system","content":[{"type":"text","text":" rules "}]},
+        {"role":"user","content":[{"type":"text","text":"look"},{"type":"image","captureImageId":"owned-image"}]},
+        {"role":"assistant","content":[{"type":"text","text":"seen"}]},
+        {"role":"user","content":[{"type":"text","text":"continue"}]}
+    ],"temperature":0.25,"maxTokens":42}));
+    let mut resolved = vec![];
+    let built = prepare_request(&input, "host-model", |id| {
+        resolved.push(id.to_owned());
+        Ok("data:image/png;base64,aGVsbG8=".to_owned())
+    }).unwrap();
+    let wire = serde_json::to_value(built).unwrap();
+    assert_eq!(resolved, ["owned-image"]);
+    assert_eq!(wire["messages"][0], json!({"role":"system","content":[{"type":"text","text":" rules "}]}));
+    assert_eq!(wire["messages"][1]["content"][1], json!({"type":"image_url","image_url":{"url":"data:image/png;base64,aGVsbG8=","detail":null}}));
+    assert_eq!(wire["messages"][2]["role"], "assistant");
+    assert_eq!(wire["messages"][3]["content"][0]["text"], "continue");
+    assert_eq!(wire["model"], "host-model");
+    assert_eq!(wire["max_tokens"], 42);
+    assert_eq!(wire["stream"], true);
+}
+
+#[test]
+fn rejects_credentials_urls_invalid_parameters_and_non_user_images() {
+    for field in ["apiKey", "provider", "model", "baseUrl"] {
+        let mut value = json!({"messages":[]});
+        value[field] = json!("plugin-controlled");
+        assert!(serde_json::from_value::<AiRequest>(value).is_err());
+    }
+    assert!(serde_json::from_value::<AiRequest>(json!({"messages":[{"role":"user","content":[{"type":"image","url":"http://private"}]}]})).is_err());
+    for value in [
+        json!({"messages":[]}),
+        json!({"messages":[{"role":"user","content":[]}]}),
+        json!({"messages":[{"role":"system","content":[{"type":"image","captureImageId":"x"}]}]}),
+        json!({"messages":[{"role":"user","content":[{"type":"text","text":"x"}]}],"temperature":3}),
+        json!({"messages":[{"role":"user","content":[{"type":"text","text":"x"}]}],"maxTokens":0}),
+    ] {
+        assert!(prepare_request(&request(value), "model", |_| panic!("invalid requests must not resolve images")).is_err());
+    }
+    let image = request(json!({"messages":[{"role":"user","content":[{"type":"image","captureImageId":"foreign"}]}]}));
+    assert_eq!(prepare_request(&image, "model", |_| Err("forbidden".into())).unwrap_err(), "forbidden");
+}
+
+#[test]
+fn capabilities_report_resolved_model_without_claiming_vision_support_or_exposing_secrets() {
+    use ot_ai_generate_text::conversation::AiCapabilities;
+    let settings = OtoolsAiSettings { provider: "openai".into(), base_url: "http://host-private".into(), api_key: "host-secret".into(), model: "vision-sounding-name".into() };
+    let value = serde_json::to_value(AiCapabilities::from_settings(Some(&settings))).unwrap();
+    assert_eq!(value, json!({"configured":true,"provider":"openai","model":"vision-sounding-name","streaming":true,"cancellation":true,"vision":"unknown"}));
+    let missing = serde_json::to_value(AiCapabilities::from_settings(None)).unwrap();
+    assert_eq!(missing["configured"], false);
+    assert_eq!(missing["reason"], "invalidHostConfiguration");
+}
+
+#[tokio::test]
+async fn dropping_inference_closes_a_stalled_provider_connection() {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let (opened, wait_open) = tokio::sync::oneshot::channel();
+    let server = tokio::spawn(async move {
+        let (mut socket, _) = listener.accept().await.unwrap();
+        let mut request = [0; 8192];
+        socket.read(&mut request).await.unwrap();
+        socket.write_all(b"HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nTransfer-Encoding: chunked\r\n\r\n").await.unwrap();
+        opened.send(()).unwrap();
+        let mut byte = [0];
+        match tokio::time::timeout(std::time::Duration::from_millis(500), socket.read(&mut byte)).await
+            .expect("cancel must close the socket without waiting for the next SSE token") {
+            Ok(0) => true,
+            Err(error) if matches!(error.kind(), std::io::ErrorKind::ConnectionReset | std::io::ErrorKind::ConnectionAborted) => true,
+            other => panic!("cancel left the provider connection open: {other:?}"),
+        }
+    });
+    let settings = OtoolsAiSettings { provider:"openai".into(), base_url:format!("http://{address}/v1"), api_key:"host".into(), model:"m".into() };
+    let input = request(json!({"messages":[{"role":"user","content":[{"type":"text","text":"hi"}]}]}));
+    let built = prepare_request(&input,"m", |_| unreachable!()).unwrap();
+    let worker = tokio::spawn(async move { stream_conversation(&settings,built, |_| Ok(())).await });
+    wait_open.await.unwrap();
+    worker.abort();
+    let _ = worker.await;
+    assert!(server.await.unwrap());
+}
+
+#[tokio::test]
+async fn streams_real_sse_in_order_and_keeps_model_credentials_host_side() {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let server = tokio::spawn(async move {
+        let (mut socket, _) = listener.accept().await.unwrap();
+        let mut raw = Vec::new();
+        let body_start;
+        loop {
+            let mut buf = [0; 4096];
+            let n = socket.read(&mut buf).await.unwrap();
+            assert!(n > 0);
+            raw.extend_from_slice(&buf[..n]);
+            if let Some(index) = raw.windows(4).position(|v| v == b"\r\n\r\n") {
+                body_start = index + 4;
+                break;
+            }
+        }
+        let headers = String::from_utf8_lossy(&raw[..body_start]).to_ascii_lowercase();
+        let length: usize = headers.lines().find_map(|line| line.strip_prefix("content-length: ")).unwrap().trim().parse().unwrap();
+        while raw.len() < body_start + length {
+            let mut buf = [0; 4096];
+            let n = socket.read(&mut buf).await.unwrap();
+            assert!(n > 0);
+            raw.extend_from_slice(&buf[..n]);
+        }
+        assert!(headers.contains("authorization: bearer host-secret"));
+        let wire: Value = serde_json::from_slice(&raw[body_start..body_start + length]).unwrap();
+        assert_eq!(wire["model"], "configured-model");
+        assert_eq!(wire["messages"][0]["role"], "user");
+        let response = concat!(
+            "data: {\"id\":\"x\",\"object\":\"chat.completion.chunk\",\"created\":0,\"model\":\"m\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"hello \"},\"finish_reason\":null}]}\n\n",
+            "data: {\"id\":\"x\",\"object\":\"chat.completion.chunk\",\"created\":0,\"model\":\"m\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"world\"},\"finish_reason\":\"stop\"}]}\n\n",
+            "data: [DONE]\n\n"
+        );
+        socket.write_all(format!("HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}", response.len(), response).as_bytes()).await.unwrap();
+    });
+    let settings = OtoolsAiSettings { provider: "openai".into(), base_url: format!("http://{address}/v1"), api_key: "host-secret".into(), model: "configured-model".into() };
+    let input = request(json!({"messages":[{"role":"user","content":[{"type":"text","text":"hi"}]}]}));
+    let built = prepare_request(&input, &settings.model, |_| unreachable!()).unwrap();
+    let mut deltas = vec![];
+    stream_conversation(&settings, built, |delta| { deltas.push(delta.to_owned()); Ok(()) }).await.unwrap();
+    assert_eq!(deltas, ["hello ", "world"]);
+    server.await.unwrap();
+}
