diff --git a/src-tauri/src/platform/plugin_data/policy.rs b/src-tauri/src/platform/plugin_data/policy.rs
new file mode 100644
index 00000000..1e661bc9
--- /dev/null
+++ b/src-tauri/src/platform/plugin_data/policy.rs
@@ -0,0 +1,41 @@
+use ot_plugin_data::{Declaration, Error, Identity, ReadRequest, Result};
+use serde::Serialize;
+#[derive(Clone)]
+pub struct Participant { pub identity: Identity, pub enabled: bool, pub declaration: Declaration }
+#[derive(Serialize)]
+pub struct Provider { pub provider: Identity, pub types: Vec<String> }
+fn participant<'a>(all: &'a [Participant], identity: &Identity) -> Result<&'a Participant> {
+    ot_plugin_data::validate_identity(identity)?;
+    let mut matches = all.iter().filter(|p| p.identity == *identity);
+    let p = matches.next().ok_or_else(|| Error::new("permissionDenied", "Plugin is not installed"))?;
+    if !p.enabled || matches.next().is_some() { return Err(Error::new("permissionDenied", "Plugin is disabled or ambiguous")); }
+    Ok(p)
+}
+pub fn authorize_write(all: &[Participant], owner: &Identity, resource_type: &str) -> Result<()> {
+    ot_plugin_data::validate_name(resource_type)?;
+    if !participant(all, owner)?.declaration.provides.iter().any(|t| t == resource_type) {
+        return Err(Error::new("permissionDenied", "Provider must declare the resource type"));
+    }
+    Ok(())
+}
+pub fn authorize_read(all: &[Participant], caller: &Identity, request: &ReadRequest) -> Result<()> {
+    authorize_write(all, &request.provider, &request.resource_type)?;
+    let consumer = participant(all, caller)?;
+    if caller != &request.provider && !consumer.declaration.consumes.contains(&request.resource_type) {
+        return Err(Error::new("permissionDenied", "Consumer must declare the resource type"));
+    }
+    Ok(())
+}
+/// Discovery reveals declarations only; it does not confer access to records.
+pub fn discover(all: &[Participant], caller: &Identity) -> Result<Vec<Provider>> {
+    let consumer = participant(all, caller)?;
+    let mut providers = Vec::new();
+    for p in all {
+        if participant(all, &p.identity).is_err() { continue; }
+        let mut types: Vec<String> = p.declaration.provides.iter()
+            .filter(|t| p.identity == *caller || consumer.declaration.consumes.contains(t)).cloned().collect();
+        types.sort(); types.dedup();
+        if !types.is_empty() { providers.push(Provider { provider:p.identity.clone(), types }); }
+    }
+    Ok(providers)
+}
diff --git a/src-tauri/src/platform/plugin_data/service.rs b/src-tauri/src/platform/plugin_data/service.rs
new file mode 100644
index 00000000..8dc8a497
--- /dev/null
+++ b/src-tauri/src/platform/plugin_data/service.rs
@@ -0,0 +1,102 @@
+use super::{access::{AccessRequest, ConsentQueue}, identity, policy};
+use ot_plugin_data::{Error, Identity, ListPage, ReadRequest, Result, Store};
+use std::{sync::{Mutex, OnceLock}, time::{SystemTime, UNIX_EPOCH}};
+use tauri::{AppHandle, Manager, Webview};
+
+pub struct PluginDataState { pub(crate) store: Mutex<Store>, pub(crate) consent: Mutex<ConsentQueue> }
+type ConsentOpener = fn(&AppHandle, &str) -> std::result::Result<(), String>;
+static OPENER: OnceLock<ConsentOpener> = OnceLock::new();
+static INITIALIZE: Mutex<()> = Mutex::new(());
+
+/// Install once at native setup. The opener creates a dedicated host window,
+/// registers a consent session, and injects its token only in that window.
+pub fn install_consent_opener(opener: ConsentOpener) -> std::result::Result<(), String> {
+    OPENER.set(opener).map_err(|_| "Plugin data consent opener already installed".into())
+}
+pub(crate) fn state(app: &AppHandle) -> Result<tauri::State<'_, PluginDataState>> {
+    let _init = INITIALIZE.lock().map_err(|_| unavailable())?;
+    if app.try_state::<PluginDataState>().is_none() {
+        // app_data_dir is host-owned and separate from plugin storage APIs.
+        let root = app.path().app_data_dir().map_err(|_| unavailable())?.join("plugin-data");
+        std::fs::create_dir_all(&root).map_err(|_| unavailable())?;
+        #[cfg(unix)] {
+            use std::os::unix::fs::PermissionsExt;
+            std::fs::set_permissions(&root, std::fs::Permissions::from_mode(0o700)).map_err(|_| unavailable())?;
+        }
+        let store = Store::open(&root.join("resources.sqlite3"), 1024)?;
+        app.manage(PluginDataState {store:Mutex::new(store),consent:Mutex::new(ConsentQueue::default())});
+    }
+    app.try_state::<PluginDataState>().ok_or_else(unavailable)
+}
+pub(crate) fn unavailable() -> Error { Error::new("unavailable", "Plugin data service is unavailable") }
+pub(crate) fn now() -> Result<u64> {
+    Ok(SystemTime::now().duration_since(UNIX_EPOCH).map_err(|_| unavailable())?.as_millis() as u64)
+}
+pub(crate) fn with_store<T>(app: &AppHandle, call: impl FnOnce(&mut Store) -> Result<T>) -> Result<T> {
+    let state = state(app)?;
+    let mut store = state.store.lock().map_err(|_| unavailable())?;
+    call(&mut store)
+}
+
+/// Native background jobs must retain the runtime identity captured at enrollment.
+/// Every poll repeats enabled, declaration and grant checks; no provider view is needed.
+pub fn authorized_list_for_principal(app: &AppHandle, principal: &Identity, request: &ReadRequest, cursor: Option<&str>, limit: usize) -> Result<ListPage> {
+    policy::authorize_read(&identity::participants(app)?, principal, request)?;
+    with_store(app, |store| store.list(principal, request, cursor, limit))
+}
+
+pub(crate) fn request_access(app: &AppHandle, consumer: Identity, request: super::transport::RequestAccessRequest) -> Result<super::transport::AccessStatus> {
+    let opener = OPENER.get().ok_or_else(|| Error::new("unsupported", "Host consent window is unavailable"))?;
+    let read = ReadRequest {provider:request.provider.clone(),resource_type:request.resource_type.clone()};
+    policy::authorize_read(&identity::participants(app)?, &consumer, &read)?;
+    if consumer == request.provider { return Err(Error::new("invalidRequest", "Providers already own their resources")); }
+    let pending = {
+        let state = state(app)?;
+        let mut queue = state.consent.lock().map_err(|_| unavailable())?;
+        queue.request(AccessRequest { id:String::new(), consumer, provider:request.provider,
+            resource_type:request.resource_type,scope:request.scope,subscribe:request.subscribe,expires_at:0 }, now()?)?
+    };
+    // The opener executes after unlocking the queue; native creation can register a challenge.
+    opener(app, &pending.id).map_err(|_| Error::new("unavailable", "Cannot open host consent window"))?;
+    Ok(super::transport::AccessStatus {id:pending.id,status:"pending".into()})
+}
+
+/// Native-only capability. Do not expose this function through generic host invoke.
+pub fn register_consent_session(app: &AppHandle, view: &Webview, request_id: &str) -> Result<String> {
+    let url = identity::consent_view(app, view)?;
+    let state = state(app)?;
+    let mut queue = state.consent.lock().map_err(|_| unavailable())?;
+    queue.bind(view.label(), &url, request_id, now()?)
+}
+pub fn register_management_session(app: &AppHandle, view: &Webview) -> Result<String> {
+    let url = identity::consent_view(app, view)?;
+    let state = state(app)?;
+    let mut queue = state.consent.lock().map_err(|_| unavailable())?;
+    queue.bind_management(view.label(), &url, now()?)
+}
+pub(crate) fn validate_management(app: &AppHandle, view: &Webview, token: &str) -> Result<()> {
+    let url = identity::consent_view(app, view)?;
+    let state = state(app)?;
+    let mut queue = state.consent.lock().map_err(|_| unavailable())?;
+    queue.validate_management(view.label(), &url, token, now()?)
+}
+pub(crate) fn read_consent(app: &AppHandle, view: &Webview, token: &str) -> Result<AccessRequest> {
+    let url = identity::consent_view(app, view)?;
+    let state = state(app)?;
+    let mut queue = state.consent.lock().map_err(|_| unavailable())?;
+    queue.read(view.label(), &url, token, now()?)
+}
+pub(crate) fn decide_consent(app: &AppHandle, view: &Webview, token: &str, decision: super::transport::Decision) -> Result<()> {
+    let url = identity::consent_view(app, view)?;
+    let state = state(app)?;
+    let request = state.consent.lock().map_err(|_| unavailable())?.decide(view.label(), &url, token, now()?)?;
+    match decision {
+        super::transport::Decision::Deny => Ok(()),
+        super::transport::Decision::Revoke => with_store(app, |store| store.revoke(&request.consumer, &request.provider, &request.resource_type)),
+        super::transport::Decision::Approve => {
+            policy::authorize_read(&identity::participants(app)?, &request.consumer,
+                &ReadRequest {provider:request.provider.clone(),resource_type:request.resource_type.clone()})?;
+            with_store(app, |store| store.set_grant(&request.consumer, &request.provider, &request.resource_type, request.scope, request.subscribe))
+        }
+    }
+}
