diff --git a/plugins/otools-notes/src/notesTestHost.ts b/plugins/otools-notes/src/notesTestHost.ts
new file mode 100644
index 00000000..d2e11b2b
--- /dev/null
+++ b/plugins/otools-notes/src/notesTestHost.ts
@@ -0,0 +1,66 @@
+import type { NotesDataApi, NoteResource } from './hostNotesStore'
+
+export function memoryStorage() {
+  const data = new Map<string, string>()
+  return {
+    data,
+    get length() { return data.size },
+    key(index: number) { return [...data.keys()][index] ?? null },
+    getItem(key: string) { return data.get(key) ?? null },
+    setItem(key: string, value: string) { data.set(key, value) },
+  }
+}
+
+// Persistent host boundary double: reads are snapshots and writes atomically
+// compare revisions. Different store instances share the same durable records.
+export class MemoryNotesHost implements NotesDataApi {
+  records = new Map<string, NoteResource>()
+  sequence = 0
+  conflicts = 0
+  pageSize = 100
+  failId?: string
+  beforeWrite?: () => Promise<void>
+  beforeList?: () => Promise<void>
+  async get(request: { type: string; id: string }) {
+    return structuredClone(this.records.get(request.id) ?? null)
+  }
+  async list(request: { type: string; cursor?: string; limit?: number }) {
+    await this.beforeList?.()
+    const records = [...this.records.values()].sort((a, b) => a.id.localeCompare(b.id))
+    const [sequence, start] = request.cursor ? request.cursor.split(':').map(Number) : [this.sequence, 0]
+    if (sequence !== this.sequence) throw { code: 'resyncRequired', message: 'Snapshot changed' }
+    const size = Math.min(this.pageSize, request.limit ?? 100)
+    return { items: structuredClone(records.slice(start, start + size)), next: start + size < records.length ? `${sequence}:${start + size}` : null, after: String(this.sequence) }
+  }
+  private check(id: string, revision: number, recreate = false, removing = false) {
+    if (id === this.failId) throw new Error('Host unavailable')
+    const current = this.records.get(id)
+    if ((current?.revision ?? 0) !== revision) {
+      this.conflicts++
+      throw { code: 'conflict', message: 'Resource revision has changed' }
+    }
+    if (current?.deleted && !recreate && !removing) throw { code: 'deleted', message: 'Explicit recreation required' }
+    return current
+  }
+  async put(request: Parameters<NotesDataApi['put']>[0]) {
+    await this.beforeWrite?.()
+    const current = this.check(request.id, request.expectedRevision, request.recreate)
+    const resource: NoteResource = {
+      provider: { source: 'local', uuid: 'otools-notes' }, type: request.type, id: request.id,
+      revision: (current?.revision ?? 0) + 1, updatedAt: ++this.sequence, deleted: false,
+      data: structuredClone(request.data), privateData: structuredClone(request.privateData),
+    }
+    this.records.set(request.id, resource)
+    return structuredClone(resource)
+  }
+  async remove(request: Parameters<NotesDataApi['remove']>[0]) {
+    await this.beforeWrite?.()
+    const current = this.check(request.id, request.expectedRevision, false, true)
+    const resource: NoteResource = {
+      provider: { source: 'local', uuid: 'otools-notes' }, type: request.type, id: request.id,
+      revision: (current?.revision ?? 0) + 1, updatedAt: ++this.sequence, deleted: true, data: null,
+    }
+    this.records.set(request.id, resource)
+    return structuredClone(resource)
+  }
+}
