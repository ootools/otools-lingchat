@@ -0,0 +1,42 @@
+#[path = "../../../src-tauri/src/platform/plugin_data/access.rs"]
+mod access;
+use access::*;
+use ot_plugin_data::{Identity, Scope};
+fn who(uuid: &str) -> Identity { Identity { source: "market".into(), uuid: uuid.into() } }
+fn request() -> AccessRequest { AccessRequest { id: "ignored".into(), consumer: who("pet"), provider: who("notes"), resource_type: "note".into(), scope: Scope::All, subscribe: true, expires_at: 0 } }
+#[test]
+fn consent_token_binds_exact_view_request_and_is_consumed_once() {
+    let mut queue = ConsentQueue::default();
+    let pending = queue.request(request(), 100).unwrap();
+    let token = queue.bind("plugin-data-consent-random", "tauri://localhost/plugin-data-consent.html", &pending.id, 101).unwrap();
+    assert!(queue.read("main", "tauri://localhost/plugin-data-consent.html", &token, 102).is_err());
+    assert!(queue.read("plugin-data-consent-random", "https://evil.test/", &token, 102).is_err());
+    let confirmed = queue.decide("plugin-data-consent-random", "tauri://localhost/plugin-data-consent.html", &token, 102).unwrap();
+    assert_eq!(confirmed.consumer, who("pet"));
+    assert!(queue.decide("plugin-data-consent-random", "tauri://localhost/plugin-data-consent.html", &token, 102).is_err());
+}
+#[test]
+fn requests_expire_are_deduplicated_and_consumer_cannot_choose_id_or_expiry() {
+    let mut queue = ConsentQueue::default(); let first = queue.request(request(), 100).unwrap();
+    assert_ne!(first.id, "ignored"); assert_eq!(first.expires_at, 300100);
+    assert_eq!(queue.request(request(), 101).unwrap().id, first.id);
+    assert!(queue.bind("main", "tauri://localhost/plugin-data-consent.html", &first.id, 102).is_err());
+    assert!(queue.bind("plugin-data-consent-a", "tauri://localhost/plugin-data-consent.html", &first.id, 300100).is_err());
+    assert_ne!(queue.request(request(), 300101).unwrap().id, first.id);
+}
+#[test]
+fn management_tokens_are_view_bound_expiring_and_not_consent_tokens() {
+    let mut queue = ConsentQueue::default();
+    let token = queue.bind_management("plugin-data-consent-manage", "tauri://localhost/plugin-data-consent.html", 100).unwrap();
+    assert!(queue.validate_management("main", "tauri://localhost/plugin-data-consent.html", &token, 101).is_err());
+    assert!(queue.validate_management("plugin-data-consent-manage", "tauri://localhost/plugin-data-consent.html", &token, 101).is_ok());
+    assert!(queue.read("plugin-data-consent-manage", "tauri://localhost/plugin-data-consent.html", &token, 102).is_err());
+    assert!(queue.validate_management("plugin-data-consent-manage", "tauri://localhost/plugin-data-consent.html", &token, 300100).is_err());
+}
+
+#[test]
+fn request_queue_is_bounded_per_consumer() {
+    let mut queue = ConsentQueue::default();
+    for i in 0..4 { let mut r = request(); r.resource_type = format!("type{i}"); queue.request(r, 0).unwrap(); }
+    assert_eq!(queue.request(request(), 0).unwrap_err().code, "busy");
+}
diff --git a/crates/ot-plugin-data/tests/policy.rs b/crates/ot-plugin-data/tests/policy.rs
new file mode 100644
index 00000000..7f0c170b
--- /dev/null
+++ b/crates/ot-plugin-data/tests/policy.rs
@@ -0,0 +1,31 @@
+#[path = "../../../src-tauri/src/platform/plugin_data/policy.rs"]
+mod policy;
+use ot_plugin_data::*;
+use policy::*;
+fn p(source: &str, uuid: &str, provides: &[&str], consumes: &[&str]) -> Participant {
+    Participant { identity: Identity {source:source.into(),uuid:uuid.into()}, enabled:true,
+        declaration: Declaration {provides:provides.iter().map(|x|x.to_string()).collect(),consumes:consumes.iter().map(|x|x.to_string()).collect()} }
+}
+#[test]
+fn manifest_and_enabled_checks_apply_to_exact_provider_and_consumer() {
+    let owner = p("market","notes", &["note"], &[]); let consumer = p("market","pet", &[], &["note"]);
+    let mut all = vec![owner.clone(),consumer.clone()];
+    let query = ReadRequest {provider:owner.identity.clone(),resource_type:"note".into()};
+    assert!(authorize_read(&all,&consumer.identity,&query).is_ok());
+    assert!(authorize_write(&all,&consumer.identity,"note").is_err());
+    assert!(authorize_write(&all,&owner.identity,"note").is_ok());
+    assert!(authorize_read(&all,&Identity{source:"dev-debug".into(),uuid:"pet".into()},&query).is_err());
+    all[0].enabled = false;
+    assert!(authorize_read(&all,&consumer.identity,&query).is_err());
+    all[0].enabled = true; all[1].declaration.consumes.clear();
+    assert!(authorize_read(&all,&consumer.identity,&query).is_err());
+    assert!(authorize_read(&all,&owner.identity,&query).is_ok());
+}
+#[test]
+fn duplicate_source_identity_is_rejected_and_discovery_contains_metadata_only() {
+    let owner = p("market","notes", &["note","secret"], &[]); let consumer = p("market","pet", &[], &["note"]);
+    let all = vec![owner.clone(), consumer.clone()];
+    let providers = discover(&all,&consumer.identity).unwrap();
+    assert_eq!(providers.len(),1); assert_eq!(providers[0].types,vec!["note"]);
+    assert!(authorize_write(&[owner.clone(),owner.clone()],&owner.identity,"note").is_err());
+}
