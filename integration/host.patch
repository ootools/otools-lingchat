index 00000000..1c897e26
--- /dev/null
+++ b/src-tauri/src/platform/ai/queue.rs
@@ -0,0 +1,139 @@
+//! Private, bounded, owner-checked polling queues. No Tauri or event bus dependency.
+use serde::Serialize;
+use std::collections::{HashMap, VecDeque};
+use std::sync::Arc;
+use tokio::sync::watch;
+
+pub const MAX_EVENTS: usize = 256;
+pub const MAX_QUEUE_BYTES: usize = 256 * 1024;
+pub const MAX_JOBS: usize = 64;
+const MAX_OWNER_JOBS: usize = 4;
+pub const MAX_JOB_MS: u64 = 10 * 60 * 1000;
+const TERMINAL_TTL_MS: u64 = 60 * 1000;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct JobOwner {
+    pub label: String,
+    pub source: String,
+    pub uuid: String,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct AiEvent {
+    pub sequence: u64,
+    #[serde(rename = "type")]
+    pub kind: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub text: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub error: Option<String>,
+}
+
+#[derive(Debug, Serialize)]
+pub struct AiReadResult {
+    pub id: String,
+    pub events: Vec<AiEvent>,
+    pub done: bool,
+}
+
+#[derive(Clone)]
+pub struct Cancellation(Arc<watch::Sender<bool>>);
+impl Cancellation {
+    fn new() -> Self { Self(Arc::new(watch::channel(false).0)) }
+    fn cancel(&self) { self.0.send_replace(true); }
+    pub async fn cancelled(&self) {
+        let mut receiver = self.0.subscribe();
+        let _ = receiver.wait_for(|cancelled| *cancelled).await;
+    }
+}
+
+struct Job {
+    owner: JobOwner,
+    events: VecDeque<AiEvent>,
+    sequence: u64,
+    acknowledged: u64,
+    bytes: usize,
+    created_at: u64,
+    finished_at: Option<u64>,
+    cancellation: Cancellation,
+}
+impl Job {
+    fn terminal(&mut self, kind: &str, error: Option<&str>, now: u64) {
+        if self.finished_at.is_some() { return; }
+        self.finished_at = Some(now);
+        self.cancellation.cancel();
+        self.sequence += 1;
+        self.events.push_back(AiEvent {
+            sequence: self.sequence, kind: kind.into(), text: None, error: error.map(str::to_owned),
+        });
+    }
+}
+impl Drop for Job {
+    fn drop(&mut self) { self.cancellation.cancel(); }
+}
+
+#[derive(Default)]
+pub struct JobRegistry { jobs: HashMap<String, Job> }
+impl JobRegistry {
+    pub fn start(&mut self, id: String, owner: JobOwner, now: u64) -> Result<Cancellation, String> {
+        self.prune(now);
+        if self.jobs.contains_key(&id) { return Err("duplicateJob".into()); }
+        // Acknowledged terminal jobs may be discarded when the next job starts.
+        self.jobs.retain(|_, job| !(job.finished_at.is_some() && job.acknowledged == job.sequence));
+        if self.jobs.len() >= MAX_JOBS || self.jobs.values().filter(|job| job.owner == owner).count() >= MAX_OWNER_JOBS {
+            return Err("busy".into());
+        }
+        let cancellation = Cancellation::new();
+        self.jobs.insert(id, Job {
+            owner, events: VecDeque::new(), sequence: 0, acknowledged: 0, bytes: 0,
+            created_at: now, finished_at: None, cancellation: cancellation.clone(),
+        });
+        Ok(cancellation)
+    }
+
+    pub fn delta(&mut self, id: &str, text: &str, now: u64) -> Result<(), String> {
+        let job = self.jobs.get_mut(id).ok_or("jobNotFound")?;
+        if job.finished_at.is_some() { return Err("jobFinished".into()); }
+        if text.is_empty() { return Ok(()); }
+        // Reserve a terminal event, so overflow is visible and never silently drops text.
+        if job.events.len() >= MAX_EVENTS - 1 || text.len() > MAX_QUEUE_BYTES.saturating_sub(job.bytes) {
+            job.terminal("error", Some("backlogExceeded"), now);
+            return Err("backlogExceeded".into());
+        }
+        job.sequence += 1;
+        job.bytes += text.len();
+        job.events.push_back(AiEvent { sequence: job.sequence, kind: "delta".into(), text: Some(text.into()), error: None });
+        Ok(())
+    }
+
+    pub fn finish(&mut self, id: &str, error: Option<&str>, now: u64) {
+        if let Some(job) = self.jobs.get_mut(id) { job.terminal(if error.is_some() { "error" } else { "done" }, error, now); }
+    }
+
+    pub fn read(&mut self, owner: &JobOwner, id: &str, after: u64) -> Result<AiReadResult, String> {
+        let job = self.jobs.get_mut(id).ok_or("jobNotFound")?;
+        if &job.owner != owner { return Err("forbidden".into()); }
+        if after < job.acknowledged { return Err("cursorGap".into()); }
+        if after > job.sequence { return Err("invalidCursor".into()); }
+        while job.events.front().is_some_and(|event| event.sequence <= after) {
+            if let Some(event) = job.events.pop_front() { job.bytes -= event.text.as_ref().map_or(0, String::len); }
+        }
+        job.acknowledged = after;
+        Ok(AiReadResult { id: id.into(), events: job.events.iter().cloned().collect(), done: job.finished_at.is_some() })
+    }
+
+    pub fn cancel(&mut self, owner: &JobOwner, id: &str, now: u64) -> Result<(), String> {
+        let job = self.jobs.get_mut(id).ok_or("jobNotFound")?;
+        if &job.owner != owner { return Err("forbidden".into()); }
+        job.terminal("cancelled", None, now);
+        Ok(())
+    }
+
+    pub fn remove(&mut self, id: &str) { self.jobs.remove(id); }
+    pub fn remove_owner(&mut self, label: &str) { self.jobs.retain(|_, job| job.owner.label != label); }
+    pub fn shutdown(&mut self) { self.jobs.clear(); }
+    pub fn prune(&mut self, now: u64) {
+        self.jobs.retain(|_, job| now.saturating_sub(job.created_at) <= MAX_JOB_MS
+            && job.finished_at.is_none_or(|end| now.saturating_sub(end) <= TERMINAL_TTL_MS));
+    }
+}
