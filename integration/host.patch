diff --git a/plugins/otools-notes/src/useNotesPersistence.ts b/plugins/otools-notes/src/useNotesPersistence.ts
new file mode 100644
index 00000000..b2c7d8f3
--- /dev/null
+++ b/plugins/otools-notes/src/useNotesPersistence.ts
@@ -0,0 +1,169 @@
+import { computed, onMounted, onUnmounted, ref } from 'vue'
+import { isTauri } from '@tauri-apps/api/core'
+import { createNotesStore, type Note } from './notes'
+import { createHostNotesStore, type NotePatch, type NotesDataApi } from './hostNotesStore'
+
+type Runtime = { otools?: { data?: NotesDataApi }; __OToolsEnv?: { pluginUuid?: string }; __OTOOLS_CUSTOM_WINDOW__?: unknown }
+
+export function useNotesPersistence(noteId: string) {
+  const runtime = window as unknown as Runtime
+  const preview = !isTauri() && !runtime.__OTOOLS_CUSTOM_WINDOW__ && !runtime.__OToolsEnv?.pluginUuid && !runtime.otools?.data
+  const note = ref<Note | null>(null)
+  const notes = ref<Note[]>([])
+  const error = ref('')
+  const saveFailed = ref(false)
+  const closed = ref(false)
+  const saving = ref(false)
+  const pendingCount = ref(0)
+  const pending: NotePatch[] = []
+  let disposed = false
+  let deleting = false
+  let generation = 0
+  let inFlight: Promise<boolean> | undefined
+  let previewStore: ReturnType<typeof createNotesStore> | undefined
+  let hostStore: ReturnType<typeof createHostNotesStore> | undefined
+  let initialized = false
+  let polling = false
+  const report = (reason: unknown) => {
+    error.value = reason instanceof Error ? reason.message : typeof reason === 'object' && reason !== null && 'message' in reason ? String(reason.message) : String(reason)
+  }
+  const failed = (reason: unknown) => { report(reason); saveFailed.value = true }
+  const clearPending = () => { pending.length = 0; pendingCount.value = 0 }
+  const apply = (current: Note, patches: NotePatch[]) => patches.reduce<Note>((value, patch) => ({ ...value, ...(typeof patch === 'function' ? patch(value) : patch) }), current)
+  const markDeleted = () => { closed.value = true; clearPending() }
+
+  const refresh = (): void | Promise<void> => {
+    if (previewStore) { notes.value = previewStore.list(); return }
+    if (hostStore) return hostStore.list().then(value => { if (!disposed) notes.value = value })
+  }
+  const initialize = async () => {
+    try {
+      if (!hostStore) {
+        const data = runtime.otools?.data
+        if (!data) throw new Error('Notes host data API is unavailable')
+        hostStore = createHostNotesStore(data, localStorage)
+      }
+      if (!initialized) { await hostStore.initialize(); initialized = true }
+      const saved = await hostStore.create(noteId)
+      if (disposed) return
+      note.value = saved
+      closed.value = !saved
+      await refresh()
+      saveFailed.value = false
+      error.value = ''
+    } catch (reason) { if (!disposed) failed(reason) }
+  }
+  let ready: Promise<void>
+  if (preview) {
+    try { previewStore = createNotesStore(localStorage); note.value = previewStore.create(noteId); refresh() }
+    catch (reason) { failed(reason) }
+    ready = Promise.resolve()
+  } else ready = initialize()
+
+  const persist = (): boolean | Promise<boolean> => {
+    if (!note.value || closed.value) return false
+    if (previewStore) {
+      try {
+        if (pending.length) {
+          const latest = previewStore.load(noteId)
+          if (!latest) { markDeleted(); return false }
+          const saved = previewStore.patch(noteId, apply(latest, pending))
+          if (!saved) { markDeleted(); return false }
+          note.value = saved
+          clearPending()
+        }
+        saveFailed.value = false; error.value = ''; refresh()
+        return true
+      } catch (reason) { failed(reason); return false }
+    }
+    if (inFlight) return inFlight
+    if (!hostStore) return false
+    const store = hostStore
+    saving.value = true
+    inFlight = (async () => {
+      try {
+        do {
+          while (pending.length && !closed.value) {
+            const batch = pending.slice()
+            const saved = await store.patch(noteId, current => apply(current, batch))
+            if (!saved) { markDeleted(); return false }
+            generation++
+            pending.splice(0, batch.length); pendingCount.value = pending.length
+            if (!disposed && !closed.value) note.value = apply(saved, pending)
+          }
+          await refresh()
+          // Edits may arrive while the list read is in flight. A close caller
+          // shares this promise, so it must cover those edits as well.
+        } while (pending.length && !closed.value)
+        saveFailed.value = false; error.value = ''
+        return !closed.value
+      } catch (reason) { failed(reason); return false }
+      finally { saving.value = false; inFlight = undefined }
+    })()
+    return inFlight
+  }
+  const update = (changes: NotePatch) => {
+    if (!note.value || closed.value || deleting || disposed) return
+    generation++
+    note.value = apply(note.value, [changes])
+    pending.push(changes); pendingCount.value = pending.length
+    void persist()
+  }
+  const retry = async () => {
+    if (!note.value) {
+      if (previewStore) {
+        try { note.value = previewStore.create(noteId) } catch (reason) { failed(reason); return }
+      } else { ready = initialize(); await ready }
+    }
+    await persist()
+  }
+  const create = (id: string) => previewStore ? previewStore.create(id) : hostStore ? hostStore.create(id) : Promise.reject(new Error('Notes host data API is unavailable'))
+  const reopen = async () => {
+    if (deleting) return
+    generation++
+    try {
+      const saved = previewStore ? previewStore.create(noteId) : await hostStore!.create(noteId, true)
+      if (disposed) return
+      note.value = saved; closed.value = !saved; clearPending(); error.value = ''; saveFailed.value = false
+      await refresh()
+    } catch (reason) { failed(reason) }
+  }
+  const remove = async () => {
+    if (!note.value || deleting) return false
+    deleting = true; generation++
+    try {
+      if (inFlight) await inFlight
+      if (previewStore) previewStore.remove(noteId)
+      else await hostStore!.remove(noteId)
+      markDeleted(); saveFailed.value = false; error.value = ''
+      await refresh()
+      return true
+    } catch (reason) { failed(reason); return false }
+    finally { deleting = false }
+  }
+  const reload = async () => {
+    if (disposed || deleting || polling || (!previewStore && !initialized)) return
+    polling = true
+    const start = generation
+    try {
+      const [saved, all] = previewStore ? [previewStore.load(noteId), previewStore.list()] : await Promise.all([hostStore!.load(noteId), hostStore!.list()])
+      if (disposed || start !== generation || deleting) return
+      notes.value = all
+      if (!saved) markDeleted()
+      else if (!closed.value && !saving.value) note.value = apply(saved, pending)
+    } catch (reason) { if (!disposed) report(reason) }
+    finally { polling = false }
+  }
+  // Recheck after asynchronous native calls before applying saved geometry.
+  const canRestore = async () => {
+    if (disposed || closed.value || deleting) return false
+    const saved = previewStore ? previewStore.load(noteId) : await hostStore!.load(noteId)
+    if (!saved) markDeleted()
+    return !!saved && !disposed && !closed.value && !deleting
+  }
+  let timer: ReturnType<typeof setInterval> | undefined
+  onMounted(() => { if (!preview) timer = setInterval(() => { void reload() }, 1000) })
+  onUnmounted(() => { disposed = true; if (timer) clearInterval(timer) })
+  return { note, notes, error, saveFailed, closed, saving, preview, ready, report, refresh, persist, update, retry, create, reopen, remove, reload, canRestore,
+    dirty: computed(() => pendingCount.value > 0 || saving.value) }
+}
